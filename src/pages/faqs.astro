---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { IconChevronDown, IconArrowRight } from "@tabler/icons-astro";
import { slugify, sortPublishedByOrder } from "../utils/helpers";
import TabBar from "../components/ui/TabBar.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import HeroHeader from "../components/ui/HeroHeader.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import DirectContactCTA from "../components/sections/DirectContactCTA.astro";

// 1. Fetch Singleton Settings
const settingsEntry = await getEntry("settings", "site");
if (!settingsEntry) throw new Error("Missing site.md file");
const site = settingsEntry.data;

// 2. Fetch All Published FAQs & Sort by Order
const allFaqs = await getCollection("faqs");
const publishedFaqs = sortPublishedByOrder(allFaqs);

// 3. Define Approved Categories
const categories = [
  "General & Booking",
  "Pricing & Tariffs",
  "Vehicles & Drivers",
  "Outstation Routes",
];

// 4. Group FAQs by Category
const groupedFaqs = categories
  .map((cat) => ({
    categoryName: cat,
    slug: slugify(cat),
    faqs: publishedFaqs.filter((f) => f.data.category === cat),
  }))
  .filter((group) => group.faqs.length > 0);

// 5. Fetch Top 3 Services
const allServices = await getCollection("services");
const topServices = sortPublishedByOrder(allServices).slice(0, 3);

const hubEntry = await getEntry("faqs_hub", "faqs_hub");
if (!hubEntry) throw new Error("Missing faqs_hub.md file");
const hubData = hubEntry.data;
---

<BaseLayout
  title={hubData?.seoTitle ||
    `Frequently Asked Questions | ${site.companyName}`}
  description={hubData?.seoDesc ||
    "Clear, straightforward answers regarding Udaipur taxi tariffs, airport waiting times, outstation toll rules, and vehicle luggage capacities."}
>
  {/* 1. HERO BANNER */}
  <section class="bg-brand-900 text-white py-12 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <HeroHeader
        subheading={hubData?.badge || "Operational Transparency"}
        heading={hubData?.title || "Frequently Asked Questions"}
        description={hubData?.description ||
          "Everything you need to know about our owner-approved pricing, driver allowances, luggage limits, and direct booking confirmation process."}
      />
    </div>
  </section>

  {/* 2. FLOATING TAB BAR NAVIGATION */}
  <TabBar
    mode="anchor"
    tabClass="faq-tab-btn"
    tabs={groupedFaqs.map((group) => ({
      label: group.categoryName,
      badge: group.faqs.length,
      slug: group.slug,
    }))}
  />

  {/* 3. CATEGORIZED ACCORDION CONTENT */}
  <section id="faq-wrapper" class="py-12 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {
        groupedFaqs.map((group, groupIndex) => (
          <div id={group.slug} class="scroll-mt-24">
            <div class="border-b border-brand-100 pb-4 mb-6 flex items-center justify-between">
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 tracking-tight">
                {group.categoryName}
              </h2>
              <span class="text-xs font-semibold text-typography-muted bg-surface-alt px-3 py-1 rounded-full border border-brand-100 hidden sm:inline-block">
                {group.faqs.length}{" "}
                {group.faqs.length === 1 ? "Answer" : "Answers"}
              </span>
            </div>

            <div class="space-y-4">
              {group.faqs.map((faq, faqIndex) => {
                const isDefaultOpen = groupIndex === 0 && faqIndex === 0;
                return (
                  <div
                    class="faq-item bg-surface-card border border-brand-100 rounded-2xl transition-all duration-300 overflow-hidden shadow-sm hover:border-brand-800/40"
                    data-open={isDefaultOpen ? "true" : "false"}
                  >
                    <button
                      type="button"
                      aria-expanded={isDefaultOpen ? "true" : "false"}
                      class="faq-trigger w-full p-6 sm:p-7 text-left font-serif text-lg sm:text-xl font-bold text-brand-900 flex items-center justify-between gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset cursor-pointer"
                    >
                      <span class="leading-snug">{faq.data.question}</span>
                      <div class="w-8 h-8 rounded-full bg-surface-alt border border-brand-100 flex items-center justify-center text-brand-900 shrink-0 transition-transform duration-300 faq-icon">
                        <IconChevronDown size={18} stroke={2.5} />
                      </div>
                    </button>
                    <div
                      class="faq-content transition-all duration-300 ease-in-out overflow-hidden"
                      style={
                        isDefaultOpen ? "" : "max-height: 0px; opacity: 0;"
                      }
                    >
                      <div class="px-6 pb-6 sm:px-7 sm:pb-7 pt-1 text-typography-muted text-sm sm:text-base leading-relaxed border-t border-brand-100/40 mt-1">
                        {faq.data.answer}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* 4. RELATED SERVICES & TRANSPORT LINKS */}
  <section class="py-12 bg-surface-alt/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading="Explore Transport Options"
        heading="Related Transport Services"
        description="Review vehicle capacities and transparent fare structures across our most requested travel routes."
        underline={false}
        class="mb-8"
      />

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
        {topServices.map((service) => <ServiceCard service={service} />)}
      </div>

      <div class="text-center">
        <a
          href="/vehicles/"
          class="group inline-flex items-center gap-2 bg-surface-card border border-brand-100 hover:border-brand-900 text-brand-900 font-bold px-6 py-3.5 rounded-xl text-sm tracking-wider transition-all shadow-sm active:scale-95 uppercase"
        >
          <span>Compare All Vehicle Capacities & Bag Limits</span>
          <IconArrowRight
            size={16}
            stroke={2}
            class="text-accent group-hover:translate-x-1 transition-transform"
          />
        </a>
      </div>
    </div>
  </section>

  {/* 5. DIRECT CONTACT CTA BANNER */}
  <DirectContactCTA type="faqs" />
</BaseLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initFAQPage() {
    // --- 1. Tab Bar Scrollspy ---
    const tabs = document.querySelectorAll(".faq-tab-btn");
    let isClickScrolling = false;
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;

    const setActive = (activeHref: string) => {
      tabs.forEach((btn) => {
        const isMatch = btn.getAttribute("href") === activeHref;
        btn.setAttribute("aria-selected", String(isMatch));
        if (isMatch)
          btn.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "center",
          });
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (isClickScrolling) return;
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(`#${e.target.id}`);
        });
      },
      { rootMargin: "-25% 0px -75% 0px", threshold: 0 },
    );

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const href = btn.getAttribute("href");
        if (href) setActive(href);
        isClickScrolling = true;
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => (isClickScrolling = false), 1000);
      });
      const href = btn.getAttribute("href");
      if (href && href.startsWith("#")) {
        const target = document.querySelector(href);
        if (target) observer.observe(target);
      }
    });

    // --- 2. Global Event Delegation Accordion ---
    const wrapper = document.getElementById("faq-wrapper");
    if (!wrapper || wrapper.dataset.init === "true") return;
    wrapper.dataset.init = "true";

    const toggleFaq = (item: HTMLElement, open: boolean) => {
      item.setAttribute("data-open", String(open));
      const trigger = item.querySelector(".faq-trigger");
      const content = item.querySelector(".faq-content") as HTMLElement;
      const icon = item.querySelector(".faq-icon") as HTMLElement;

      if (trigger) trigger.setAttribute("aria-expanded", String(open));
      if (content) {
        content.style.maxHeight = open ? `${content.scrollHeight}px` : "0px";
        content.style.opacity = open ? "1" : "0";
      }
      if (icon) icon.style.transform = open ? "rotate(180deg)" : "rotate(0deg)";
    };

    wrapper.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest(".faq-trigger");
      if (!trigger) return;

      const currentItem = trigger.closest(".faq-item") as HTMLElement;
      const isOpen = currentItem.getAttribute("data-open") === "true";

      // Close all currently open FAQs globally
      wrapper
        .querySelectorAll('.faq-item[data-open="true"]')
        .forEach((openItem) => {
          if (openItem !== currentItem)
            toggleFaq(openItem as HTMLElement, false);
        });

      // Toggle clicked item
      toggleFaq(currentItem, !isOpen);
    });

    // Mount initial heights
    wrapper
      .querySelectorAll('.faq-item[data-open="true"]')
      .forEach((item) => toggleFaq(item as HTMLElement, true));
  }

  // Execute and register for SPA transitions
  initFAQPage();
  document.addEventListener("astro:page-load", initFAQPage);
</script>

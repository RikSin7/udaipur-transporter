---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import {
  IconHelpCircle,
  IconChevronDown,
  IconArrowRight,
  IconMessage2,
  IconPhoneCall,
  IconCompass,
} from "@tabler/icons-astro";
import { getWhatsAppUrl, getCallUrl, slugify } from "../utils/helpers";

// 1. Fetch Singleton Business Settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};

// 2. Fetch All Published FAQs & Sort by Order
const allFaqs = await getCollection("faqs").catch(() => []);
const publishedFaqs = allFaqs
  .filter((f) => f.data.published)
  .sort((a, b) => a.data.order - b.data.order);

// 3. Define Approved Categories in Logical Display Sequence
const categories = [
  "General & Booking",
  "Pricing & Tariffs",
  "Vehicles & Drivers",
  "Outstation Routes",
];

// 4. Group FAQs by Category
const groupedFaqs = categories
  .map((cat) => ({
    categoryName: cat,
    slug: slugify(cat),
    faqs: publishedFaqs.filter((f) => f.data.category === cat),
  }))
  .filter((group) => group.faqs.length > 0);

// 5. Fetch Top 3 Services
const allServices = await getCollection("services").catch(() => []);
const topServices = allServices
  .filter((s) => s.data.published)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 3);

const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "FAQ Page Inquiry",
  Astro.url.href,
);
---

<BaseLayout
  title={`Frequently Asked Questions | ${site.companyName}`}
  description="Clear, straightforward answers regarding Udaipur taxi tariffs, airport waiting times, outstation toll rules, and vehicle luggage capacities."
>
  <Header slot="header" />

  {/* 1. HERO BANNER */}
  <section
    class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative overflow-hidden"
  >
    <div
      class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
    >
      <div
        class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full mb-4"
      >
        <IconHelpCircle size={16} stroke={2} className="text-accent shrink-0" />
        <span>Operational Transparency</span>
      </div>
      <h1
        class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-wide leading-tight mb-4"
      >
        Frequently Asked Questions
      </h1>
      <p
        class="text-brand-100/90 text-base sm:text-lg font-light leading-relaxed max-w-2xl mx-auto mb-8"
      >
        Everything you need to know about our owner-approved pricing, driver
        allowances, luggage limits, and direct booking confirmation process.
      </p>

      {/* QUICK-JUMP CATEGORY PILLS */}
      <div
        class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 pt-2"
      >
        {
          groupedFaqs.map((group) => (
            <a
              href={`#${group.slug}`}
              class="bg-brand-800/80 hover:bg-accent hover:text-white text-brand-100 text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl border border-brand-700/60 transition-all active:scale-95 shadow-sm"
            >
              {group.categoryName} ({group.faqs.length})
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* 2. CATEGORIZED ACCORDION CONTENT */}
  <section class="py-16 lg:py-20 bg-surface">
    <div
      class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 sm:space-y-20"
    >
      {
        groupedFaqs.map((group, groupIndex) => (
          <div id={group.slug} class="scroll-mt-24">
            {/* Category Section Header */}
            <div class="border-b border-brand-100 pb-4 mb-6 flex items-center justify-between">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-accent block mb-1">
                  Section 0{groupIndex + 1}
                </span>
                <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 tracking-tight">
                  {group.categoryName}
                </h2>
              </div>
              <span class="text-xs font-semibold text-typography-muted bg-surface-alt px-3 py-1 rounded-full border border-brand-100 hidden sm:inline-block">
                {group.faqs.length}{" "}
                {group.faqs.length === 1 ? "Answer" : "Answers"}
              </span>
            </div>

            {/* Category Accordion Group */}
            <div class="space-y-4">
              {group.faqs.map((faq, faqIndex) => {
                // Open ONLY the very first question of the first category by default
                const isDefaultOpen = groupIndex === 0 && faqIndex === 0;
                return (
                  <div
                    class="faq-item bg-surface-card border border-brand-100 rounded-2xl transition-all duration-300 overflow-hidden shadow-sm hover:border-brand-800/40"
                    data-open={isDefaultOpen ? "true" : "false"}
                  >
                    <button
                      type="button"
                      aria-expanded={isDefaultOpen ? "true" : "false"}
                      class="faq-trigger w-full p-6 sm:p-7 text-left font-serif text-lg sm:text-xl font-bold text-brand-900 flex items-center justify-between gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset cursor-pointer"
                    >
                      <span class="leading-snug">{faq.data.question}</span>
                      <div class="w-8 h-8 rounded-full bg-surface-alt border border-brand-100 flex items-center justify-center text-brand-900 shrink-0 transition-transform duration-300 faq-icon">
                        <IconChevronDown size={18} stroke={2.5} />
                      </div>
                    </button>

                    <div
                      class="faq-content transition-all duration-300 ease-in-out overflow-hidden"
                      style={
                        isDefaultOpen ? "" : "max-height: 0px; opacity: 0;"
                      }
                    >
                      <div class="px-6 pb-6 sm:px-7 sm:pb-7 pt-1 text-typography-muted text-sm sm:text-base leading-relaxed border-t border-brand-100/40 mt-1">
                        {faq.data.answer}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* 3. RELATED SERVICES & TRANSPORT LINKS */}
  <section class="py-16 bg-surface-alt/40 border-t border-brand-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div
          class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-widest text-accent bg-brand-100 px-3 py-1 rounded-full mb-2"
        >
          <IconCompass size={14} stroke={2} className="text-accent shrink-0" />
          <span>Explore Transport Options</span>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900">
          Related Transport Services
        </h2>
        <p class="text-xs sm:text-sm text-typography-muted mt-1">
          Review vehicle capacities and transparent fare structures across our
          most requested travel routes.
        </p>
      </div>

      {/* 3-Column Related Services Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
        {
          topServices.map((service) => (
            <a
              href={`/services/${service.id}/`}
              class="bg-surface-card border border-brand-100 rounded-xl p-5 shadow-sm hover:shadow-premium hover:border-brand-800 transition-all group flex flex-col justify-between"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-accent block mb-1">
                  {service.data.category}
                </span>
                <h3 class="font-serif text-base font-bold text-brand-900 group-hover:text-accent transition-colors mb-2">
                  {service.data.title}
                </h3>
              </div>
              <div class="mt-4 pt-3 border-t border-brand-100/60 flex items-center justify-between text-xs font-bold text-brand-900 group-hover:text-accent">
                <span>View Route Details</span>
                <IconArrowRight
                  size={14}
                  stroke={2}
                  class="group-hover:translate-x-1 transition-transform"
                />
              </div>
            </a>
          ))
        }
      </div>

      {/* Fleet Cross-Link Button */}
      <div class="text-center">
        <a
          href="/vehicles/"
          class="group inline-flex items-center gap-2 bg-surface-card border border-brand-100 hover:border-brand-900 text-brand-900 font-bold px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-sm active:scale-95"
        >
          <span>Compare All Vehicle Capacities & Bag Limits</span>
          <IconArrowRight
            size={16}
            stroke={2}
            class="text-accent group-hover:translate-x-1 transition-transform"
          />
        </a>
      </div>
    </div>
  </section>

  {/* 4. DIRECT CONTACT CTA BANNER */}
  <section class="py-16 bg-brand-900 text-white border-t border-brand-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span
        class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4"
      >
        Still Have Questions?
      </span>
      <h2
        class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight mb-3"
      >
        Speak Directly With Our Udaipur Team
      </h2>
      <p
        class="text-brand-100/80 text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed"
      >
        Skip automated call centers. Connect with a local transport coordinator
        who can review your custom route, calculate toll actuals, and confirm
        vehicle availability immediately.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        {/* WhatsApp Action */}
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-4 rounded-xl shadow-md hover:shadow-premium transition-all text-sm flex items-center gap-2.5 active:scale-95"
        >
          <IconMessage2 size={20} stroke={2} />
          <span>Chat on WhatsApp</span>
        </a>

        {/* Call Action */}
        <a
          href={callUrl}
          class="bg-surface-card hover:bg-surface text-brand-900 font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm flex items-center gap-2.5 active:scale-95"
        >
          <IconPhoneCall size={20} stroke={2} className="text-accent" />
          <span>Call {site.phone}</span>
        </a>

        {/* Online Form Action */}
        <a
          href="/contact/"
          class="group bg-brand-800 hover:bg-brand-700 text-white font-bold px-8 py-4 rounded-xl border border-brand-700 shadow-md transition-all text-sm flex items-center gap-2 active:scale-95"
        >
          <span>Open Enquiry Form</span>
          <IconArrowRight
            size={16}
            stroke={2}
            class="text-accent group-hover:translate-x-1 transition-transform"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

{/* Global Single-Open Accordion Controller */}
<script>
  function initGlobalFaqAccordion() {
    const triggers = document.querySelectorAll(".faq-trigger");

    triggers.forEach((trigger) => {
      // Clone node to safely purge ghost listeners during Astro SPA routing
      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);

      newTrigger.addEventListener("click", () => {
        const parent = newTrigger.closest(".faq-item") as HTMLElement;
        const content = parent?.querySelector(".faq-content") as HTMLElement;
        const icon = newTrigger.querySelector(".faq-icon") as HTMLElement;
        const isOpen = newTrigger.getAttribute("aria-expanded") === "true";

        if (!parent || !content) return;

        // STEP 1: EXCLUSIVE GLOBAL CLOSING LOGIC
        // Close every open FAQ across ALL categories before opening the target
        if (!isOpen) {
          document
            .querySelectorAll('.faq-item[data-open="true"]')
            .forEach((openItem) => {
              if (openItem !== parent) {
                const openTrigger = openItem.querySelector(
                  ".faq-trigger",
                ) as HTMLElement;
                const openContent = openItem.querySelector(
                  ".faq-content",
                ) as HTMLElement;
                const openIcon = openItem.querySelector(
                  ".faq-icon",
                ) as HTMLElement;

                if (openTrigger)
                  openTrigger.setAttribute("aria-expanded", "false");
                openItem.setAttribute("data-open", "false");
                if (openContent) {
                  openContent.style.maxHeight = "0px";
                  openContent.style.opacity = "0";
                }
                if (openIcon) openIcon.style.transform = "rotate(0deg)";
              }
            });
        }

        // STEP 2: TOGGLE TARGET ITEM
        if (isOpen) {
          newTrigger.setAttribute("aria-expanded", "false");
          parent.setAttribute("data-open", "false");
          content.style.maxHeight = "0px";
          content.style.opacity = "0";
          if (icon) icon.style.transform = "rotate(0deg)";
        } else {
          newTrigger.setAttribute("aria-expanded", "true");
          parent.setAttribute("data-open", "true");
          content.style.maxHeight = `${content.scrollHeight}px`;
          content.style.opacity = "1";
          if (icon) icon.style.transform = "rotate(180deg)";
        }
      });
    });

    // Set dynamic pixel heights for default opened items on initial render
    document.querySelectorAll('.faq-item[data-open="true"]').forEach((item) => {
      const content = item.querySelector(".faq-content") as HTMLElement;
      const icon = item.querySelector(".faq-icon") as HTMLElement;
      if (content) {
        content.style.maxHeight = `${content.scrollHeight}px`;
        content.style.opacity = "1";
      }
      if (icon) {
        icon.style.transform = "rotate(180deg)";
      }
    });
  }

  // Execute on initial DOM load
  initGlobalFaqAccordion();

  // Execute on Astro View Transition SPA navigation
  document.addEventListener("astro:page-load", initGlobalFaqAccordion);
</script>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { IconCheck, IconArrowLeft } from "@tabler/icons-astro";

const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
};
---

<BaseLayout
  title={`Thank You | ${site.companyName}`}
  description="Thank you for your enquiry. We will get back to you shortly."
  noindex={true}
>
  <section
    class="py-24 sm:py-32 mb-44 bg-surface min-h-[60vh] flex flex-col justify-center items-center"
  >
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div
        class="w-20 h-20 bg-success/10 border-2 border-success text-success rounded-full flex items-center justify-center mx-auto mb-8 shadow-sm"
      >
        <IconCheck size={40} stroke={2.5} />
      </div>

      <h1
        class="font-serif text-4xl sm:text-5xl font-bold text-brand-900 tracking-tight mb-4"
      >
        Thank You for Your Request!
      </h1>

      <p
        class="text-typography-muted text-base sm:text-lg mb-10 leading-relaxed max-w-xl mx-auto"
      >
        We have received your travel requirements. Our Udaipur dispatch team
        will review your details, calculate the exact rates, and get in touch
        with you very shortly.
      </p>

      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 bg-brand-900 hover:bg-brand-800 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm active:scale-95 group"
      >
        <IconArrowLeft
          size={18}
          stroke={2}
          class="text-accent group-hover:-translate-x-1 transition-transform"
        />
        <span>Return to Homepage</span>
      </a>
    </div>
  </section>
</BaseLayout>

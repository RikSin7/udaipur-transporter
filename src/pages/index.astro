---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import FeaturedServices from "../components/sections/FeaturedServices.astro";
import FeaturedVehicles from "../components/sections/FeaturedVehicles.astro";
import BookingProcess from "../components/sections/BookingProcess.astro";
import EnquiryForm from "../components/forms/EnquiryForm.astro";
import { getCollection } from "astro:content";
import { getWhatsAppUrl } from "../utils/helpers";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import PlanYourTrip from "../components/sections/PlanYourTrip.astro";
import FAQSection from "../components/sections/FAQSection.astro";

// Fetch site settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
  serviceArea: "Udaipur & All Rajasthan Outstation Routes",
};

// Fetch homepage content
const homeEntries = await getCollection("home").catch(() => []);
const homeData = homeEntries[0]?.data || {
  enquiryBadge: "Direct Local Booking",
  enquiryTitle: "Request Your Transport Quote",
  enquiryDesc:
    "Share your itinerary details below. Our Udaipur team will review your route and contact you directly with an owner-approved rate and vehicle availability.",
};

// Fetch and sort services & vehicles
const allServices = await getCollection("services").catch(() => []);
const featuredServices = allServices
  .filter((s) => s.data.published)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 6);

const allVehicles = await getCollection("vehicles").catch(() => []);
const featuredVehicles = allVehicles
  .filter((v) => v.data.published !== false)
  .sort((a, b) => (a.data.sortOrder ?? 10) - (b.data.sortOrder ?? 10))
  .slice(0, 6);

const whatsappUrl = getWhatsAppUrl(site.whatsapp);
---

<BaseLayout
  title={`${site.companyName} | Private Taxi & Car Rental in Udaipur`}
  description="Straightforward, dependable private transportation across Udaipur and Rajasthan. Airport transfers, local sightseeing, and outstation tempo travellers."
>
  {/* 1. HERO SECTION */}
  <Hero whatsappUrl={whatsappUrl} />

  {/* 2. WHY CHOOSE US (NEW POSITIONING SECTION) */}
  <WhyChooseUs />

  {/* 3. FEATURED SERVICES */}
  <FeaturedServices featuredServices={featuredServices} />

  {/* 4. VEHICLE FLEET & CAPACITY GUIDANCE */}
  <FeaturedVehicles featuredVehicles={featuredVehicles} />

  {/* 5. HOW TO CONTACT & BOOKING PROCESS */}
  <BookingProcess />

  {/* 6. REVIEWS SECTION */}
  <ReviewsSection />

  {/* 7. PLAN YOUR TRIP  */}
  <PlanYourTrip />

  {/* 8. FREQUENTLY ASKED QUESTIONS */}
  <FAQSection />

  {/* 9. FINAL ENQUIRY FORM */}
  <section
    id="enquiry-section"
    class="py-16 lg:py-20 bg-surface border-t border-brand-100"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Section Heading */}
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-[11px] font-bold uppercase tracking-widest text-accent-dark bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3">
          {homeData.enquiryBadge}
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight mb-2">
          {homeData.enquiryTitle}
        </h2>
        <p class="text-sm sm:text-base text-typography-muted leading-relaxed">
          {homeData.enquiryDesc}
        </p>
        <span class="inline-block w-12 h-1 bg-accent rounded-full mt-4"></span>
      </div>

      <EnquiryForm />
    </div>
  </section>
</BaseLayout>

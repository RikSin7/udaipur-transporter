---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import FeaturedServices from "../components/sections/FeaturedServices.astro";
import FeaturedVehicles from "../components/sections/FeaturedVehicles.astro";
import BookingProcess from "../components/sections/BookingProcess.astro";
import EnquiryForm from "../components/forms/EnquiryForm.astro";
import { getCollection, getEntry } from "astro:content";
import { getWhatsAppUrl } from "../utils/helpers";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import PlanYourTrip from "../components/sections/PlanYourTrip.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { sortPublishedByOrder } from "../utils/helpers";

// Fetch site settings
const settingsEntry = await getEntry("settings", "site");
if (!settingsEntry) throw new Error("Missing site.md file");
const site = settingsEntry.data;

// Fetch homepage content
const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("Missing home.md file");
const homeData = homeEntry.data;

// Fetch and sort services & vehicles
const allServices = await getCollection("services");
const featuredServices = sortPublishedByOrder(allServices).slice(0, 6);

const allVehicles = await getCollection("vehicles");
const featuredVehicles = sortPublishedByOrder(allVehicles).slice(0, 6);

const whatsappUrl = getWhatsAppUrl(site.whatsapp);
---

<BaseLayout
  title={site.seoDefaultTitle ||
    `${site.companyName} | Private Taxi & Car Rental in Udaipur`}
  description={site.seoDefaultDesc ||
    "Straightforward Private cabs, transfers & tours across Udaipur."}
>
  <Hero whatsappUrl={whatsappUrl} />

  <WhyChooseUs />

  <FeaturedServices featuredServices={featuredServices} />

  <FeaturedVehicles featuredVehicles={featuredVehicles} />

  <BookingProcess />

  <ReviewsSection />

  <PlanYourTrip />

  <FAQSection />

  <section id="enquiry-section" class="py-12 bg-surface/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading={homeData.enquiryBadge}
        heading={homeData.enquiryTitle}
        description={homeData.enquiryDesc}
        class="mb-12"
      />
      <EnquiryForm />
    </div>
  </section>
</BaseLayout>

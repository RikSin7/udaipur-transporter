---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import FeaturedServices from "../components/sections/FeaturedServices.astro";
import FeaturedVehicles from "../components/sections/FeaturedVehicles.astro";
import BookingProcess from "../components/sections/BookingProcess.astro";
import EnquiryForm from "../components/forms/EnquiryForm.astro";
import { getCollection } from "astro:content";
import { sortPublishedByOrder, getWhatsAppUrl } from "../utils/helpers";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import PlanYourTrip from "../components/sections/PlanYourTrip.astro";
import FaqSection from "../components/sections/FaqSection.astro";

// Fetch site settings
const settingsEntries = await getCollection("settings");
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
  serviceArea: "Udaipur & All Rajasthan Outstation Routes",
};

// Fetch and sort services & vehicles
const allServices = await getCollection("services");
const featuredServices = sortPublishedByOrder(allServices).slice(0, 6);

const allVehicles = await getCollection("vehicles");
const featuredVehicles = sortPublishedByOrder(allVehicles).slice(0, 6);

const whatsappUrl = getWhatsAppUrl(site.whatsapp);
---

<BaseLayout
  title={`${site.companyName} | Private Taxi & Car Rental in Udaipur`}
  description="Straightforward, dependable private transportation across Udaipur and Rajasthan. Airport transfers, local sightseeing, and outstation tempo travellers."
>
  {/* 1. HERO SECTION */}
  <Hero whatsappUrl={whatsappUrl} />

  {/* 2. WHY CHOOSE US (NEW POSITIONING SECTION) */}
  <WhyChooseUs />

  {/* 3. FEATURED SERVICES */}
  <FeaturedServices featuredServices={featuredServices} />

  {/* 4. VEHICLE FLEET & CAPACITY GUIDANCE */}
  <FeaturedVehicles featuredVehicles={featuredVehicles} />

  {/* 5. HOW TO CONTACT & BOOKING PROCESS */}
  <BookingProcess />

  {/* 6. REVIEWS PROOF */}
  <ReviewsSection />

  {/* 7. PLAN YOUR TRIP  */}
  <PlanYourTrip />

  {/* 8. FREQUENTLY ASKED QUESTIONS */}
  <FaqSection />

  {/* 9. FINAL ENQUIRY FORM */}
  <section
    id="enquiry-section"
    class="py-16 lg:py-24 bg-surface border-t border-brand-100"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Section Heading */}
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3">
          Direct Local Booking
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight">
          Request Your Transport Quote
        </h2>
        <p class="text-typography-muted text-sm sm:text-base mt-2 leading-relaxed">
          Share your itinerary details below. Our Udaipur team will review your route and contact you directly with an owner-approved rate and vehicle availability.
        </p>
      </div>

      <EnquiryForm />
    </div>
  </section>
</BaseLayout>

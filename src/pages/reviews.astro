---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import {
  IconStarFilled,
  IconQuote,
  IconMapPin,
  IconCar,
  IconShieldCheck,
  IconCheck,
  IconMessage2,
  IconArrowRight,
} from "@tabler/icons-astro";
import { getWhatsAppUrl } from "../utils/helpers";
import Header from "../components/layout/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// 1. Fetch Singleton Business Settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};

// 2. Fetch All Reviews & Sort Ascending by Order
const allReviews = await getCollection("reviews").catch(() => []);
const displayReviews = allReviews.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// 3. Calculate Dynamic Aggregate Metrics
const totalReviews = displayReviews.length;
const averageRating = totalReviews > 0 
  ? (displayReviews.reduce((acc, rev) => acc + (rev.data.rating || 5), 0) / totalReviews).toFixed(1)
  : "5.0";

const whatsappUrl = getWhatsAppUrl(site.whatsapp, "Reviews Page Inquiry", Astro.url.href);
---

<BaseLayout
  title={`Verified Passenger Reviews | ${site.companyName}`}
  description="Read genuine feedback from families, couples, and international travellers who hired private taxis and drivers with Udaipur Royal Transporter."
>
  <Header slot="header" />

  {/* 1. HERO BANNER & AGGREGATE SCORECARD */}
  <section class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        {/* Left Column: Hero Title */}
        <div class="lg:col-span-7">
          <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4">
            100% Transparent Proof
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
            What Travellers Say About Our Drivers & Taxis
          </h1>
          <p class="text-brand-100/90 text-base sm:text-lg font-light leading-relaxed max-w-2xl">
            Every review below reflects an actual trip across Udaipur, Kumbhalgarh, Mount Abu, or Rajasthan outstation circuits. We never edit comments or filter out real customer experiences.
          </p>
        </div>

        {/* Right Column: Aggregate Trust Scorecard */}
        <div class="lg:col-span-5">
          <div class="bg-surface-card text-brand-900 rounded-2xl p-6 sm:p-8 shadow-premium border border-brand-100">
            <div class="flex items-center justify-between border-b border-brand-100 pb-6 mb-6">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-typography-muted block mb-1">
                  Overall Rating
                </span>
                <div class="flex items-baseline gap-2">
                  <span class="font-serif text-4xl sm:text-5xl font-bold text-brand-900">{averageRating}</span>
                  <span class="text-sm font-bold text-typography-muted">/ 5.0</span>
                </div>
              </div>
              <div class="text-right">
                <div class="flex items-center gap-1 text-accent justify-end mb-1">
                  {[...Array(5)].map(() => <IconStarFilled size={18} />)}
                </div>
                <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-md inline-flex items-center gap-1">
                  <IconShieldCheck size={14} stroke={2} />
                  <span>{totalReviews}+ Verified Trips</span>
                </span>
              </div>
            </div>

            <div class="space-y-2.5 text-xs sm:text-sm text-typography-muted">
              <div class="flex items-center gap-2.5">
                <IconCheck size={16} stroke={2.5} class="text-emerald-600 shrink-0" />
                <span>Zero hidden toll or driver allowance surprises</span>
              </div>
              <div class="flex items-center gap-2.5">
                <IconCheck size={16} stroke={2.5} class="text-emerald-600 shrink-0" />
                <span>Experienced drivers familiar with old city navigation</span>
              </div>
              <div class="flex items-center gap-2.5">
                <IconCheck size={16} stroke={2.5} class="text-emerald-600 shrink-0" />
                <span>Direct coordination via WhatsApp and phone</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* 2. RESPONSIVE 3-COLUMN TESTIMONIAL GRID */}
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {displayReviews.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
          {displayReviews.map((review) => {
            const item = review.data;
            return (
              <div class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-premium hover:border-brand-800/40 transition-all duration-300 flex flex-col justify-between group">
                
                <div>
                  {/* Star Rating & Quote Icon Header */}
                  <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-1 text-accent">
                      {[...Array(item.rating || 5)].map(() => (
                        <IconStarFilled size={16} />
                      ))}
                    </div>
                    <div class="text-brand-100/60 group-hover:text-accent/40 transition-colors">
                      <IconQuote size={28} stroke={1.5} />
                    </div>
                  </div>

                  {/* Review Comment (Unclamped for full reading on dedicated page) */}
                  <p class="text-typography-muted text-sm sm:text-base leading-relaxed italic mb-8">
                    "{item.comment}"
                  </p>
                </div>

                {/* Author & Trip Metadata Footer */}
                <div class="border-t border-brand-100/80 pt-4 mt-auto">
                  <div class="flex items-start justify-between gap-3">
                    
                    {/* Left Side: Avatar/Initials + Author Name */}
                    <div class="flex items-center gap-3 min-w-0">
                      {item.image ? (
                        <Image
                          src={item.image}
                          alt={item.author}
                          width={88}
                          height={88}
                          loading="lazy"
                          class="w-11 h-11 rounded-full object-cover border border-brand-100 shrink-0 shadow-sm bg-surface-alt"
                        />
                      ) : (
                        <div class="w-11 h-11 rounded-full bg-brand-900 text-accent font-serif font-bold text-base flex items-center justify-center shrink-0 shadow-sm border border-brand-800">
                          {item.author.charAt(0)}
                        </div>
                      )}

                      <div class="min-w-0">
                        <h3 class="font-serif font-bold text-brand-900 text-base leading-snug truncate">
                          {item.author}
                        </h3>
                        <span class="text-[11px] text-typography-muted flex items-center gap-1 mt-0.5">
                          <IconMapPin size={13} stroke={2} class="text-accent shrink-0" />
                          <span class="truncate">{item.location}</span>
                        </span>
                      </div>
                    </div>

                    {/* Right Side: Verified Badge */}
                    {item.verified && (
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2 py-1 rounded-md shrink-0 flex items-center gap-1 self-start mt-0.5">
                        <IconShieldCheck size={13} stroke={2} class="text-emerald-600 shrink-0" />
                        <span>Verified</span>
                      </span>
                    )}

                  </div>

                  {/* Service Tag & Date */}
                  <div class="mt-3 pt-2 border-t border-brand-100/40 text-[11px] font-medium text-brand-900/80 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 truncate">
                      <IconCar size={14} stroke={2} class="text-accent shrink-0" />
                      <span class="truncate">{item.service}</span>
                    </div>
                    <span class="text-typography-muted shrink-0 font-normal">{item.date}</span>
                  </div>
                </div>

              </div>
            );
          })}
        </div>
      ) : (
        /* Empty State Fallback */
        <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
          <div class="text-3xl mb-3">⭐</div>
          <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">No Reviews Published Yet</h3>
          <p class="text-sm text-typography-muted mb-6">
            Our content administrators are currently syncing verified passenger testimonials. Please check back soon.
          </p>
          <a href="/enquiry/" class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block shadow-sm">
            Send Travel Enquiry
          </a>
        </div>
      )}

    </div>
  </section>

  {/* 3. DIRECT ACTION BANNER */}
  <section class="py-16 bg-surface-alt/70 border-t border-brand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-brand-900 text-white rounded-2xl p-8 sm:p-12 shadow-premium flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <div class="max-w-2xl text-center lg:text-left">
          <span class="text-xs font-bold uppercase tracking-widest text-accent mb-2 block">
            Ready to Travel?
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">
            Experience Our Royal Standard For Yourself
          </h2>
          <p class="text-brand-100/80 text-sm sm:text-base leading-relaxed">
            Whether you need a quick airport transfer or a 5-day outstation tour across Rajasthan, we guarantee clean vehicles, upfront pricing, and experienced drivers.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full lg:w-auto shrink-0">
          <a 
            href={whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-4 rounded-xl text-sm text-center transition-all shadow-md flex items-center justify-center gap-2 active:scale-95"
          >
            <IconMessage2 size={18} stroke={2} />
            <span>Chat on WhatsApp</span>
          </a>
          <a 
            href="/enquiry/" 
            class="bg-accent hover:bg-accent-hover text-white font-bold px-6 py-4 rounded-xl text-sm text-center transition-all shadow-md flex items-center justify-center gap-2 active:scale-95"
          >
            <span>Send Enquiry</span>
            <IconArrowRight size={16} stroke={2} />
          </a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
---
import { getCollection } from "astro:content";
import {
  IconStarFilled,
  IconShieldCheck,
  IconCheck,
} from "@tabler/icons-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewCard from "../components/cards/ReviewCard.astro";
import HeroHeader from "../components/ui/HeroHeader.astro";
import DirectContactCTA from "../components/sections/DirectContactCTA.astro";

// 1. Fetch Singleton Business Settings
const settingsEntries = await getCollection("settings");
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
};

// 2. Fetch All Reviews & Sort Ascending by Order
const allReviews = await getCollection("reviews");
const displayReviews = allReviews.sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

// 3. Calculate Dynamic Aggregate Metrics
const totalReviews = displayReviews.length;
const averageRating =
  totalReviews > 0
    ? (
        displayReviews.reduce((acc, rev) => acc + (rev.data.rating || 5), 0) /
        totalReviews
      ).toFixed(1)
    : "5.0";

const hubEntries = await getCollection("reviews_hub");
const hubData = hubEntries[0]?.data;
---

<BaseLayout
  title={hubData?.seoTitle ||
    `Verified Passenger Reviews | ${site.companyName}`}
  description={hubData?.seoDesc ||
    "Read genuine feedback from families, couples, and international travellers who hired private taxis and drivers with Udaipur Royal Transporter."}
>
  {/* 1. HERO BANNER & AGGREGATE SCORECARD */}
  <section
    class="bg-brand-900 text-white py-12 border-b border-brand-800 relative overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        {/* Left Column: Hero Title */}
        <div class="lg:col-span-7">
          <HeroHeader
            subheading={hubData?.badge || "100% Transparent Proof"}
            heading={hubData?.title ||
              "What Travellers Say About Our Drivers & Taxis"}
            description={hubData?.description ||
              "Every review below reflects an actual trip across Udaipur, Kumbhalgarh, Mount Abu, or Rajasthan outstation circuits. We never edit comments or filter out real customer experiences."}
          />
        </div>

        {/* Right Column: Aggregate Trust Scorecard */}
        <div class="lg:col-span-5">
          <div
            class="bg-surface-card text-brand-900 rounded-2xl p-6 sm:p-8 shadow-premium border border-brand-100"
          >
            <div
              class="flex items-center justify-between border-b border-brand-100 pb-6 mb-6"
            >
              <div>
                <span
                  class="text-xs font-bold uppercase tracking-wider text-typography-muted block mb-1"
                >
                  Overall Rating
                </span>
                <div class="flex items-baseline gap-2">
                  <span
                    class="font-serif text-4xl sm:text-5xl font-bold text-brand-900"
                    >{averageRating}</span
                  >
                  <span class="text-sm font-bold text-typography-muted"
                    >/ 5.0</span
                  >
                </div>
              </div>
              <div class="text-right">
                <div
                  class="flex items-center gap-1 text-accent justify-end mb-1"
                >
                  {[...Array(5)].map(() => <IconStarFilled size={18} />)}
                </div>
                <span
                  class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-md inline-flex items-center gap-1"
                >
                  <IconShieldCheck size={14} stroke={2} />
                  <span>{totalReviews}+ Verified Trips</span>
                </span>
              </div>
            </div>

            <div class="space-y-2.5 text-xs sm:text-sm text-typography-muted">
              <div class="flex items-center gap-2.5">
                <IconCheck
                  size={16}
                  stroke={2.5}
                  class="text-emerald-600 shrink-0"
                />
                <span>Zero hidden toll or driver allowance surprises</span>
              </div>
              <div class="flex items-center gap-2.5">
                <IconCheck
                  size={16}
                  stroke={2.5}
                  class="text-emerald-600 shrink-0"
                />
                <span
                  >Experienced drivers familiar with old city navigation</span
                >
              </div>
              <div class="flex items-center gap-2.5">
                <IconCheck
                  size={16}
                  stroke={2.5}
                  class="text-emerald-600 shrink-0"
                />
                <span>Direct coordination via WhatsApp and phone</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 2. RESPONSIVE 3-COLUMN TESTIMONIAL GRID */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {
        displayReviews.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
            {displayReviews.map((review) => (
              <ReviewCard review={review} variant="grid" />
            ))}
          </div>
        ) : (
          /* Empty State Fallback */
          <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
            <div class="text-3xl mb-3">⭐</div>
            <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
              No Reviews Published Yet
            </h3>
            <p class="text-sm text-typography-muted mb-6">
              Our content administrators are currently syncing verified
              passenger testimonials. Please check back soon.
            </p>
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block shadow-sm"
            >
              Send Travel Enquiry
            </a>
          </div>
        )
      }
    </div>
  </section>

  {/* 3. DIRECT ACTION BANNER */}
  <DirectContactCTA type="reviews" />
</BaseLayout>

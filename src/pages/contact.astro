---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/forms/EnquiryForm.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import HeroHeader from "../components/ui/HeroHeader.astro";
import { getWhatsAppUrl, getCallUrl } from "../utils/helpers";
import {
  IconPhoneCall,
  IconMail,
  IconMapPin,
  IconClock,
  IconCompass,
  IconMap,
  IconShieldCheck,
  IconBrandWhatsapp,
  IconArrowRight,
  IconFileText,
} from "@tabler/icons-astro";
import { getEntry } from "astro:content";

// 1. Fetch Settings
const settingsEntry = await getEntry("settings", "site");
if (!settingsEntry) throw new Error("Missing site.md file");

const site = settingsEntry.data;

// 2. Fetch Singleton Contact Page Content from Decap CMS
const contactEntry = await getEntry("contact", "contact");
if (!contactEntry) throw new Error("Missing contact.md file");

const contactData = contactEntry.data;

const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "General Contact Inquiry",
  Astro.url.href,
);
---

<BaseLayout
  title={contactData.seoTitle || `${contactData.title} | ${site.companyName}`}
  description={contactData.seoDesc || contactData.subtitle}
>
  {/* 1. HERO BANNER */}
  <section class="bg-brand-900 text-white py-12 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <HeroHeader
        subheading={contactData.badge || "Direct Local Communication"}
        heading={contactData.title}
        description={contactData.subtitle}
      />
    </div>
  </section>

  {/* 2. ASYMMETRIC DIRECT CHANNELS & OPERATIONAL METRICS */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <SectionHeader
        subheading={contactData.directChannelsSubheading || "Direct Connect"}
        heading={contactData.directChannelsHeading}
        description={contactData.directChannelsDesc}
      />

      {/* 3-Column Direct Action Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {/* Phone Card */}
        <a
          href={callUrl}
          class="bg-surface-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-surface-alt text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0"
            >
              <IconPhoneCall size={24} stroke={2} />
            </div>
            <span
              class="text-[11px] font-bold tracking-widest text-typography-muted block mb-1"
            >
              {contactData.phoneCard.label}
            </span>
            <h3
              class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-accent transition-colors duration-300 mb-2"
            >
              {contactData.phoneCard.title}
            </h3>
            <p class="text-xs text-typography-muted leading-relaxed">
              {contactData.phoneCard.desc}
            </p>
          </div>
          <div
            class="mt-6 pt-4 border-t border-border flex items-center gap-1.5 text-xs font-semibold text-emerald-700"
          >
            <span
              class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"
            ></span>
            <span>{contactData.phoneCard.badgeText}</span>
          </div>
        </a>

        {/* WhatsApp Card */}
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-surface-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-surface-alt text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0"
            >
              <IconBrandWhatsapp size={24} stroke={2} />
            </div>
            <span
              class="text-[11px] font-bold tracking-widest text-typography-muted block mb-1"
            >
              {contactData.whatsappCard.label}
            </span>
            <h3
              class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-accent transition-colors duration-300 mb-2"
            >
              {contactData.whatsappCard.title}
            </h3>
            <p class="text-xs text-typography-muted leading-relaxed">
              {contactData.whatsappCard.desc}
            </p>
          </div>
          <div
            class="mt-6 pt-4 border-t border-border flex items-center gap-1.5 text-xs font-semibold text-typography-muted"
          >
            <IconShieldCheck
              size={16}
              stroke={2}
              class="text-emerald-600 shrink-0"
            />
            <span>{contactData.whatsappCard.badgeText}</span>
          </div>
        </a>

        {/* Email Card */}
        <a
          href={`mailto:${site.email}`}
          class="bg-surface-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-surface-alt text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0"
            >
              <IconMail size={24} stroke={2} />
            </div>
            <span
              class="text-[11px] font-bold tracking-widest text-typography-muted block mb-1"
            >
              {contactData.emailCard.label}
            </span>
            <h3
              class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-accent transition-colors duration-300 mb-2 truncate"
            >
              {contactData.emailCard.title}
            </h3>
            <p class="text-xs text-typography-muted leading-relaxed">
              {contactData.emailCard.desc}
            </p>
          </div>
          <div
            class="mt-6 pt-4 border-t border-border flex items-center gap-1.5 text-xs font-semibold text-typography-muted"
          >
            <IconFileText size={16} stroke={2} class="text-accent shrink-0" />
            <span>{contactData.emailCard.badgeText}</span>
          </div>
        </a>
      </div>

      {/* Operational Base & Response Commitment Bar */}
      <div
        class="bg-surface-alt/70 border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-2xs grid grid-cols-1 md:grid-cols-3 gap-6 divide-y md:divide-y-0 md:divide-x divide-brand-100/80 text-xs sm:text-sm"
      >
        <div class="flex items-start gap-3.5 pt-4 md:pt-0">
          <div
            class="w-9 h-9 rounded-lg bg-brand-900 text-accent flex items-center justify-center shrink-0 mt-0.5 shadow-2xs"
          >
            <IconMapPin size={18} stroke={2} />
          </div>
          <div>
            <strong
              class="font-serif text-base font-bold text-brand-900 block mb-1"
              >Operating Garage & Base</strong
            >
            <p class="text-typography-muted leading-relaxed">{site.address}</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 pt-4 md:pt-0 md:pl-6">
          <div
            class="w-9 h-9 rounded-lg bg-brand-900 text-accent flex items-center justify-center shrink-0 mt-0.5 shadow-2xs"
          >
            <IconClock size={18} stroke={2} />
          </div>
          <div>
            <strong
              class="font-serif text-base font-bold text-brand-900 block mb-1"
              >Response Commitment</strong
            >
            <p class="text-typography-muted leading-relaxed">
              {site.operatingHours}
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 pt-4 md:pt-0 md:pl-6">
          <div
            class="w-9 h-9 rounded-lg bg-brand-900 text-accent flex items-center justify-center shrink-0 mt-0.5 shadow-2xs"
          >
            <IconCompass size={18} stroke={2} />
          </div>
          <div>
            <strong
              class="font-serif text-base font-bold text-brand-900 block mb-1"
              >Service Area Coverage</strong
            >
            <p class="text-typography-muted leading-relaxed">
              {site.serviceArea}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. STACKED ENQUIRY FORM AT THE BOTTOM */}
  <section
    id="enquiry-form-section"
    class="py-12 bg-brand-900 text-white relative overflow-hidden scroll-mt-12"
  >
    {/* Subtle Gold Dotted Background Pattern */}
    <div
      class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] bg-size-[24px_24px] opacity-10 pointer-events-none"
    >
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      {/* Dark Royal Form Header */}
      <SectionHeader
        subheading="Direct Booking Request"
        heading="Send a Travel Enquiry"
        description="Fill out your travel details below. A transport coordinator will calculate accurate road distances, toll actuals, and vehicle sizing before replying directly."
        theme="dark"
        class="mb-12"
      />

      <EnquiryForm />
    </div>
  </section>

  {/* 4. GOOGLE MAPS LOCATION NOTE */}
  <section class="py-12 bg-surface-alt/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="bg-surface-card border border-brand-100 rounded-2xl p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-center justify-between gap-8"
      >
        <div class="space-y-2 text-center md:text-left max-w-xl">
          <span
            class="text-xs font-bold uppercase tracking-widest text-accent-dark bg-brand-100/40 px-3 py-1 rounded-full inline-block"
            >{contactData.locationHeading}</span
          >
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900">
            {contactData.locationSubheading}
          </h3>
          <p class="text-typography-muted text-sm leading-relaxed">
            {contactData.locationDesc}
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto text-center">
          <a
            href={contactData.googleMapsUrl || site.socialLinks?.googleMaps}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-brand-900 hover:bg-brand-800 text-white font-bold px-7 py-4 rounded-xl text-xs tracking-wider transition-all shadow-md active:scale-95 group uppercase"
          >
            <IconMap
              size={18}
              stroke={2}
              class="text-accent group-hover:scale-110 transition-transform"
            />
            <span>View Udaipur on Google Maps</span>
            <IconArrowRight
              size={16}
              stroke={2}
              class="text-accent group-hover:translate-x-1 transition-transform"
            />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

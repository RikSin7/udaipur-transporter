---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import EnquiryForm from '../components/forms/EnquiryForm.astro';
import { getWhatsAppUrl } from '../utils/helpers';

// 1. Fetch Singleton Business Settings (phone, email, address)
const settingsEntries = await getCollection('settings').catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
  email: "bookings@udaipurtransporter.com",
  address: "12, City Palace Road, near Jagdish Temple, Udaipur, Rajasthan 313001",
  operatingHours: "Typical Response Time: Under 15 Minutes (7 Days a Week)",
  serviceArea: "Udaipur City, Maharana Pratap Airport (Dabok), & All Rajasthan Outstation Routes"
};

// 2. Fetch Singleton Contact Page Data
const contactEntries = await getCollection('contact').catch(() => []);
const contactData = contactEntries[0]?.data || {
  title: "Contact Our Udaipur Team",
  subtitle: "Skip automated call centers. Connect directly with the transport coordinators who allocate your vehicle.",
  directChannelsHeading: "Direct Contact Channels",
  directChannelsDesc: "Choose your preferred method of communication.",
  locationHeading: "Central Udaipur Location",
  locationSubheading: "Located Near Historic Old City",
  locationDesc: "Our central garage location allows our drivers to reach lakeside hotels rapidly.",
  googleMapsUrl: "https://maps.google.com/?q=Udaipur+City+Palace"
};

const callUrl = `tel:${site.phone.replace(/\s+/g, '')}`;
const whatsappUrl = getWhatsAppUrl(site.whatsapp, "General Contact Inquiry", Astro.url.href);
---

<BaseLayout 
  title={`${contactData.title} | ${site.companyName}`}
  description={contactData.subtitle}
>
  <Header slot="header" />

  {/* HERO BANNER */}
  <section class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4">
          Direct Local Communication
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
          {contactData.title}
        </h1>
        <p class="text-brand-100/90 text-lg font-light leading-relaxed">
          {contactData.subtitle}
        </p>
      </div>
    </div>
  </section>

  {/* MAIN CONTACT GRID */}
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        {/* Left Column: Direct Contact Methods */}
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 mb-3">
              {contactData.directChannelsHeading}
            </h2>
            <p class="text-sm text-typography-muted leading-relaxed">
              {contactData.directChannelsDesc}
            </p>
          </div>

          <div class="space-y-4">
            {/* Phone */}
            <a href={callUrl} class="bg-surface-card border border-brand-100 p-5 rounded-xl shadow-sm hover:shadow-premium transition-all flex items-center gap-4 group">
              <div class="w-12 h-12 bg-brand-900 text-white rounded-lg flex items-center justify-center text-xl shrink-0 group-hover:bg-accent transition-colors">📞</div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-typography-muted block">Call Directly</span>
                <span class="font-serif text-lg font-bold text-brand-900 group-hover:text-accent transition-colors">{site.phone}</span>
                <span class="text-[11px] text-emerald-600 font-semibold block mt-0.5">● Available for immediate assistance</span>
              </div>
            </a>

            {/* WhatsApp */}
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-surface-card border border-brand-100 p-5 rounded-xl shadow-sm hover:shadow-premium transition-all flex items-center gap-4 group">
              <div class="w-12 h-12 bg-emerald-600 text-white rounded-lg flex items-center justify-center text-xl shrink-0 group-hover:bg-emerald-700 transition-colors">💬</div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-typography-muted block">WhatsApp Support</span>
                <span class="font-serif text-lg font-bold text-brand-900 group-hover:text-emerald-600 transition-colors">Chat With Coordinator</span>
                <span class="text-[11px] text-typography-muted block mt-0.5">Pre-filled with your current page context</span>
              </div>
            </a>

            {/* Email */}
            <a href={`mailto:${site.email}`} class="bg-surface-card border border-brand-100 p-5 rounded-xl shadow-sm hover:shadow-premium transition-all flex items-center gap-4 group">
              <div class="w-12 h-12 bg-brand-100 text-brand-900 rounded-lg flex items-center justify-center text-xl shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">✉️</div>
              <div class="min-w-0">
                <span class="text-xs font-bold uppercase tracking-wider text-typography-muted block">Email Inquiries</span>
                <span class="font-serif text-base font-bold text-brand-900 group-hover:text-accent transition-colors block truncate">{site.email}</span>
                <span class="text-[11px] text-typography-muted block mt-0.5">For corporate billing & event itineraries</span>
              </div>
            </a>
          </div>

          {/* Operating Base & Hours */}
          <div class="bg-surface-alt/60 border border-brand-100 p-6 rounded-2xl space-y-4 text-xs text-typography-main">
            <div>
              <strong class="font-serif text-sm font-bold text-brand-900 block mb-1">📍 Operating Base & Garage</strong>
              <p class="text-typography-muted leading-relaxed">{site.address}</p>
            </div>
            <div class="border-t border-brand-100/80 pt-3">
              <strong class="font-serif text-sm font-bold text-brand-900 block mb-1">🕒 Response Commitment</strong>
              <p class="text-typography-muted">{site.operatingHours}</p>
            </div>
            <div class="border-t border-brand-100/80 pt-3">
              <strong class="font-serif text-sm font-bold text-brand-900 block mb-1">🗺️ Service Area Coverage</strong>
              <p class="text-typography-muted">{site.serviceArea}</p>
            </div>
          </div>
        </div>

        {/* Right Column: Unified Enquiry Form */}
        <div class="lg:col-span-7">
            <EnquiryForm />
        </div>

      </div>
    </div>
  </section>

  {/* LOCATION NOTE */}
  <section class="py-16 bg-surface-alt/30 border-t border-brand-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-brand-900 text-white rounded-2xl p-8 sm:p-12 shadow-premium flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-2 text-center md:text-left max-w-xl">
          <span class="text-xs font-bold uppercase tracking-widest text-accent">{contactData.locationHeading}</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">{contactData.locationSubheading}</h3>
          <p class="text-brand-100/80 text-sm leading-relaxed">{contactData.locationDesc}</p>
        </div>
        <div class="shrink-0 w-full md:w-auto text-center">
          <a 
            href={contactData.googleMapsUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-block bg-accent hover:bg-accent-hover text-white font-bold px-6 py-4 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md active:scale-95"
          >
            <span>🗺️</span> View Udaipur on Google Maps &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
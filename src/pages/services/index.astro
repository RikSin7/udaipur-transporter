---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceCard from "../../components/cards/ServiceCard.astro";
import { slugify, sortPublishedByOrder } from "../../utils/helpers";
import { IconCar } from "@tabler/icons-astro";
import { iconResolver } from "../../utils/iconResolver";
import CatalogueSupportCTA from "../../components/sections/CatalogueSupportCTA.astro";
import FAQSection from "../../components/sections/FAQSection.astro";
import TabBar from "../../components/ui/TabBar.astro";
import HeroHeader from "../../components/ui/HeroHeader.astro";
import { getEntry } from "astro:content";

// 1. Fetch site settings
const settingsEntries = await getEntry("settings", "site");
if (!settingsEntries) throw new Error("site.md not found");
const site = settingsEntries.data;

// 2. Fetch all published services
const allServices = await getCollection("services");
const publishedServices = sortPublishedByOrder(allServices);

const hubEntries = await getEntry("services_hub", "services_hub");
if (!hubEntries) throw new Error("services_hub.md not found");
const hubData = hubEntries.data;

// 3. Group services dynamically by categories defined in the CMS
const groupedServices = (hubData.categories || [])
  .map((cat) => {
    const IconComponent = iconResolver[cat.icon] || IconCar;
    return {
      category: cat.name,
      slug: slugify(cat.name),
      metadata: {
        icon: IconComponent,
        subtitle: cat.subtitle,
      },
      services: publishedServices.filter((s) => s.data.category === cat.name),
    };
  })
  .filter((group) => group.services.length > 0);
---

<BaseLayout title={hubData.seoTitle} description={hubData.seoDesc}>
  {/* 1. HERO BANNER */}
  <section class="bg-brand-900 text-white py-12 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <HeroHeader
        subheading={hubData.badge}
        heading={hubData.title}
        description={hubData.description}
      />
    </div>
  </section>

  {/* 2. TAB BAR */}
  <TabBar
    mode="anchor"
    tabClass="service-tab-btn"
    tabs={groupedServices.map((group) => ({
      label: group.category,
      badge: group.services.length,
      slug: group.slug,
    }))}
  />

  {/* 3. CATEGORISED SERVICE LISTINGS */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {
        groupedServices.length > 0 ? (
          groupedServices.map((group) => {
            const IconComponent = group.metadata.icon;
            return (
              <div
                id={group.slug}
                class="scroll-mt-32 border-b border-brand-100/80 pb-12 last:border-b-0 last:pb-0"
              >
                <div class="mb-6">
                  <div class="flex items-center gap-3.5 mb-1">
                    <div class="w-10 h-10 rounded-xl bg-brand-900 text-accent flex items-center justify-center shrink-0 shadow-sm">
                      <IconComponent size={20} stroke={2} />
                    </div>
                    <h2 class="font-serif text-xl sm:text-2xl lg:text-3xl font-bold text-brand-900 tracking-tight">
                      {group.category}
                    </h2>
                  </div>
                  <p class="text-sm sm:text-base text-typography-muted font-normal max-w-2xl leading-relaxed pl-13 sm:pl-13">
                    {group.metadata.subtitle}
                  </p>
                  <div class="mt-4 border-b border-brand-100/80 w-full" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                  {group.services.map((service) => (
                    <ServiceCard service={service} />
                  ))}
                </div>
              </div>
            );
          })
        ) : (
          <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
            <div class="w-12 h-12 rounded-xl bg-brand-900 text-accent flex items-center justify-center mx-auto mb-4">
              <IconCar size={24} stroke={2} />
            </div>
            <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
              No Services Published Yet
            </h3>
            <p class="text-sm text-typography-muted mb-6">
              Our content administrators are currently updating the transport
              catalogue.
            </p>
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block shadow-sm uppercase"
            >
              Send General Inquiry
            </a>
          </div>
        )
      }
    </div>
  </section>

  <CatalogueSupportCTA type="services" />
  <FAQSection />

  {/* 6. DISCLAIMER */}
  <section class="py-12 bg-surface-alt/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs sm:text-sm text-typography-muted leading-relaxed">
        {hubData.disclaimerText}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  function initServiceScrollspy() {
    const tabs = document.querySelectorAll(".service-tab-btn");
    let isClickScrolling = false;
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;

    // Helper: Pass the href to activate, it handles the rest.
    const setActive = (activeHref: string) => {
      tabs.forEach((btn) => {
        const isMatch = btn.getAttribute("href") === activeHref;
        btn.setAttribute("aria-selected", String(isMatch));
        if (isMatch)
          btn.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "center",
          });
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (isClickScrolling) return;
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(`#${e.target.id}`);
        });
      },
      { rootMargin: "-25% 0px -75% 0px", threshold: 0 },
    );

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const href = btn.getAttribute("href");
        if (href) setActive(href);
        isClickScrolling = true;
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => (isClickScrolling = false), 1000);
      });

      const href = btn.getAttribute("href");
      if (href && href.startsWith("#")) {
        const target = document.querySelector(href);
        if (target) observer.observe(target);
      }
    });
  }

  initServiceScrollspy();
  document.addEventListener("astro:page-load", initServiceScrollspy);
</script>

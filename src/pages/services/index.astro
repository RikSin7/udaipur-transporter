---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import ServiceCard from "../../components/cards/ServiceCard.astro";
import { slugify } from "../../utils/helpers";
import {
  IconPlane,
  IconMapPin,
  IconCompass,
  IconUsers,
  IconPlus,
  IconCar,
} from "@tabler/icons-astro";
import CatalogueSupportCTA from "../../components/sections/CatalogueSupportCTA.astro";
import FAQSection from "../../components/sections/FAQSection.astro";
import TabBar from "../../components/ui/TabBar.astro";

// 1. Fetch singleton business settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
};

// 2. Fetch all published services
const allServices = await getCollection("services").catch(() => []);
const publishedServices = allServices
  .filter((s) => s.data.published)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// 3. Define category metadata
const categoryMetadata: Record<string, { subtitle: string; icon: any }> = {
  Transfers: {
    subtitle:
      "Airport, railway and point-to-point private transfers across Udaipur.",
    icon: IconPlane,
  },
  "Local Travel": {
    subtitle:
      "Flexible hourly car rentals and full-day old city sightseeing itineraries.",
    icon: IconMapPin,
  },
  "Outstation Travel": {
    subtitle:
      "Multi-day highway road trips and one-way taxi drops across Rajasthan.",
    icon: IconCompass,
  },
  "Group and Event Travel": {
    subtitle:
      "Spacious tempo travellers and coordinated fleet logistics for weddings and groups.",
    icon: IconUsers,
  },
  Additional: {
    subtitle:
      "Custom logistical solutions and specialized corporate transport requests.",
    icon: IconPlus,
  },
};

const categoryOrder = [
  "Transfers",
  "Local Travel",
  "Outstation Travel",
  "Group and Event Travel",
  "Additional",
] as const;

// 4. Group services by category
const groupedServices = categoryOrder
  .map((category) => ({
    category,
    slug: slugify(category),
    metadata: categoryMetadata[category] || {
      subtitle: "Private transportation services.",
      icon: IconCar,
    },
    services: publishedServices.filter((s) => s.data.category === category),
  }))
  .filter((group) => group.services.length > 0);
---

<BaseLayout
  title={`Our Transport Services | ${site.companyName}`}
  description="Explore owner-approved private transport services in Udaipur. Transparent airport transfers, flexible local car rentals with driver, and outstation Rajasthan taxis."
>
  <Header slot="header" />

  {/* 1. HERO BANNER */}
  <section
    class="bg-brand-900 text-white py-12 border-b border-brand-800 relative overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span
          class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4"
          >Our Services</span
        >
        <h1
          class="font-serif text-4xl sm:text-5xl font-bold text-white tracking-wide leading-tight mb-4"
        >
          Private transport for every kind of Udaipur trip
        </h1>
        <p
          class="text-brand-100/90 text-base sm:text-lg font-light leading-relaxed"
        >
          Transfers, local travel, outstation and group transport. Open a
          service to see what it covers, suitable vehicles and, where approved,
          its price.
        </p>
      </div>
    </div>
  </section>

  {/* 2. FLOATING TAB BAR NAVIGATION (Refactored to State-Driven CSS) */}
  <TabBar
    mode="anchor"
    tabClass="service-tab-btn"
    tabs={groupedServices.map((group) => ({
      label: group.category,
      badge: group.services.length,
      slug: group.slug,
    }))}
  />

  {/* 3. CATEGORISED SERVICE LISTINGS */}
  <section class="pt-16 pb-16 lg:pt-20 lg:pb-24 bg-surface">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 lg:space-y-24"
    >
      {
        groupedServices.length > 0 ? (
          groupedServices.map((group) => {
            const IconComponent = group.metadata.icon;
            return (
              <div
                id={group.slug}
                class="scroll-mt-32 border-b border-brand-100/80 pb-16 last:border-b-0 last:pb-0"
              >
                <div class="mb-10">
                  <div class="flex items-center gap-3.5 mb-1">
                    <div class="w-10 h-10 rounded-xl bg-brand-900 text-accent flex items-center justify-center shrink-0 shadow-sm">
                      <IconComponent size={20} stroke={2} />
                    </div>
                    <h2 class="font-serif text-xl sm:text-2xl lg:text-3xl font-bold text-brand-900 tracking-tight">
                      {group.category}
                    </h2>
                  </div>
                  <p class="text-sm sm:text-base text-typography-muted font-normal max-w-2xl leading-relaxed pl-13 sm:pl-13">
                    {group.metadata.subtitle}
                  </p>
                  <div class="mt-4 border-b border-brand-100/80 w-full" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                  {group.services.map((service) => (
                    <ServiceCard service={service} />
                  ))}
                </div>
              </div>
            );
          })
        ) : (
          <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
            <div class="w-12 h-12 rounded-xl bg-brand-900 text-accent flex items-center justify-center mx-auto mb-4">
              <IconCar size={24} stroke={2} />
            </div>
            <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
              No Services Published Yet
            </h3>
            <p class="text-sm text-typography-muted mb-6">
              Our content administrators are currently updating the transport
              catalogue.
            </p>
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block shadow-sm"
            >
              Send General Inquiry
            </a>
          </div>
        )
      }
    </div>
  </section>

  <CatalogueSupportCTA type="services" />
  <FAQSection />

  {/* 6. DISCLAIMER */}
  <section class="py-12 bg-surface-alt/50 border-t border-brand-100/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs sm:text-sm text-typography-muted leading-relaxed">
        Each service above is available in and around Udaipur, from airport and
        railway transfers to sightseeing, nearby day use and outstation travel
        across Rajasthan. Coverage and example trips are described within each
        service page as guidance, not as separate booking pages. Where a price
        is confirmed it is shown with its terms; otherwise please ask us for a
        quote.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  function initServiceScrollspy() {
    const tabs = document.querySelectorAll(".service-tab-btn");
    let isClickScrolling = false;
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;

    // Helper: Pass the href to activate, it handles the rest.
    const setActive = (activeHref: string) => {
      tabs.forEach((btn) => {
        const isMatch = btn.getAttribute("href") === activeHref;
        btn.setAttribute("aria-selected", String(isMatch));
        if (isMatch)
          btn.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "center",
          });
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (isClickScrolling) return;
        entries.forEach((e) => {
          if (e.isIntersecting) setActive(`#${e.target.id}`);
        });
      },
      { rootMargin: "-25% 0px -75% 0px", threshold: 0 },
    );

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const href = btn.getAttribute("href");
        if (href) setActive(href);
        isClickScrolling = true;
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => (isClickScrolling = false), 1000);
      });

      const href = btn.getAttribute("href");
      if (href && href.startsWith("#")) {
        const target = document.querySelector(href);
        if (target) observer.observe(target);
      }
    });
  }

  initServiceScrollspy();
  document.addEventListener("astro:page-load", initServiceScrollspy);
</script>

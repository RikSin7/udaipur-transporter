---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/cards/ServiceCard.astro';
import { sortPublishedByOrder, getWhatsAppUrl } from '../../utils/helpers';

// 1. Fetch singleton business settings
const settingsEntries = await getCollection('settings').catch(() => []);
console.log(settingsEntries)
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};

// 2. Fetch all services and sort by sortOrder ascending
const allServices = await getCollection('services').catch(() => []);
const publishedServices = sortPublishedByOrder(allServices);

// 3. Define the strict category hierarchy
const categoryOrder = [
  "Transfers", 
  "Local Travel", 
  "Outstation Travel", 
  "Group and Event Travel", 
  "Additional"
] as const;

// 4. Group services by category (skips categories that have 0 published services)
const groupedServices = categoryOrder
  .map(category => ({
    category,
    services: publishedServices.filter(s => s.data.category === category)
  }))
  .filter(group => group.services.length > 0);

const callUrl = `tel:${site.phone.replace(/\s+/g, '')}`;
const whatsappUrl = getWhatsAppUrl(site.whatsapp, "Transport Services Catalogue", Astro.url.href);
---

<BaseLayout 
  title={`Our Transport Services | ${site.companyName}`}
  description="Explore owner-approved private transport services in Udaipur. Transparent airport transfers, flexible local car rentals with driver, and outstation Rajasthan taxis."
>
  {/* 1. HERO BANNER */}
  <section class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4">
          Owner-Approved Catalogue
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
          Private Udaipur Transport Services
        </h1>
        <p class="text-brand-100/90 text-lg font-light leading-relaxed">
          We provide straightforward, reliable private transportation across Udaipur and Rajasthan. Browse our service categories below. Every service includes transparent pricing rules and direct local driver coordination.
        </p>
      </div>
    </div>
  </section>

  {/* 2. CATEGORISED SERVICE LISTINGS */}
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 lg:space-y-20">
      
      {groupedServices.length > 0 ? (
        groupedServices.map(group => (
          <div class="border-b border-brand-100/80 pb-16 last:border-b-0 last:pb-0">
            {/* Category Header */}
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
              <div>
                <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900">
                  {group.category}
                </h2>
                <span class="inline-block w-12 h-1 bg-accent rounded-full mt-2"></span>
              </div>
              <p class="text-sm text-typography-muted mt-2 md:mt-0 font-medium">
                Showing {group.services.length} available {group.services.length === 1 ? 'service' : 'services'}
              </p>
            </div>

            {/* Category Cards Grid */}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {group.services.map(service => (
                <ServiceCard service={service} />
              ))}
            </div>
          </div>
        ))
      ) : (
        /* Empty State Fallback */
        <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
          <div class="text-3xl mb-3">🚗</div>
          <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">No Services Published Yet</h3>
          <p class="text-sm text-typography-muted mb-6">
            Our content administrators are currently updating the transport catalogue. Please check back soon or contact us directly for immediate travel bookings.
          </p>
          <a href="/enquiry/" class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block">
            Send General Inquiry
          </a>
        </div>
      )}

    </div>
  </section>

  {/* 3. FLEET CROSS-LINK & GENERAL ENQUIRY BANNER */}
  <section class="py-16 bg-surface-alt/70 border-t border-brand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-brand-900 text-white rounded-2xl p-8 sm:p-12 shadow-premium flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <div class="max-w-2xl text-center lg:text-left">
          <span class="text-xs font-bold uppercase tracking-widest text-accent mb-2 block">
            Custom Requirements?
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">
            Need a Specific Vehicle or Custom Rajasthan Itinerary?
          </h2>
          <p class="text-brand-100/80 text-sm sm:text-base leading-relaxed">
            If you do not see your exact travel route listed above, we can tailor a multi-day trip or allocate specific vehicles like Tempo Travellers and SUVs. View our fleet capacity or request a custom quote.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full lg:w-auto shrink-0">
          <a 
            href="/vehicles/" 
            class="bg-brand-800 hover:bg-brand-700 text-white font-bold px-6 py-4 rounded-xl text-sm text-center transition-all border border-brand-100/20"
          >
            Explore Vehicle Fleet &rarr;
          </a>
          <a 
            href="/enquiry/" 
            class="bg-accent hover:bg-accent-hover text-white font-bold px-6 py-4 rounded-xl text-sm text-center transition-all shadow-md active:scale-95"
          >
            Send Travel Request
          </a>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
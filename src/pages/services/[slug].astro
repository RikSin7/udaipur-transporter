---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import EnquiryForm from "../../components/forms/EnquiryForm.astro";
import { getWhatsAppUrl } from "../../utils/helpers";
import {
  IconCheck,
  IconX,
  IconChevronDown,
  IconArrowRight,
  IconBrandWhatsapp,
  IconPhoneCall,
  IconMessage2,
  IconCar,
  IconShieldCheck,
  IconClock,
} from "@tabler/icons-astro";

// 1. GENERATE STATIC PATHS
export async function getStaticPaths() {
  const services = await getCollection("services").catch(() => []);
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

// 2. FETCH CURRENT SERVICE PROPS
const { entry } = Astro.props;
const {
  title,
  category,
  summary,
  image,
  pricing,
  whoIsThisFor = [],
  whatsCovered = [],
  suitableVehicles = [],
  faqs = [],
} = entry.data;

// 3. RENDER MARKDOWN BODY
const { Content } = await render(entry);

// 4. FETCH ALL VEHICLES TO MATCH 'suitableVehicles' IDs
const allVehicles = await getCollection("vehicles").catch(() => []);
const matchedVehicles = allVehicles.filter((v) =>
  suitableVehicles.includes(v.id),
);

// 5. FETCH RELATED SERVICES (Excluding current one, sorted by your sortOrder convention)
const allServices = await getCollection("services").catch(() => []);
const relatedServices = allServices
  .filter((s) => s.id !== entry.id && s.data.published)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 3);

// 6. BUSINESS SETTINGS FOR CTAs
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};
const callUrl = `tel:${site.phone.replace(/\s+/g, "")}`;
const whatsappUrl = getWhatsAppUrl(site.whatsapp, title, Astro.url.href);

const hasPrice = !!pricing?.amount;
const priceLabel = pricing?.shortLabel || "Ask for Price";
---

<BaseLayout title={`${title} | ${site.companyName}`} description={summary}>
  <Header slot="header" />

  {/* 1. HERO BANNER */}
  <section
    class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span
          class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4"
        >
          {category}
        </span>
        <h1
          class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 mb-4 text-white tracking-tight"
        >
          {title}
        </h1>
        <p
          class="text-brand-100/90 text-base sm:text-lg leading-relaxed font-light"
        >
          {summary}
        </p>
      </div>
    </div>
  </section>

  {/* 2. MAIN CONTENT AREA & SIDEBAR WIDGET */}
  <section class="py-16 lg:py-24 bg-surface relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 relative">
        {/* LEFT COLUMN: Service Details (Span 7) */}
        <div class="lg:col-span-7 space-y-16">
          {/* NEW: FEATURED SERVICE IMAGE BANNER */}
          {
            image && (
              <div class="overflow-hidden rounded-2xl border border-brand-100 shadow-sm bg-surface-alt">
                <Image
                  src={image}
                  alt={title}
                  width={1000}
                  height={560}
                  format="webp"
                  quality={85}
                  class="w-full h-auto object-cover max-h-[420px] hover:scale-102 transition-transform duration-500"
                />
              </div>
            )
          }

          {/* SECTION A: WHO THIS IS FOR */}
          {
            whoIsThisFor.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-2">
                  Who this is for
                </h2>
                <p class="text-sm text-typography-muted mb-6">
                  Travellers who want a calm, private arrival or departure
                  without hunting for a cab. Suited to families, couples, solo
                  and international visitors.
                </p>
                <div class="flex flex-wrap gap-2.5">
                  {whoIsThisFor.map((pill) => (
                    <span class="bg-surface-card border border-brand-100 text-brand-900 text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl shadow-2xs">
                      {pill}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          {/* SECTION B: WHAT'S COVERED (2x2 Grid) */}
          {
            whatsCovered.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  What's covered
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                  {whatsCovered.map((item) => (
                    <div class="bg-surface-card border border-brand-100 rounded-2xl p-6 shadow-sm hover:border-brand-800/40 transition-all flex flex-col justify-between">
                      <div>
                        <h3 class="font-serif text-base font-bold text-brand-900 mb-2 flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-accent inline-block shrink-0" />
                          <span>{item.title}</span>
                        </h3>
                        <p class="text-xs sm:text-sm text-typography-muted leading-relaxed">
                          {item.description}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="text-[11px] text-typography-muted italic">
                  Coverage examples above are explanatory. Share your exact
                  flight, hotel or route in the enquiry and we'll confirm the
                  plan.
                </p>
              </div>
            )
          }

          {/* SECTION C: SUITABLE VEHICLES */}
          {
            matchedVehicles.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-2">
                  Suitable vehicles
                </h2>
                <p class="text-sm text-typography-muted mb-6">
                  Recommended passengers reflect comfortable seating after
                  luggage. Images are representative.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  {matchedVehicles.map((vehicle) => (
                    <a
                      href={`/vehicles/${vehicle.id}/`}
                      class="bg-surface-card border border-brand-100 rounded-2xl p-5 shadow-sm hover:shadow-premium hover:border-brand-800 transition-all group flex flex-col justify-between"
                    >
                      <div>
                        <div class="w-10 h-10 rounded-xl bg-surface-alt flex items-center justify-center text-brand-900 mb-4 group-hover:scale-105 transition-transform">
                          <IconCar size={20} stroke={2} />
                        </div>
                        <h3 class="font-serif text-base font-bold text-brand-900 group-hover:text-accent transition-colors mb-1">
                          {vehicle.data.title}
                        </h3>
                      </div>
                      <div class="mt-4 pt-3 border-t border-brand-100/60 text-[11px] font-semibold text-typography-muted flex items-center justify-between">
                        <span>{vehicle.data.passengers} + driver</span>
                        <span>{vehicle.data.luggage} bags</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          {/* SECTION D: APPROVED TARIFF TABLE */}
          {
            hasPrice && (
              <div class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-sm">
                <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-brand-100 pb-6 mb-6">
                  <div>
                    <h2 class="font-serif text-2xl font-bold text-brand-900">
                      Price
                    </h2>
                    <p class="text-xs text-typography-muted mt-0.5">
                      {pricing.unit}{" "}
                      {pricing.lastUpdated &&
                        `· Last updated ${pricing.lastUpdated}`}
                    </p>
                  </div>
                  <div class="text-right">
                    <span class="font-serif text-3xl sm:text-4xl font-bold text-brand-900 block">
                      {pricing.amount}
                    </span>
                    <span class="text-xs text-typography-muted">
                      {pricing.shortLabel}
                    </span>
                  </div>
                </div>

                {/* Inclusions & Exclusions */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-xs sm:text-sm">
                  {/* Included */}
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 block mb-3">
                      Included
                    </span>
                    <ul class="space-y-2.5 text-typography-muted">
                      {pricing.inclusions?.map((inc) => (
                        <li class="flex items-start gap-2">
                          <IconCheck
                            size={16}
                            stroke={2.5}
                            className="text-emerald-600 shrink-0 mt-0.5"
                          />
                          <span>{inc}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Not Included */}
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-red-600 block mb-3">
                      Not Included
                    </span>
                    <ul class="space-y-2.5 text-typography-muted">
                      {pricing.exclusions?.map((exc) => (
                        <li class="flex items-start gap-2">
                          <IconX
                            size={16}
                            stroke={2.5}
                            className="text-red-500 shrink-0 mt-0.5"
                          />
                          <span>{exc}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            )
          }

          {/* SECTION E: FREE-FORM MARKDOWN CONTENT */}
          <div
            class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-p:text-typography-muted"
          >
            <Content />
          </div>

          {/* SECTION F: SERVICE FAQS (Accordion) */}
          {
            faqs.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  Service FAQs
                </h2>
                <div class="space-y-4" id="service-faq-group">
                  {faqs.map((faq, idx) => (
                    <div
                      class="faq-item bg-surface-card border border-border hover:border-brand-900 rounded-2xl transition-all duration-300 overflow-hidden shadow-sm hover:shadow-md"
                      data-open={idx === 0 ? "true" : "false"}
                    >
                      <button
                        type="button"
                        class="faq-trigger w-full p-5 sm:p-6 text-left font-serif text-base sm:text-lg font-bold text-brand-900 flex items-center justify-between gap-4 cursor-pointer"
                      >
                        <span>{faq.question}</span>
                        <div class="w-7 h-7 rounded-full bg-surface-alt flex items-center justify-center text-brand-900 shrink-0 faq-icon transition-transform">
                          <IconChevronDown size={16} stroke={2.5} />
                        </div>
                      </button>
                      <div
                        class="faq-content transition-all duration-300 overflow-hidden"
                        style={idx === 0 ? "" : "max-height: 0px; opacity: 0;"}
                      >
                        <p class="px-5 pb-5 sm:px-6 sm:pb-6 pt-1 text-xs sm:text-sm text-typography-muted leading-relaxed border-t border-brand-100/40">
                          {faq.answer}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          {/* SECTION G: RELATED SERVICES */}
          {
            relatedServices.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  Related services
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                  {relatedServices.map((rel) => (
                    <a
                      href={`/services/${rel.id}/`}
                      class="bg-surface-card border border-brand-100 rounded-xl p-5 shadow-sm hover:shadow-premium transition-all group flex flex-col justify-between"
                    >
                      <div>
                        <h3 class="font-serif text-base font-bold text-brand-900 group-hover:text-accent transition-colors mb-2">
                          {rel.data.title}
                        </h3>
                        <p class="text-xs text-typography-muted line-clamp-2 leading-relaxed">
                          {rel.data.summary}
                        </p>
                      </div>
                      <div class="mt-4 pt-3 border-t border-brand-100/60 text-xs font-bold text-brand-900 group-hover:text-accent flex items-center justify-between">
                        <span>From {rel.data.pricing?.amount || "Quote"}</span>
                        <IconArrowRight
                          size={14}
                          stroke={2}
                          className="group-hover:translate-x-1 transition-transform"
                        />
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        {/* RIGHT COLUMN: Desktop Floating Action Card */}
        <div class="lg:col-span-5 sticky top-24 self-start z-20">
          <div
            class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-premium space-y-6"
          >
            {/* Price Header */}
            <div>
              <span
                class="text-xs font-semibold text-typography-muted uppercase tracking-wider block"
              >
                Starting from
              </span>
              <div class="flex items-baseline gap-2 mt-1">
                <span class="font-serif text-4xl font-bold text-brand-900">
                  {hasPrice ? pricing.amount : "Custom Quote"}
                </span>
                <span class="text-xs text-typography-muted">{priceLabel}</span>
              </div>
              <p
                class="text-xs text-typography-muted mt-3 leading-normal border-t border-brand-100 pt-3"
              >
                Sending a request does not confirm a trip. We contact you
                directly to confirm vehicle availability and final details.
              </p>
            </div>

            {/* Jump to Form Button */}
            <a
              href="#enquiry-section"
              class="w-full bg-brand-900 hover:bg-brand-800 text-white font-serif font-bold py-4 rounded-xl shadow-md transition-all text-center block active:scale-95 cursor-pointer"
            >
              Send travel request
            </a>

            {/* Direct Channel Buttons */}
            <div class="grid grid-cols-2 gap-3">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-surface border border-brand-100 hover:border-emerald-600 text-brand-900 hover:text-emerald-600 font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-2xs"
              >
                <IconBrandWhatsapp
                  size={16}
                  stroke={2}
                  className="text-emerald-600"
                />
                <span>WhatsApp</span>
              </a>
              <a
                href={callUrl}
                class="bg-surface border border-brand-100 hover:border-accent text-brand-900 hover:text-accent font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-2xs"
              >
                <IconPhoneCall size={16} stroke={2} className="text-accent" />
                <span>Call Us</span>
              </a>
            </div>

            {/* Reassurance Bullet Points */}
            <div
              class="border-t border-brand-100/80 pt-4 space-y-2.5 text-xs text-typography-muted"
            >
              <div class="flex items-center gap-2">
                <IconShieldCheck
                  size={16}
                  stroke={2}
                  className="text-accent shrink-0"
                />
                <span>Driver details shared before pickup</span>
              </div>
              <div class="flex items-center gap-2">
                <IconClock
                  size={16}
                  stroke={2}
                  className="text-accent shrink-0"
                />
                <span>Reasonable free waiting on arrival</span>
              </div>
              <div class="flex items-center gap-2">
                <IconMessage2
                  size={16}
                  stroke={2}
                  className="text-accent shrink-0"
                />
                <span>Direct local support on WhatsApp & call</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. STACKED ENQUIRY FORM AT THE BOTTOM */}
  <section
    id="enquiry-section"
    class="py-16 lg:py-24 bg-brand-900 text-white border-t border-brand-800 scroll-mt-12"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Dark Royal Form Header */}
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span
          class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-3"
        >
          Direct Booking Request
        </span>
        <h2
          class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight"
        >
          Enquire about {title}
        </h2>
        <p class="text-brand-100/80 text-sm sm:text-base mt-2">
          Your service and page context are attached automatically. We'll
          contact you to confirm details and exact rates.
        </p>
      </div>

      {/* Form Component */}
      <EnquiryForm defaultService={title} priceLabel={priceLabel} />
    </div>
  </section>
</BaseLayout>

{/* Service FAQ Accordion Controller */}
<script>
  function initServiceFaq() {
    const triggers = document.querySelectorAll(
      "#service-faq-group .faq-trigger",
    );
    triggers.forEach((trigger) => {
      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);
      newTrigger.addEventListener("click", () => {
        const item = newTrigger.closest(".faq-item") as HTMLElement;
        const content = item?.querySelector(".faq-content") as HTMLElement;
        const icon = newTrigger.querySelector(".faq-icon") as HTMLElement;
        const isOpen = item.getAttribute("data-open") === "true";

        // Single-open closure loop
        if (!isOpen) {
          document
            .querySelectorAll('#service-faq-group .faq-item[data-open="true"]')
            .forEach((openItem) => {
              if (openItem !== item) {
                openItem.setAttribute("data-open", "false");
                const openContent = openItem.querySelector(
                  ".faq-content",
                ) as HTMLElement;
                const openIcon = openItem.querySelector(
                  ".faq-icon",
                ) as HTMLElement;
                if (openContent) {
                  openContent.style.maxHeight = "0px";
                  openContent.style.opacity = "0";
                }
                if (openIcon) openIcon.style.transform = "rotate(0deg)";
              }
            });
        }

        // Toggle clicked
        if (isOpen) {
          item.setAttribute("data-open", "false");
          content.style.maxHeight = "0px";
          content.style.opacity = "0";
          if (icon) icon.style.transform = "rotate(0deg)";
        } else {
          item.setAttribute("data-open", "true");
          content.style.maxHeight = `${content.scrollHeight}px`;
          content.style.opacity = "1";
          if (icon) icon.style.transform = "rotate(180deg)";
        }
      });
    });

    document
      .querySelectorAll('#service-faq-group .faq-item[data-open="true"]')
      .forEach((item) => {
        const content = item.querySelector(".faq-content") as HTMLElement;
        const icon = item.querySelector(".faq-icon") as HTMLElement;
        if (content) {
          content.style.maxHeight = `${content.scrollHeight}px`;
          content.style.opacity = "1";
        }
        if (icon) icon.style.transform = "rotate(180deg)";
      });
  }
  initServiceFaq();
  document.addEventListener("astro:page-load", initServiceFaq);
</script>

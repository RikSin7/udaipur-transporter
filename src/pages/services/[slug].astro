---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import { getWhatsAppUrl } from '../../utils/helpers';

// 1. GENERATE STATIC URLS FOR EVERY SERVICE FILE
export async function getStaticPaths() {
  const services = await getCollection('services').catch(() => []);
  return services.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

// 2. GET THE CURRENT SERVICE DATA FROM PROPS
const { entry } = Astro.props;
const { title, category, summary, pricing } = entry.data;

// 3. CONVERT MARKDOWN BODY INTO HTML (<Content />)
const { Content } = await render(entry);

// 4. PREPARE PRICING RULES
const hasPrice = !!pricing?.amount;
const priceLabel = pricing?.shortLabel || "Ask for Price";

// Fetch settings for direct WhatsApp/Phone actions
const settingsEntries = await getCollection('settings').catch(() => []);
const site = settingsEntries[0]?.data || { phone: "+91 98765 43210", whatsapp: "919876543210" };
const callUrl = `tel:${site.phone.replace(/\s+/g, '')}`;
const whatsappUrl = getWhatsAppUrl(site.whatsapp, title, Astro.url.href);
---

<BaseLayout title={`${title} | ${site.companyName}`} description={summary}>
  <Header slot="header" />

  {/* HERO HEADER FOR THE SERVICE */}
  <section class="bg-brand-900 text-white py-12 lg:py-16 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full">
          {category}
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold mt-4 mb-4 text-white">
          {title}
        </h1>
        <p class="text-brand-100/80 text-base sm:text-lg leading-relaxed font-light">
          {summary}
        </p>
      </div>
    </div>
  </section>

  {/* MAIN CONTENT & PRICING GRID */}
  <section class="py-12 lg:py-16 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        {/* LEFT COLUMN: Markdown Body Content & Price Inclusions (Span 7) */}
        <div class="lg:col-span-7 space-y-10">
          
          {/* Renders the actual Markdown text typed inside Decap CMS / .md file */}
          <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-p:text-typography-muted prose-a:text-accent">
            <Content />
          </div>

          {/* Embedded Price Block (Only shows if price is approved) */}
          {hasPrice && (
            <div class="bg-surface-alt border-2 border-accent/40 rounded-2xl p-6 sm:p-8 shadow-sm">
              <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-brand-100 pb-4 mb-6">
                <div>
                  <span class="text-xs font-bold uppercase tracking-widest text-typography-muted block">Approved Tariff</span>
                  <h3 class="font-serif text-3xl font-bold text-brand-900 mt-1">{pricing.amount}</h3>
                </div>
                {pricing.unit && (
                  <span class="text-sm font-semibold bg-brand-900 text-white px-3 py-1.5 rounded-lg">
                    {pricing.unit}
                  </span>
                )}
              </div>

              {/* Inclusions & Exclusions */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm mb-6">
                {pricing.inclusions && pricing.inclusions.length > 0 && (
                  <div>
                    <h4 class="font-bold text-brand-900 mb-2.5 flex items-center gap-1.5">
                      <span class="text-emerald-600 font-bold">✓</span> What's Included
                    </h4>
                    <ul class="space-y-1.5 text-typography-muted">
                      {pricing.inclusions.map(inc => <li>• {inc}</li>)}
                    </ul>
                  </div>
                )}
                {pricing.exclusions && pricing.exclusions.length > 0 && (
                  <div>
                    <h4 class="font-bold text-brand-900 mb-2.5 flex items-center gap-1.5">
                      <span class="text-red-500 font-bold">✕</span> Exclusions / Extras
                    </h4>
                    <ul class="space-y-1.5 text-typography-muted">
                      {pricing.exclusions.map(exc => <li>• {exc}</li>)}
                    </ul>
                  </div>
                )}
              </div>

              {/* Important Scope Notes */}
              {pricing.notes && (
                <div class="text-xs text-typography-muted bg-surface p-3.5 rounded-lg border border-brand-100 italic">
                  <strong>Note:</strong> {pricing.notes}
                </div>
              )}
            </div>
          )}

          {/* Quick Contact Actions */}
          <div class="bg-brand-900 text-white p-6 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <h4 class="font-serif text-lg font-bold">Need instant quote confirmation?</h4>
              <p class="text-xs text-brand-100/70">Speak directly with the transport provider on WhatsApp or Phone.</p>
            </div>
            <div class="flex gap-3 w-full sm:w-auto">
              <a href={callUrl} class="flex-1 sm:flex-initial text-center bg-brand-800 hover:bg-brand-700 text-white px-4 py-2.5 rounded-lg text-xs font-bold transition-all">📞 Call Now</a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex-1 sm:flex-initial text-center bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-lg text-xs font-bold transition-all">💬 WhatsApp</a>
            </div>
          </div>

        </div>

        {/* RIGHT COLUMN: Page-Aware Enquiry Form (Span 5) */}
        <div class="lg:col-span-5">
          <div class="sticky top-28">
            {/* Pre-fills form with exact service name and price label */}
            <EnquiryForm 
              defaultService={title} 
              priceLabel={priceLabel} 
            />
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EnquiryForm from "../../components/forms/EnquiryForm.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import ServiceCard from "../../components/cards/ServiceCard.astro";
import VehicleCard from "../../components/cards/VehicleCard.astro";
import { getWhatsAppUrl, getCallUrl } from "../../utils/helpers";
import {
  IconCheck,
  IconX,
  IconChevronDown,
  IconBrandWhatsapp,
  IconPhoneCall,
  IconMessage2,
  IconShieldCheck,
  IconClock,
} from "@tabler/icons-astro";

import ServiceGalleryHero from "../../components/sections/ServiceGalleryHero.astro";
import PageHeroSection from "../../components/sections/PageHeroSection.astro";

// 1. GENERATE STATIC PATHS
export async function getStaticPaths() {
  const services = await getCollection("services");
  return services
    .filter((entry) => entry.data.published)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

// 2. FETCH CURRENT SERVICE PROPS
const { entry } = Astro.props;
const {
  title,
  category,
  summary,
  image,
  gallery = [],
  galleryBadge,
  galleryTitle,
  galleryDescription,
  heroBadge,
  heroTitle,
  heroDescription,
  pricing,
  whoIsThisForHeading,
  whoIsThisForContent,
  whoIsThisFor = [],
  whatsCovered = [],
  whatsCoveredNote,
  suitableVehicles = [],
  faqs = [],
} = entry.data;

const hasPrimaryGalleryImage = gallery.some(
  (item: { isPrimary?: boolean }) => item?.isPrimary,
);

let heroGallery = [...gallery];
if (gallery.length > 0 && image && !hasPrimaryGalleryImage) {
  heroGallery.unshift({ url: image, isPrimary: true });
}

// 3. RENDER MARKDOWN BODY
const { Content } = await render(entry);

// 4. FETCH DATA
const [allVehicles, allServices, settingsEntry] = await Promise.all([
  getCollection("vehicles"),
  getCollection("services"),
  getEntry("settings", "site"),
]);

const matchedVehicles = allVehicles.filter(
  (v) => v.data.published && suitableVehicles.includes(v.id),
);
const relatedServices = allServices
  .filter((s) => s.data.published && s.id !== entry.id)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 3);

const site = settingsEntry?.data;

if (!site) throw new Error("Missing settings/site.md");

const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(site.whatsapp, title);
const hasPrice = !!pricing?.amount;
const priceLabel = pricing?.shortLabel || "Ask for Price";

// Reassurance Bullets for Sidebar
const reassurances = [
  { Icon: IconShieldCheck, text: "Driver details shared before pickup" },
  { Icon: IconClock, text: "Reasonable free waiting on arrival" },
  { Icon: IconMessage2, text: "Direct local support on WhatsApp & call" },
];
---

<BaseLayout title={`${title} | ${site.companyName}`} description={summary}>
  {/* 1. GALLERY HERO */}
  {
    heroGallery && heroGallery.length > 0 ? (
      <ServiceGalleryHero
        title={title}
        gallery={heroGallery}
        badge={galleryBadge}
        galleryHeading={galleryTitle}
        description={galleryDescription}
      />
    ) : (
      <PageHeroSection
        subheading={heroBadge || category}
        heading={heroTitle || title}
        description={heroDescription || summary}
        heroImage={image}
      />
    )
  }

  {/* 2. MAIN CONTENT AREA */}
  <section class="py-12 bg-surface-alt/40 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 relative">
        {/* LEFT COLUMN */}
        <div class="lg:col-span-7 space-y-16">
          {
            (whoIsThisFor.length > 0 || whoIsThisForContent) && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-2">
                  {whoIsThisForHeading || "Who this is for"}
                </h2>
                <p class="text-sm text-typography-muted mb-6">
                  {whoIsThisForContent ||
                    "Travellers seeking comfortable, dependable private transportation across Udaipur and Rajasthan. Suited to families, couples, solo and corporate visitors."}
                </p>
                {whoIsThisFor.length > 0 && (
                  <div class="flex flex-wrap gap-2.5">
                    {whoIsThisFor.map((pill) => (
                      <span class="bg-surface-card border border-brand-100 text-brand-900 text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl shadow-2xs">
                        {pill}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            )
          }

          {
            whatsCovered.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  What's covered
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                  {whatsCovered.map((item) => (
                    <div class="bg-surface-card border border-brand-100 rounded-2xl p-6 shadow-sm hover:border-brand-800/40 transition-all flex flex-col justify-between">
                      <div>
                        <h3 class="font-serif text-base font-bold text-brand-900 mb-2 flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-accent inline-block shrink-0" />
                          <span>{item.title}</span>
                        </h3>
                        <p class="text-xs sm:text-sm text-typography-muted leading-relaxed">
                          {item.description}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="text-[11px] text-typography-muted italic">
                  {whatsCoveredNote ||
                    "Coverage examples above are explanatory. Share your specific travel dates, hotel, or itinerary in the enquiry and we'll confirm the plan."}
                </p>
              </div>
            )
          }

          {
            hasPrice && (
              <div class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-sm">
                <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-brand-100 pb-6 mb-6">
                  <div>
                    <h2 class="font-serif text-2xl font-bold text-brand-900">
                      Price
                    </h2>
                    <p class="text-xs text-typography-muted mt-0.5">
                      {pricing.unit}{" "}
                      {pricing.lastUpdated &&
                        `· Last updated ${pricing.lastUpdated}`}
                    </p>
                  </div>
                  <div class="text-right">
                    <span class="font-serif text-3xl sm:text-4xl font-bold text-brand-900 block">
                      {pricing.amount}
                    </span>
                    <span class="text-xs text-typography-muted">
                      {pricing.shortLabel}
                    </span>
                  </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-xs sm:text-sm">
                  {pricing.inclusions && pricing.inclusions.length > 0 && (
                    <div>
                      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 block mb-3">
                        Included
                      </span>
                      <ul class="space-y-2.5 text-typography-muted">
                        {pricing.inclusions.map((inc) => (
                          <li class="flex items-start gap-2">
                            <IconCheck
                              size={16}
                              stroke={2.5}
                              class="text-emerald-600 shrink-0 mt-0.5"
                            />
                            <span>{inc}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {pricing.exclusions && pricing.exclusions.length > 0 && (
                    <div>
                      <span class="text-[11px] font-bold uppercase tracking-wider text-red-600 block mb-3">
                        Not Included
                      </span>
                      <ul class="space-y-2.5 text-typography-muted">
                        {pricing.exclusions.map((exc) => (
                          <li class="flex items-start gap-2">
                            <IconX
                              size={16}
                              stroke={2.5}
                              class="text-red-500 shrink-0 mt-0.5"
                            />
                            <span>{exc}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
                {pricing.notes && (
                  <div class="mt-6 pt-6 border-t border-brand-100 text-xs text-typography-muted leading-relaxed">
                    <p>{pricing.notes}</p>
                  </div>
                )}
              </div>
            )
          }

          <div
            class="prose md:prose-lg max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-p:text-typography-muted"
          >
            <Content />
          </div>

          {
            faqs.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  Service FAQs
                </h2>
                <div class="space-y-4" id="service-faq-group">
                  {faqs.map((faq, idx) => (
                    <div
                      class="faq-item bg-surface-card border border-border hover:border-brand-900 rounded-2xl transition-all duration-300 overflow-hidden shadow-sm hover:shadow-md"
                      data-open={idx === 0 ? "true" : "false"}
                    >
                      <button
                        type="button"
                        class="faq-trigger w-full p-5 sm:p-6 text-left font-serif text-base sm:text-lg font-bold text-brand-900 flex items-center justify-between gap-4 cursor-pointer"
                      >
                        <span>{faq.question}</span>
                        <div class="w-7 h-7 rounded-full bg-surface-alt flex items-center justify-center text-brand-900 shrink-0 faq-icon transition-transform">
                          <IconChevronDown size={16} stroke={2.5} />
                        </div>
                      </button>
                      <div
                        class="faq-content transition-all duration-300 overflow-hidden"
                        style={idx === 0 ? "" : "max-height: 0px; opacity: 0;"}
                      >
                        <p class="px-5 pb-5 sm:px-6 sm:pb-6 pt-1 text-xs sm:text-sm text-typography-muted leading-relaxed border-t border-brand-100/40">
                          {faq.answer}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          {
            matchedVehicles.length > 0 && (
              <div class="mb-10">
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  Suitable vehicles
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 items-stretch">
                  {matchedVehicles.map((vehicle) => (
                    <VehicleCard vehicle={vehicle} />
                  ))}
                </div>
              </div>
            )
          }

          {
            relatedServices.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl font-bold text-brand-900 mb-6">
                  Related services
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 items-stretch">
                  {relatedServices.map((rel) => (
                    <ServiceCard service={rel} />
                  ))}
                </div>
              </div>
            )
          }
        </div>

        {/* RIGHT COLUMN */}
        <div class="lg:col-span-5 sticky top-24 self-start z-20">
          <div
            class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-premium space-y-6"
          >
            <div>
              <span
                class="text-xs font-semibold text-typography-muted uppercase tracking-wider block"
                >{pricing?.prefix || "Starting from"}</span
              >
              <div class="flex items-baseline gap-2 mt-1">
                <span class="font-serif text-4xl font-bold text-brand-900"
                  >{hasPrice ? pricing.amount : "Custom Quote"}</span
                >
                <span class="text-xs text-typography-muted">{priceLabel}</span>
              </div>
              <p
                class="text-xs text-typography-muted mt-3 leading-normal border-t border-brand-100 pt-3"
              >
                {
                  pricing?.disclaimer ||
                    "Sending a request does not confirm a trip. We contact you directly to confirm vehicle availability and final details."
                }
              </p>
            </div>

            <a
              href="#enquiry-section"
              class="w-full bg-brand-900 hover:bg-brand-800 text-white font-serif font-bold py-4 rounded-xl shadow-md transition-all text-center block active:scale-95 cursor-pointer uppercase"
              >Send travel request</a
            >

            <div class="grid grid-cols-2 gap-3">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-surface border border-brand-100 hover:border-emerald-600 text-brand-900 hover:text-emerald-600 font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-2xs uppercase"
              >
                <IconBrandWhatsapp
                  size={16}
                  stroke={2}
                  class="text-emerald-600"
                />
                <span>WhatsApp</span>
              </a>
              <a
                href={callUrl}
                class="bg-surface border border-brand-100 hover:border-accent text-brand-900 hover:text-accent font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-2xs uppercase"
              >
                <IconPhoneCall size={16} stroke={2} class="text-accent" />
                <span>Call Us</span>
              </a>
            </div>

            <div
              class="border-t border-brand-100/80 pt-4 space-y-2.5 text-xs text-typography-muted"
            >
              {
                reassurances.map(({ Icon, text }) => (
                  <div class="flex items-center gap-2">
                    <Icon size={16} stroke={2} class="text-accent shrink-0" />{" "}
                    <span>{text}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. ENQUIRY FORM */}
  <section id="enquiry-section" class="py-12 bg-surface/80 scroll-mt-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading="Direct Booking Request"
        heading={`Enquire about ${title}`}
        description="Your service and page context are attached automatically. We'll contact you to confirm details and exact rates."
        class="mb-12"
      />
      <EnquiryForm defaultService={title} priceLabel={priceLabel} />
    </div>
  </section>
</BaseLayout>

<script>
  function initServiceFaq() {
    const group = document.getElementById("service-faq-group");
    if (!group || group.dataset.init === "true") return;
    group.dataset.init = "true";

    // Reusable toggle helper
    const toggleFaq = (item: HTMLElement, open: boolean) => {
      item.setAttribute("data-open", String(open));
      const content = item.querySelector(".faq-content") as HTMLElement;
      const icon = item.querySelector(".faq-icon") as HTMLElement;
      if (content) {
        content.style.maxHeight = open ? `${content.scrollHeight}px` : "0px";
        content.style.opacity = open ? "1" : "0";
      }
      if (icon) icon.style.transform = open ? "rotate(180deg)" : "rotate(0deg)";
    };

    // Event Delegation: One listener handles all clicks
    group.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest(".faq-trigger");
      if (!trigger) return;

      const currentItem = trigger.closest(".faq-item") as HTMLElement;
      const isCurrentlyOpen = currentItem.getAttribute("data-open") === "true";

      // Close all other open items
      group
        .querySelectorAll('.faq-item[data-open="true"]')
        .forEach((openItem) => {
          if (openItem !== currentItem)
            toggleFaq(openItem as HTMLElement, false);
        });

      // Toggle the clicked item
      toggleFaq(currentItem, !isCurrentlyOpen);
    });

    // Initialize items that are open by default (e.g. index 0)
    group
      .querySelectorAll('.faq-item[data-open="true"]')
      .forEach((item) => toggleFaq(item as HTMLElement, true));
  }

  initServiceFaq();
  document.addEventListener("astro:page-load", initServiceFaq);
</script>

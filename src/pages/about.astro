---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWhatsAppUrl } from "../utils/helpers";
import { cn } from "../utils/cn";
import SectionHeader from "../components/ui/SectionHeader.astro";
import HeroHeader from "../components/ui/HeroHeader.astro";
import {
  IconCar,
  IconPhoneCall,
  IconShieldCheck,
  IconMapPin,
  IconArrowRight,
  IconBrandWhatsapp,
  IconBuildingArch,
  IconClock,
} from "@tabler/icons-astro";
import { iconResolver } from "../utils/iconResolver";

// 1. Fetch Singleton Business Settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
  serviceArea:
    "Udaipur City, Maharana Pratap Airport (Dabok), & All Rajasthan Outstation Routes",
};

// 2. Fetch Singleton About Page Content
const aboutEntries = await getCollection("about").catch(() => []);
const aboutEntry = aboutEntries[0];

if (!aboutEntry) {
  throw new Error(
    "Missing src/content/about/about.md file. Please create it to render the About page.",
  );
}

const {
  title,
  subtitle,
  storyHeading,
  howWeWorkHeading,
  howWeWork = [],
  stats = [],
  coverageHeading,
  coverageSubtitle,
  coverageLocations = [],
} = aboutEntry.data;

// 3. Render Markdown Body Paragraphs (<Content />)
const { Content } = await render(aboutEntry);

// 4. Decap CMS String-to-JSX Icon Resolver
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "About Us / General Enquiry",
  Astro.url.href,
);
---

<BaseLayout
  title={`About Our Service | ${site.companyName}`}
  description={subtitle}
>
  {/* 1. HERO BANNER */}
  <section
    class="bg-brand-900 text-white py-12 border-b border-brand-800 relative overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <HeroHeader
        subheading="Our Identity & Approach"
        heading={title}
        description={subtitle}
      />
    </div>
  </section>

  {/* 2. OUR STORY & SERVICE APPROACH */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
      >
        {/* Left Column: Rendered Markdown Story */}
        <div class="lg:col-span-7 space-y-6">
          <h2
            class="font-serif text-3xl sm:text-4xl font-bold text-brand-900 leading-tight tracking-tight"
          >
            {storyHeading}
          </h2>

          <div
            class="prose md:prose-lg max-w-none prose-p:text-typography-muted prose-strong:text-brand-900 prose-p:leading-relaxed space-y-4"
          >
            <Content />
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-serif font-bold px-7 py-4 rounded-xl text-sm transition-all shadow-md hover:shadow-premium active:scale-95"
            >
              Send Travel Enquiry
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-7 py-4 rounded-xl text-sm transition-all shadow-md hover:shadow-premium flex items-center gap-2.5 active:scale-95"
            >
              <IconBrandWhatsapp size={18} stroke={2} />
              <span>Chat With Us</span>
            </a>
          </div>
        </div>

        {/* Right Column: Business Image & Verification Proof */}
        <div class="lg:col-span-5">
          <div
            class="bg-surface-card border-2 border-brand-100 rounded-2xl p-6 sm:p-8 shadow-premium relative"
          >
            <div
              class="aspect-w-16 aspect-h-12 bg-brand-900 rounded-xl overflow-hidden mb-6 flex items-center justify-center p-8 text-center text-white border border-brand-800"
            >
              <div>
                <div
                  class="w-12 h-12 rounded-full bg-brand-800 border border-brand-700 text-accent flex items-center justify-center mx-auto mb-3 shadow-inner"
                >
                  <IconBuildingArch size={24} stroke={1.5} />
                </div>
                <span class="font-serif text-lg font-bold block text-white"
                  >{site.companyName}</span
                >
                <span class="text-xs text-brand-100/70 block mt-0.5"
                  >Udaipur, Rajasthan, India</span
                >
              </div>
            </div>

            <div
              class="space-y-3.5 border-t border-brand-100 pt-6 text-xs text-typography-muted"
            >
              <div class="flex items-start gap-3">
                <IconMapPin
                  size={18}
                  stroke={2}
                  class="text-accent shrink-0 mt-0.5"
                />
                <div>
                  <strong class="text-brand-900 block font-semibold text-sm"
                    >Operating Base:</strong
                  >
                  <span>Udaipur City, Rajasthan 313001</span>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <IconClock
                  size={18}
                  stroke={2}
                  class="text-accent shrink-0 mt-0.5"
                />
                <div>
                  <strong class="text-brand-900 block font-semibold text-sm"
                    >Communication Hours:</strong
                  >
                  <span
                    >7 Days a Week — Quick Response via WhatsApp & Phone</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. HOW WE WORK */}
  <section class="py-12 bg-surface-alt/40 border-t border-brand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading="Operational Standards"
        heading={howWeWorkHeading}
        class="mb-12"
      />

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8"
      >
        {
          howWeWork.map((card) => {
            const IconComponent =
              iconResolver[card.icon] || iconResolver.IconShieldCheck;
            return (
              <div class="bg-surface-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group">
                <div>
                  <div class="w-12 h-12 rounded-xl bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0">
                    <IconComponent size={24} stroke={2} />
                  </div>
                  <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] transition-colors duration-300 mb-3">
                    {card.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-typography-muted leading-relaxed">
                    {card.desc}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* 4. STATS BANNER SECTION */}
  <section class="py-12 bg-surface border-y border-brand-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="bg-surface-alt border border-brand-100/80 rounded-3xl p-8 sm:p-12 shadow-sm"
      >
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 divide-y sm:divide-y-0 sm:divide-x divide-brand-100/80"
        >
          {
            stats.map((stat, idx) => (
              <div
                class={cn(
                  "text-center flex flex-col justify-center",
                  idx > 0 && "pt-6 sm:pt-0 sm:pl-8",
                )}
              >
                <span class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight block mb-1">
                  {stat.value}
                </span>
                <span class="text-xs sm:text-sm text-typography-muted font-medium leading-snug">
                  {stat.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* 5. WHERE WE OPERATE */}
  <section class="py-12 bg-brand-900 text-white border-y border-brand-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading="Regional Reach"
        heading={coverageHeading}
        description={coverageSubtitle}
        theme="dark"
        underline={false}
        class="mb-12"
      />

      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 sm:gap-6 max-w-7xl mx-auto"
      >
        {
          coverageLocations.map((location) => (
            <div class="flex items-center gap-3 p-2.5 bg-brand-800/40 rounded-xl hover:bg-brand-800 transition-all duration-300 group cursor-default border border-brand-700 hover:border-brand-600 hover:shadow-lg hover:shadow-brand-950/50">
              <div class="w-9 h-9 rounded-full bg-brand-900 border border-brand-700 flex items-center justify-center shrink-0 group-hover:bg-brand-900/80 transition-all duration-300">
                <IconMapPin
                  size={18}
                  stroke={1.5}
                  class="text-accent group-hover:text-white transition-colors duration-300"
                />
              </div>
              <span class="text-sm font-medium text-white/90 group-hover:text-white leading-tight transition-colors duration-300">
                {location}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6. EXPLORE OUR TRANSPORT ECOSYSTEM */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading="Next Steps & Resources"
        heading="Explore Our Transport Ecosystem"
        description="Verify our customer feedback, review available transport packages, or reach out directly to plan your Udaipur itinerary."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Card 1: Transport Catalogue */}
        <a
          href="/services/"
          class="bg-surface-card border border-border p-8 rounded-2xl shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0"
            >
              <IconCar size={24} stroke={2} />
            </div>
            <h3
              class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] transition-colors duration-300 mb-3"
            >
              Transport Catalogue
            </h3>
            <p
              class="text-xs sm:text-sm text-typography-muted leading-relaxed mb-8"
            >
              Browse our approved service categories, including airport
              transfers, local car hire with driver, and outstation Rajasthan
              tours.
            </p>
          </div>
          <div
            class="pt-4 border-t border-brand-100/80 text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] flex items-center justify-between transition-colors duration-300"
          >
            <span>View All Services</span>
            <IconArrowRight
              size={16}
              stroke={2}
              class="group-hover:translate-x-1 transition-transform text-accent"
            />
          </div>
        </a>

        {/* Card 2: Customer Reviews */}
        <a
          href="/reviews/"
          class="bg-surface-card border border-border p-8 rounded-2xl shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0"
            >
              <IconShieldCheck size={24} stroke={2} />
            </div>
            <h3
              class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] transition-colors duration-300 mb-3"
            >
              Customer Reviews
            </h3>
            <p
              class="text-xs sm:text-sm text-typography-muted leading-relaxed mb-8"
            >
              Read verified feedback from families, couples, and international
              tourists who have travelled across Udaipur and Rajasthan with our
              drivers.
            </p>
          </div>
          <div
            class="pt-4 border-t border-brand-100/80 text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] flex items-center justify-between transition-colors duration-300"
          >
            <span>Read Real Feedback</span>
            <IconArrowRight
              size={16}
              stroke={2}
              class="group-hover:translate-x-1 transition-transform text-accent"
            />
          </div>
        </a>

        {/* Card 3: Contact & Support */}
        <a
          href="/contact/"
          class="bg-surface-card border border-border p-8 rounded-2xl shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0"
            >
              <IconPhoneCall size={24} stroke={2} />
            </div>
            <h3
              class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] transition-colors duration-300 mb-3"
            >
              Contact & Support
            </h3>
            <p
              class="text-xs sm:text-sm text-typography-muted leading-relaxed mb-8"
            >
              Find our phone numbers, WhatsApp details, operating hours, and
              location information to get in touch with our team immediately.
            </p>
          </div>
          <div
            class="pt-4 border-t border-brand-100/80 text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-[var(--color-accent-dark,#8D671D)] flex items-center justify-between transition-colors duration-300"
          >
            <span>Get In Touch</span>
            <IconArrowRight
              size={16}
              stroke={2}
              class="group-hover:translate-x-1 transition-transform text-accent"
            />
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

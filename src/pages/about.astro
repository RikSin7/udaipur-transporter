---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWhatsAppUrl } from "../utils/helpers";
import SectionHeader from "../components/ui/SectionHeader.astro";
import PageHeroSection from "../components/sections/PageHeroSection.astro";
import {
  IconMapPin,
  IconArrowRight,
  IconBrandWhatsapp,
  IconBuildingArch,
  IconClock,
} from "@tabler/icons-astro";
import { iconResolver } from "../utils/iconResolver";
import { getEntry } from "astro:content";

// 1. Fetch Singleton Business Settings
const settingsEntry = await getEntry("settings", "site");
if (!settingsEntry) throw new Error("Missing site.md file");

const site = settingsEntry.data;

// 2. Fetch Singleton About Page Content
const aboutEntry = await getEntry("about", "about");
if (!aboutEntry) throw new Error("Missing about.md file");

const {
  seoTitle,
  seoDesc,
  title,
  subtitle,
  badge,
  storyBadge,
  storyHeading,
  storyEnquiryBtnText,
  storyWhatsappBtnText,
  image,
  heroImage,
  howWeWorkBadge,
  howWeWorkHeading,
  howWeWork = [],
  stats = [],
  coverageBadge,
  coverageHeading,
  coverageSubtitle,
  coverageLocations = [],
  ecosystemBadge,
  ecosystemHeading,
  ecosystemDescription,
  ecosystemCards = [],
} = aboutEntry.data;

// 3. Render Markdown Body Paragraphs (<Content />)
const { Content } = await render(aboutEntry);

// 4. Decap CMS String-to-JSX Icon Resolver
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "About Us / General Enquiry",
  Astro.url.href,
);
---

<BaseLayout
  title={seoTitle || `${title} | ${site.companyName}`}
  description={seoDesc || subtitle}
>
  {/* 1. HERO BANNER */}
  <PageHeroSection
    subheading={badge}
    heading={title}
    description={subtitle}
    heroImage={heroImage}
  />

  {/* 2. OUR STORY & SERVICE APPROACH */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
      >
        {/* Left Column: Rendered Markdown Story */}
        <div class="lg:col-span-7 space-y-6">
          <SectionHeader
            subheading={storyBadge || "Who We Are"}
            heading={storyHeading}
            class="mb-0"
          />

          <div
            class="prose md:prose-lg max-w-none prose-p:text-typography-muted prose-strong:text-brand-900 prose-p:leading-relaxed space-y-4"
          >
            <Content />
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="/contact/"
              class="bg-cta hover:bg-cta-hover text-white font-serif font-bold px-7 py-4 rounded-xl text-sm transition-all shadow-md hover:shadow-premium active:scale-95 uppercase"
            >
              {storyEnquiryBtnText || "Send Travel Enquiry"}
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-7 py-4 rounded-xl text-sm transition-all shadow-md hover:shadow-premium flex items-center gap-2.5 active:scale-95 uppercase"
            >
              <IconBrandWhatsapp size={18} stroke={2} />
              <span>{storyWhatsappBtnText || "Chat With Us"}</span>
            </a>
          </div>
        </div>

        {/* Right Column: Business Image & Verification Proof */}
        <div class="lg:col-span-5">
          <div
            class="bg-surface-card border-2 border-brand-100 rounded-2xl p-6 sm:p-8 shadow-premium relative group"
          >
            {
              image ? (
                <div class="w-full aspect-4/3 rounded-lg overflow-hidden mb-6 border border-brand-100 shadow-sm bg-surface-alt">
                  <Image
                    src={image}
                    alt={title || site.companyName}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              ) : (
                <div class="w-full aspect-4/3 bg-brand-900 rounded-lg overflow-hidden mb-6 flex items-center justify-center p-8 text-center text-white border border-brand-800">
                  <div>
                    <div class="w-12 h-12 rounded-full bg-brand-800 border border-brand-700 text-accent flex items-center justify-center mx-auto mb-3 shadow-inner group-hover:scale-110 transition-transform duration-500">
                      <IconBuildingArch size={24} stroke={1.5} />
                    </div>
                    <span class="font-serif text-lg font-bold block text-white">
                      {site.companyName}
                    </span>
                    <span class="text-xs text-brand-100/70 block mt-0.5">
                      {site.address}
                    </span>
                  </div>
                </div>
              )
            }

            <div
              class="space-y-2.5 border-t border-brand-100 pt-5 text-sm text-typography-muted"
            >
              <div class="flex items-start gap-2.5">
                <IconMapPin
                  size={16}
                  stroke={2}
                  class="text-accent shrink-0 mt-0.5"
                />
                <div class="leading-snug">
                  <strong class="text-brand-900 font-semibold"
                    >Operating Base:</strong
                  >
                  <span class="ml-1">{site.address}</span>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <IconClock
                  size={16}
                  stroke={2}
                  class="text-accent shrink-0 mt-0.5"
                />
                <div class="leading-snug">
                  <strong class="text-brand-900 font-semibold">Hours:</strong>
                  <span class="ml-1">{site.operatingHours}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. HOW WE WORK */}
  <section class="py-12 bg-surface-alt/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading={howWeWorkBadge || "Operational Standards"}
        heading={howWeWorkHeading}
        class="mb-12"
      />

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8"
      >
        {
          howWeWork.map((card) => {
            const IconComponent =
              iconResolver[card.icon] || iconResolver.IconShieldCheck;
            return (
              <div class="bg-surface-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group">
                <div>
                  <div class="w-12 h-12 rounded-xl bg-surface-alt text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0">
                    <IconComponent size={24} stroke={2} />
                  </div>
                  <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-900 group-hover:text-accent-dark transition-colors duration-300 mb-3">
                    {card.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-typography-muted leading-relaxed">
                    {card.desc}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* 4. STATS BANNER SECTION */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="bg-surface-alt border border-brand-100/80 rounded-2xl p-8 sm:p-12 shadow-sm"
      >
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6"
        >
          {
            stats.map((stat) => (
              <div class="text-center flex flex-col items-center justify-start">
                <span class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight block mb-2">
                  {stat.value}
                </span>
                <span class="text-xs sm:text-sm text-typography-muted font-medium leading-snug max-w-60 w-full h-10 line-clamp-2 text-balance">
                  {stat.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  {/* 5. WHERE WE OPERATE */}
  <section class="py-12 bg-brand-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading={coverageBadge || "Service Area"}
        heading={coverageHeading}
        description={coverageSubtitle}
        theme="dark"
        underline={false}
        class="mb-12"
      />

      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 sm:gap-6 max-w-7xl mx-auto"
      >
        {
          coverageLocations.map((location) => (
            <div class="flex items-center gap-3 p-2.5 bg-brand-800/40 rounded-xl hover:bg-brand-800 transition-all duration-300 group cursor-default border border-brand-700 hover:border-brand-600 hover:shadow-lg hover:shadow-brand-950/50">
              <div class="w-9 h-9 rounded-full bg-brand-900 border border-brand-700 flex items-center justify-center shrink-0 group-hover:bg-brand-900/80 transition-all duration-300">
                <IconMapPin
                  size={18}
                  stroke={1.5}
                  class="text-accent group-hover:text-white transition-colors duration-300"
                />
              </div>
              <span class="text-sm font-medium text-white/90 group-hover:text-white leading-tight transition-colors duration-300">
                {location}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6. EXPLORE OUR TRANSPORT ECOSYSTEM */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        subheading={ecosystemBadge || "Next Steps & Resources"}
        heading={ecosystemHeading || "Explore Our Transport Ecosystem"}
        description={ecosystemDescription ||
          "Verify our customer feedback, review available transport packages, or reach out directly to plan your Udaipur itinerary."}
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          ecosystemCards.map((card) => {
            const IconComponent =
              iconResolver[card.icon] || iconResolver.IconCar;
            return (
              <a
                href={card.link}
                class="bg-surface-card border border-border p-8 rounded-2xl shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 group flex flex-col justify-between"
              >
                <div>
                  <div class="w-12 h-12 rounded-xl bg-surface-alt text-brand-900 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform shadow-sm shrink-0">
                    <IconComponent size={24} stroke={2} />
                  </div>
                  <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-900 group-hover:text-accent-dark transition-colors duration-300 mb-3">
                    {card.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-typography-muted leading-relaxed mb-8">
                    {card.desc}
                  </p>
                </div>
                <div class="pt-4 border-t border-brand-100/80 text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-accent-dark flex items-center gap-2 transition-colors duration-300">
                  <span>{card.linkText}</span>
                  <IconArrowRight
                    size={16}
                    stroke={2}
                    class="group-hover:translate-x-1 transition-transform text-accent"
                  />
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

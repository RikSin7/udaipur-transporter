---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VehicleCard from "../../components/cards/VehicleCard.astro";
import { getCollection } from "astro:content";
import CatalogueSupportCTA from "../../components/sections/CatalogueSupportCTA.astro";
import FAQSection from "../../components/sections/FAQSection.astro";
import HeroHeader from "../../components/ui/HeroHeader.astro";
import { IconCar } from "@tabler/icons-astro";
import { sortPublishedByOrder } from "../../utils/helpers";

const settingsEntries = await getCollection("settings");
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
};

const allVehicles = await getCollection("vehicles");
const publishedVehicles = sortPublishedByOrder(allVehicles);
const hubEntries = await getCollection("vehicles_hub");
const hubData = hubEntries[0]?.data;
---

<BaseLayout
  title={hubData?.seoTitle || `Our Fleet | ${site.companyName}`}
  description={hubData?.seoDesc ||
    "Browse our fleet of private taxis, sedans, SUVs, and tempo travellers for comfortable travel in Udaipur and Rajasthan."}
>
  {/* 1. HERO BANNER */}
  <section
    class="bg-brand-900 text-white py-12 relative overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <HeroHeader
        subheading={hubData?.badge || "Premium Vehicle Fleet"}
        heading={hubData?.title || "Our Fleet"}
        description={hubData?.description ||
          "Choose from our wide range of well-maintained vehicles for your transportation needs in and around Udaipur. From comfortable sedans to spacious Tempo Travellers, we have the perfect vehicle for your group size and luggage requirements."}
      />
    </div>
  </section>

  {/* 2. VEHICLE LISTINGS */}
  <section class="py-12 bg-surface">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12"
    >
      {
        publishedVehicles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {publishedVehicles.map((vehicle) => (
              <VehicleCard vehicle={vehicle} />
            ))}
          </div>
        ) : (
          /* Empty State Fallback */
          <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
            <div class="w-12 h-12 rounded-xl bg-brand-900 text-accent flex items-center justify-center mx-auto mb-4">
              <IconCar size={24} stroke={2} />
            </div>
            <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
              No Vehicles Available
            </h3>
            <p class="text-sm text-typography-muted mb-6">
              We are currently updating our fleet inventory. Please check back
              soon or contact us directly to inquire about vehicle availability.
            </p>
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block uppercase"
            >
              Send General Inquiry
            </a>
          </div>
        )
      }
    </div>
  </section>

  <CatalogueSupportCTA type="vehicles" />
  <FAQSection />
</BaseLayout>

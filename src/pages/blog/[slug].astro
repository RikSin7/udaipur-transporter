---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceCard from "../../components/cards/ServiceCard.astro";
import BlogCard from "../../components/cards/BlogCard.astro";
import HeroHeader from "../../components/ui/HeroHeader.astro";
import { getWhatsAppUrl, formatDate } from "../../utils/helpers";
import {
  IconClock,
  IconCar,
  IconUser,
  IconCalendar,
  IconQuote,
  IconBrandWhatsapp,
  IconFileText,
} from "@tabler/icons-astro";

// 1. GENERATE STATIC PATHS FOR EVERY ARTICLE
export async function getStaticPaths() {
  const articles = await getCollection("blog");
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

// 2. EXTRACT ARTICLE DATA
const { entry } = Astro.props;
const { title, summary, publishDate, author, category, relatedService, image } =
  entry.data;

// 3. CONVERT MARKDOWN BODY INTO HTML
const { Content } = await render(entry);

// 4. CALCULATE ESTIMATED READING TIME
const wordCount = entry.body ? entry.body.trim().split(/\s+/).length : 500;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// 5. FETCH RELATED COMMERCIAL SERVICE
const allServices = await getCollection("services");
const matchingService = relatedService
  ? allServices.find(
      (s) => s.id === relatedService || s.data.title === relatedService,
    )
  : null;

// 6. FETCH RELATED ARTICLES
const allArticles = await getCollection("blog");
const relatedArticles = allArticles
  .filter((a) => a.id !== entry.id && a.data.published)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  )
  .slice(0, 3);

const formattedDate = formatDate(publishDate, "long");

// Fetch business settings for direct WhatsApp URLs
const settingsEntries = await getCollection("settings");
const site = settingsEntries[0]?.data || {
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
  companyName: "Udaipur Royal Transporter",
};
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  `Article Inquiry: ${title}`,
  Astro.url.href,
);

// Fetch Blog Details Page CTA Banner configuration
const blogCtaEntries = await getCollection("blog_cta");
const blogCta = blogCtaEntries[0]?.data || {
  badge: "Direct Expert Advice",
  title: "Plan your vehicle route with our local team.",
  description:
    "We provide owner-approved quotes without automated call centers or booking fees.",
};
---

<BaseLayout
  title={`${title} | ${site.companyName}`}
  description={summary}
  currentTitle={title}
>
  {/* 1. ARTICLE HERO HEADER */}
  <section
    class="bg-brand-900 text-white py-12 relative"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <HeroHeader subheading={category} heading={title} description={summary}>
        {/* Author, Date & Reading Time Metadata */}
        <div
          class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-brand-100/80 border-t border-brand-800/80 pt-6"
        >
          <div class="flex items-center gap-1.5">
            <IconUser size={16} stroke={2} class="text-accent shrink-0" />
            <span class="font-medium">{author}</span>
          </div>
          <div class="hidden sm:block h-4 w-px bg-brand-800"></div>
          <div class="flex items-center gap-1.5">
            <IconCalendar size={16} stroke={2} class="text-accent shrink-0" />
            <time datetime={publishDate} class="font-medium"
              >{formattedDate}</time
            >
          </div>
          <div class="hidden sm:block h-4 w-px bg-brand-800"></div>
          <div class="flex items-center gap-1.5">
            <IconClock size={16} stroke={2} class="text-accent shrink-0" />
            <span class="font-medium">{readingTime} min read</span>
          </div>
        </div>
      </HeroHeader>
    </div>
  </section>

  {/* 2. ARTICLE BODY & SIDEBAR FUNNEL */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        {/* Left Column: Markdown Content & Inline Banner */}
        <div class="lg:col-span-8 space-y-12">
          {/* NEW: Article Cover Image Banner */}
          {
            image && (
              <div class="rounded-2xl overflow-hidden border border-brand-100 shadow-sm bg-surface-alt">
                <Image
                  src={image}
                  alt={title}
                  width={900}
                  height={500}
                  format="webp"
                  quality={85}
                  class="w-full h-auto object-cover max-h-[440px]"
                />
              </div>
            )
          }

          {/* Renders prose from markdown file */}
          <div
            class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-10 shadow-sm"
          >
            <div
              class="prose md:prose-lg max-w-none prose-headings:font-serif prose-headings:text-brand-900 prose-p:text-typography-muted prose-p:leading-relaxed prose-li:text-typography-muted prose-strong:text-brand-900 prose-a:text-accent prose-blockquote:border-l-accent prose-blockquote:bg-surface-alt/50 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg"
            >
              <Content />
            </div>
          </div>

          {
            /* Inline Conversion Banner (Shown only when Recommended Service exists) */
          }
          {
            matchingService && (
              <div class="bg-brand-900 text-white p-6 sm:p-8 rounded-2xl shadow-premium flex flex-col md:flex-row md:items-center justify-between gap-6 sm:gap-8 border border-brand-800">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2.5 mb-3">
                    <div class="w-8 h-8 rounded-xl bg-brand-800 border border-brand-700 flex items-center justify-center text-accent shrink-0">
                      <IconFileText size={18} stroke={2} />
                    </div>
                    <span class="text-[11px] font-semibold uppercase tracking-wider text-accent bg-brand-800 px-3 py-1 rounded-full">
                      {blogCta.badge}
                    </span>
                  </div>
                  <h3 class="font-serif text-xl sm:text-2xl font-bold text-white">
                    {blogCta.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-brand-100/80 mt-1.5 leading-relaxed">
                    {blogCta.description}
                  </p>
                </div>
                <div class="flex flex-col sm:flex-row md:flex-col gap-3 sm:gap-4 w-full md:w-auto shrink-0">
                  <a
                    href="/contact/"
                    class="bg-cta hover:bg-cta-hover text-white font-bold px-6 py-3.5 rounded-xl shadow-md transition-all text-sm tracking-wider flex items-center justify-center gap-2 active:scale-95 text-center uppercase"
                  >
                    <IconQuote class="w-5 h-5 shrink-0" stroke={2} />
                    <span>Request Travel Quote</span>
                  </a>
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 bg-brand-800 hover:bg-emerald-600 text-white font-bold py-2.5 px-4 rounded-xl border border-brand-700 hover:border-emerald-500 text-xs sm:text-sm text-center transition-all flex items-center justify-center gap-1.5 active:scale-95 shadow-sm uppercase"
                  >
                    <IconBrandWhatsapp
                      class="w-5 h-5 text-emerald-400 shrink-0"
                      stroke={2}
                    />
                    <span>WhatsApp Us</span>
                  </a>
                </div>
              </div>
            )
          }
        </div>

        {/* Right Column */}
        <div class="lg:col-span-4 sticky top-28 self-start space-y-6">
          {
            /* Displays matching service IF specified, otherwise displays general consultation card */
          }
          {
            matchingService ? (
              <div>
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-900 mb-4">
                  <IconCar size={18} stroke={2} class="text-accent shrink-0" />
                  <span>Recommended Service</span>
                </div>
                <ServiceCard service={matchingService} />
              </div>
            ) : (
              <div class="bg-brand-900 border border-brand-800 p-6 sm:p-8 rounded-2xl text-white shadow-premium flex flex-col md:flex-row lg:flex-col justify-between md:items-center lg:items-stretch gap-6">
                <div class="flex-1 min-w-0">
                  <span class="text-xs font-bold uppercase tracking-widest text-accent block mb-1.5">
                    Custom Requirements?
                  </span>
                  <h4 class="font-serif text-lg sm:text-xl font-bold text-white mb-2">
                    Need a Custom Route Quote?
                  </h4>
                  <p class="text-xs sm:text-sm text-brand-100/80 leading-relaxed">
                    Send us your exact Udaipur or outstation itinerary. We'll
                    calculate toll actuals and suggest the right vehicle.
                  </p>
                </div>
                <div class="flex flex-col sm:flex-row md:flex-col gap-3 sm:gap-4 w-full md:w-auto lg:w-full xl:w-auto shrink-0">
                  <a
                    href="/contact/"
                    class="bg-cta hover:bg-cta-hover text-white font-bold py-3.5 px-6 rounded-xl text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 transition-all shadow-md active:scale-95 group text-center"
                  >
                    <span>Request Custom Quote</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1">
                      &rarr;
                    </span>
                  </a>
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-white/14 hover:bg-white/24 border border-white/50 text-white font-semibold py-3.5 px-6 rounded-xl text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-md active:scale-95 text-center"
                  >
                    <IconBrandWhatsapp
                      class="w-4 h-4 text-emerald-400 shrink-0"
                      stroke={2}
                    />
                    <span>WhatsApp Us</span>
                  </a>
                </div>
              </div>
            )
          }

          {/* Quick Fleet Reference Card */}
          <div
            class="bg-surface-card border border-brand-100 p-6 rounded-2xl shadow-sm text-center"
          >
            <h4 class="font-serif text-base font-bold text-brand-900 mb-2">
              Unsure Which Vehicle Fits?
            </h4>
            <p class="text-xs text-typography-muted leading-relaxed mb-4">
              View our complete fleet capacity matrix to check passenger limits
              and luggage space for all Sedans, SUVs, and Tempo Travellers.
            </p>
            <a
              href="/vehicles/"
              class="block group w-full bg-brand-900 hover:bg-brand-800 text-white font-bold py-3 rounded-xl text-xs uppercase tracking-wider transition-all"
            >
              Explore Vehicle Fleet <span
                class="inline-block group-hover:translate-x-1 transition-transform"
              >
                &rarr;</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. RELATED ARTICLES FOOTER */}
  {
    relatedArticles.length > 0 && (
      <section class="py-12 bg-surface-alt/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-left max-w-2xl mb-12">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 mb-2">
              More Transport Planning Guides
            </h2>
            <p class="text-sm text-typography-muted">
              Read additional tips to make your travel across Udaipur and
              Rajasthan comfortable and hassle-free.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedArticles.map((rel) => (
              <BlogCard article={rel} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import BlogCard from '../../components/cards/BlogCard.astro';
import { getWhatsAppUrl } from '../../utils/helpers';

const settingsEntries = await getCollection('settings').catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};

// Fetch and sort published articles by date newest to oldest
const allArticles = await getCollection('blog').catch(() => []);
const publishedArticles = allArticles
  .filter(a => a.data.published)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const whatsappUrl = getWhatsAppUrl(site.whatsapp, "Blog / Transport Planning", Astro.url.href);
---

<BaseLayout 
  title={`Transport Planning Guides | ${site.companyName}`}
  description="Practical advice, vehicle capacity guides, and local transport tips for planning a seamless private taxi journey across Udaipur and Rajasthan."
>
  <Header slot="header" />

  {/* 1. HERO BANNER */}
  <section class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4">
          Travel Planning Resources
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
          Rajasthan Transport Guides
        </h1>
        <p class="text-brand-100/90 text-lg font-light leading-relaxed">
          Practical advice on choosing vehicle categories, understanding private taxi tariffs, and coordinating seamless airport and railway station pickups in Udaipur.
        </p>
      </div>
    </div>
  </section>

  {/* 2. ARTICLES GRID */}
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {publishedArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {publishedArticles.map(article => (
            <BlogCard article={article} />
          ))}
        </div>
      ) : (
        <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
          <div class="text-3xl mb-3">📝</div>
          <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">No Guides Published Yet</h3>
          <p class="text-sm text-typography-muted mb-6">
            Our editorial team is currently drafting helpful transport planning guides. In the meantime, you can explore our vehicle fleet or send an inquiry directly.
          </p>
          <a href="/enquiry/" class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block">
            Send Travel Request
          </a>
        </div>
      )}

    </div>
  </section>

  {/* 3. CONVERSION BANNER */}
  <section class="py-16 bg-surface-alt border-t border-brand-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 mb-3">Ready to book your vehicle?</h2>
      <p class="text-sm text-typography-muted mb-8 max-w-xl mx-auto">
        Skip the guesswork. Share your travel dates and passenger count with our local team for a straightforward, owner-approved price quote.
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/services/" 
          class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm active:scale-95"
        >
          View Transport Services &rarr;
        </a>
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm flex items-center gap-2 active:scale-95"
        >
          <span>💬</span> Ask a Question on WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
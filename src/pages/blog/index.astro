---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import BlogCard from "../../components/cards/BlogCard.astro";
import { getWhatsAppUrl, formatDate } from "../../utils/helpers";
import { IconArrowRight, IconArrowLeft, IconBrandWhatsapp } from "@tabler/icons-astro";
import FAQSection from "../../components/sections/FAQSection.astro";

// 1. Fetch Singleton Business Settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};

const allArticles = await getCollection("blog").catch(() => []);
const publishedArticles = allArticles
  .filter((a) => a.data.published)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );

// 3. Separate Featured and Standard Articles
const featuredArticles = publishedArticles.filter((a) => a.data.featured);
// Fallback: If 0 articles are checked as featured in CMS, fall back to newest 1 article so layout doesn't break
const displayFeatured =
  featuredArticles.length > 0
    ? featuredArticles
    : publishedArticles.length > 0
      ? [publishedArticles[0]]
      : [];
const standardArticles = publishedArticles.filter(
  (a) => !displayFeatured.includes(a),
);

// 4. Define Category Filters
const categories = [
  "All",
  "Vehicle Guide",
  "Airport Transfers",
  "Pricing & Quotes",
  "Travel Tips",
];

const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "Blog / Transport Planning",
  Astro.url.href,
);
---

<BaseLayout
  title={`Transport Planning Guides | ${site.companyName}`}
  description="Practical advice, vehicle capacity guides, and local transport tips for planning a seamless private taxi journey across Udaipur and Rajasthan."
>
  <Header slot="header" />

  {/* 1. HERO BANNER */}
  <section
    class="bg-brand-900 text-white py-14 lg:py-20 border-b border-brand-800 relative overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span
          class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-4"
        >
          Travel Planning Resources
        </span>
        <h1
          class="font-serif text-4xl sm:text-5xl font-bold text-white tracking-wide leading-tight mb-4"
        >
          Udaipur travel
        </h1>
        <p class="text-brand-100/90 text-lg font-light leading-relaxed">
          Honest, useful advice on airport pickups, choosing a vehicle and what
          a private taxi price really includes.
        </p>
      </div>
    </div>
  </section>

  {/* 2. FLOATING CATEGORY TAB BAR */}
  <div
    class="sticky top-20 z-30 px-4 sm:px-6 lg:px-8 -mt-7 pointer-events-none"
  >
    <div
      class="max-w-4xl mx-auto bg-surface-card/95 backdrop-blur-md border border-brand-100 rounded-2xl p-2 sm:p-2.5 shadow-premium flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar pointer-events-auto"
    >
      {
        categories.map((cat, idx) => {
          const activeStyle =
            "bg-brand-900 text-white shadow-sm border-brand-900";
          const inactiveStyle =
            "bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 hover:border-brand-900 hover:text-[var(--color-accent-dark,#8D671D)] border-transparent";
          return (
            <button
              type="button"
              data-category={cat}
              class={`blog-filter-btn shrink-0 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border transition-all duration-200 cursor-pointer ${
                idx === 0 ? activeStyle : inactiveStyle
              }`}
            >
              {cat}
            </button>
          );
        })
      }
    </div>
  </div>

  {/* 3. ARTICLES CONTAINER */}
  <section class="pt-16 pb-16 lg:pt-20 lg:pb-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {
        publishedArticles.length > 0 ? (
          <>
            {/* FEATURED BLOG STACK */}
            {displayFeatured.length > 0 && (
              <div class="space-y-8" id="featured-articles-stack">
                {displayFeatured.map((article) => (
                  <div
                    data-article-category={article.data.category}
                    class="blog-item-wrapper"
                  >
                    <a
                      href={`/blog/${article.id}/`}
                      class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-10 shadow-sm hover:shadow-premium hover:border-brand-800 transition-all duration-300 block group"
                    >
                      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                        <div class="max-w-3xl">
                          <div class="flex items-center gap-2 mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-800 bg-emerald-50 border border-emerald-200/60 px-2.5 py-1 rounded-md">
                              Featured Guide
                            </span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-accent bg-brand-100 px-2.5 py-1 rounded-md">
                              {article.data.category}
                            </span>
                            <span class="text-xs text-typography-muted font-medium ml-2">
                              {formatDate(article.data.publishDate)}
                            </span>
                          </div>

                          <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-900 group-hover:text-accent transition-colors mb-3">
                            {article.data.title}
                          </h2>

                          <p class="text-sm sm:text-base text-typography-muted leading-relaxed line-clamp-3 mb-6">
                            {article.data.summary}
                          </p>

                          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-accent">
                            <span>Read full step-by-step guide</span>
                            <IconArrowRight
                              size={16}
                              stroke={2}
                              className="group-hover:translate-x-1 transition-transform"
                            />
                          </span>
                        </div>

                        {article.data.image && (
                          <div class="shrink-0 w-full lg:w-72 h-48 rounded-xl overflow-hidden bg-surface-alt border border-brand-100">
                            <Image
                              src={article.data.image}
                              alt={article.data.title}
                              width={400}
                              height={250}
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                          </div>
                        )}
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            )}

            {/* STANDARD ARTICLES GRID */}
            <div
              class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
              id="blog-grid"
            >
              {standardArticles.map((article) => (
                <div
                  data-article-category={article.data.category}
                  class="blog-item-wrapper flex"
                >
                  <BlogCard article={article} class="w-full" />
                </div>
              ))}
            </div>

            {/* NO ARTICLES IN SELECTED CATEGORY FALLBACK */}
            <div
              id="category-empty-state"
              class="hidden bg-surface-card border border-brand-100 rounded-2xl p-10 sm:p-14 text-center max-w-2xl mx-auto my-4 shadow-sm"
            >
              <div class="w-12 h-12 rounded-xl bg-brand-100/80 text-brand-900 flex items-center justify-center mx-auto mb-4 text-2xl">
                🗂️
              </div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-900 mb-2">
                No Guides Found in "<span id="empty-state-category-name" />"
              </h3>
              <p class="text-sm sm:text-base text-typography-muted mb-8 max-w-md mx-auto leading-relaxed">
                We haven't published any travel articles in this topic yet.
                Explore our other category tabs to read helpful transport guides
                for your trip.
              </p>
              <button
                type="button"
                id="reset-category-btn"
                class="group bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-flex items-center justify-center gap-2 shadow-sm active:scale-95 cursor-pointer"
              >
                <IconArrowLeft size={16} stroke={2} class="text-accent group-hover:-translate-x-1 transition-transform" />
                <span>View All Guides</span>
              </button>
            </div>
          </>
        ) : (
          <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
            <div class="text-3xl mb-3">📝</div>
            <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
              No Guides Published Yet
            </h3>
            <p class="text-sm text-typography-muted mb-6">
              Our editorial team is currently drafting helpful transport
              planning guides. In the meantime, you can explore our vehicle
              fleet or send an inquiry directly.
            </p>
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block shadow-sm"
            >
              Send Travel Request
            </a>
          </div>
        )
      }
    </div>
  </section>

  {/* 4. CONVERSION BANNER */}
  <section class="py-16 bg-surface-alt/70 border-t border-brand-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 mb-3">
        Ready to book your vehicle?
      </h2>
      <p class="text-sm text-typography-muted mb-8 max-w-xl mx-auto">
        Skip the guesswork. Share your travel dates and passenger count with our
        local team for a straightforward, owner-approved price quote.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/services/"
          class="group bg-brand-900 hover:bg-brand-800 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm inline-flex items-center gap-2 active:scale-95"
        >
          <span>View Transport Services</span>
          <IconArrowRight size={16} stroke={2} class="text-accent group-hover:translate-x-1 transition-transform" />
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm flex items-center gap-2 active:scale-95"
        >
          <IconBrandWhatsapp size={18} stroke={2} />
          <span>Ask a Question on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  {/* 5. IMPORTED FAQ SECTION */}
  <FAQSection />
</BaseLayout>

{/* Hide Scrollbar for Horizontal Mobile Tab Bar */}
<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  html {
    scroll-behavior: smooth;
  }
</style>

{/* Client-Side Category Filter Engine */}
<script>
  function initBlogFilter() {
    const filterBtns = document.querySelectorAll(".blog-filter-btn");
    const items = document.querySelectorAll(".blog-item-wrapper");
    const featuredStack = document.getElementById("featured-articles-stack");
    const blogGrid = document.getElementById("blog-grid");
    const emptyState = document.getElementById("category-empty-state");
    const emptyCatName = document.getElementById("empty-state-category-name");
    const resetBtn = document.getElementById("reset-category-btn");

    const activeClasses = [
      "bg-brand-900",
      "text-white",
      "shadow-sm",
      "border-brand-900",
    ];
    const inactiveClasses = [
      "bg-[var(--color-surface-alt,#E9EFEA)]",
      "text-brand-900",
      "hover:border-brand-900",
      "hover:text-[var(--color-accent-dark,#8D671D)]",
      "border-transparent",
    ];

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        const allBtn = document.querySelector(
          '.blog-filter-btn[data-category="All"]',
        ) as HTMLElement;
        if (allBtn) allBtn.click();
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Active state styling
        filterBtns.forEach((b) => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });
        btn.classList.remove(...inactiveClasses);
        btn.classList.add(...activeClasses);

        const selectedCategory = btn.getAttribute("data-category");
        let visibleFeatured = 0;
        let visibleStandard = 0;

        items.forEach((item) => {
          const itemCategory = item.getAttribute("data-article-category");
          const isMatch =
            selectedCategory === "All" || itemCategory === selectedCategory;
          if (isMatch) {
            (item as HTMLElement).style.display = "";
            if (featuredStack && featuredStack.contains(item)) {
              visibleFeatured++;
            } else {
              visibleStandard++;
            }
          } else {
            (item as HTMLElement).style.display = "none";
          }
        });

        if (featuredStack) {
          featuredStack.style.display = visibleFeatured > 0 ? "" : "none";
        }
        if (blogGrid) {
          blogGrid.style.display = visibleStandard > 0 ? "" : "none";
        }

        if (emptyState) {
          if (visibleFeatured + visibleStandard === 0) {
            emptyState.classList.remove("hidden");
            if (emptyCatName && selectedCategory) {
              emptyCatName.textContent = selectedCategory;
            }
          } else {
            emptyState.classList.add("hidden");
          }
        }
      });
    });
  }

  initBlogFilter();
  document.addEventListener("astro:page-load", initBlogFilter);
</script>

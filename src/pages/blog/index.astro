---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/cards/BlogCard.astro";
import { getWhatsAppUrl, formatDate } from "../../utils/helpers";
import {
  IconArrowRight,
  IconArrowLeft,
  IconBrandWhatsapp,
  IconCar,
} from "@tabler/icons-astro";
import FAQSection from "../../components/sections/FAQSection.astro";
import TabBar from "../../components/ui/TabBar.astro";
import HeroHeader from "../../components/ui/HeroHeader.astro";

// 1. Fetch Singleton Business Settings
const settingsEntries = await getCollection("settings");
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
};

// 2. Fetch and Sort Articles
const allArticles = await getCollection("blog");
const publishedArticles = allArticles
  .filter((a) => a.data.published)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  );

// 3. Separate Featured and Standard Articles
const featuredArticles = publishedArticles.filter((a) => a.data.featured);
const displayFeatured =
  featuredArticles.length > 0
    ? featuredArticles
    : publishedArticles.length > 0
      ? [publishedArticles[0]]
      : [];
const standardArticles = publishedArticles.filter(
  (a) => !displayFeatured.includes(a),
);

// 4. Define Category Filters
const categories = [
  "All",
  "Vehicle Guide",
  "Airport Transfers",
  "Pricing & Quotes",
  "Travel Tips",
];
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "Blog / Transport Planning",
  Astro.url.href,
);
const hubEntries = await getCollection("blog_hub");
const hubData = hubEntries[0]?.data;
---

<BaseLayout
  title={hubData?.seoTitle || `Transport Planning Guides | ${site.companyName}`}
  description={hubData?.seoDesc ||
    "Practical advice, vehicle capacity guides, and local transport tips for planning a seamless private taxi journey across Udaipur and Rajasthan."}
>
  {/* 1. HERO BANNER */}
  <section class="bg-brand-900 text-white py-12 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <HeroHeader
        subheading={hubData?.badge || "Travel Planning Resources"}
        heading={hubData?.title || "Udaipur Transport & Travel Blog"}
        description={hubData?.description ||
          "Honest, useful advice on airport pickups, choosing a vehicle and what a private taxi price really includes."}
      />
    </div>
  </section>

  {/* 2. FLOATING CATEGORY TAB BAR */}
  <TabBar
    mode="filter"
    tabClass="blog-filter-btn"
    tabs={categories.map((cat) => ({
      label: cat,
      category: cat,
    }))}
  />

  {/* 3. ARTICLES CONTAINER */}
  <section class="py-12 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {
        publishedArticles.length > 0 ? (
          <>
            {displayFeatured.length > 0 && (
              <div class="space-y-8" id="featured-articles-stack">
                {displayFeatured.map((article) => (
                  <div
                    data-article-category={article.data.category}
                    class="blog-item-wrapper"
                  >
                    <a
                      href={`/blog/${article.id}/`}
                      class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-10 shadow-sm hover:shadow-premium hover:border-brand-800 transition-all duration-300 block group"
                    >
                      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                        <div class="max-w-3xl">
                          <div class="flex items-center gap-2 mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-800 bg-emerald-50 border border-emerald-200/60 px-2.5 py-1 rounded-md">
                              Featured Guide
                            </span>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-accent-dark bg-brand-100/40 px-2.5 py-1 rounded-md">
                              {article.data.category}
                            </span>
                            <time
                              datetime={article.data.publishDate}
                              class="text-xs text-typography-muted font-medium ml-2"
                            >
                              {formatDate(article.data.publishDate)}
                            </time>
                          </div>
                          <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-900 group-hover:text-accent transition-colors mb-3">
                            {article.data.title}
                          </h2>
                          <p class="text-sm sm:text-base text-typography-muted leading-relaxed line-clamp-3 mb-6">
                            {article.data.summary}
                          </p>
                          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-accent">
                            <span>Read Guide</span>
                            <IconArrowRight
                              size={16}
                              stroke={2}
                              class="group-hover:translate-x-1 transition-transform text-accent"
                            />
                          </span>
                        </div>
                        {article.data.image ? (
                          <div class="shrink-0 w-full lg:w-72 h-48 rounded-xl overflow-hidden bg-surface-alt border border-brand-100">
                            <Image
                              src={article.data.image}
                              alt={article.data.title}
                              width={400}
                              height={250}
                              format="webp"
                              quality={85}
                              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                          </div>
                        ) : (
                          <div class="shrink-0 w-full lg:w-72 h-48 rounded-xl overflow-hidden bg-brand-900 border border-brand-100 flex items-center justify-center p-4 relative">
                            <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] [background-size:16px_16px] opacity-15" />
                            <div class="relative z-10 p-3 rounded-full bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
                              <IconCar class="w-6 h-6 stroke-[1.5]" />
                            </div>
                          </div>
                        )}
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            )}

            <div
              class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
              id="blog-grid"
            >
              {standardArticles.map((article) => (
                <div
                  data-article-category={article.data.category}
                  class="blog-item-wrapper flex"
                >
                  <BlogCard article={article} class="w-full" />
                </div>
              ))}
            </div>

            <div
              id="category-empty-state"
              class="hidden bg-surface-card border border-brand-100 rounded-2xl p-10 sm:p-14 text-center max-w-2xl mx-auto my-4 shadow-sm"
            >
              <div class="w-12 h-12 rounded-xl bg-brand-100/80 text-brand-900 flex items-center justify-center mx-auto mb-4 text-2xl">
                🗂️
              </div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-900 mb-2">
                No Guides Found in "<span id="empty-state-category-name" />"
              </h3>
              <p class="text-sm sm:text-base text-typography-muted mb-8 max-w-md mx-auto leading-relaxed">
                We haven't published any travel articles in this topic yet.
                Explore our other category tabs.
              </p>
              <button
                type="button"
                id="reset-category-btn"
                class="group bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-flex items-center justify-center gap-2 shadow-sm active:scale-95 cursor-pointer uppercase"
              >
                <IconArrowLeft
                  size={16}
                  stroke={2}
                  class="text-accent group-hover:-translate-x-1 transition-transform"
                />
                <span>View All Guides</span>
              </button>
            </div>
          </>
        ) : (
          <div class="bg-surface-alt border border-brand-100 rounded-2xl p-12 text-center max-w-2xl mx-auto">
            <div class="text-3xl mb-3">📝</div>
            <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
              No Guides Published Yet
            </h3>
            <p class="text-sm text-typography-muted mb-6">
              Our editorial team is currently drafting helpful transport
              planning guides.
            </p>
            <a
              href="/contact/"
              class="bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition-all inline-block shadow-sm uppercase"
            >
              Send Travel Request
            </a>
          </div>
        )
      }
    </div>
  </section>

  {/* 4. CONVERSION BANNER */}
  <section class="py-12 bg-surface-alt">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 mb-3">
        {hubData?.bannerHeading || "Ready to book your vehicle?"}
      </h2>
      <p class="text-sm text-typography-muted mb-8 max-w-xl mx-auto">
        {
          hubData?.bannerDesc ||
            "Skip the guesswork. Share your travel dates and passenger count for a straightforward, owner-approved price quote."
        }
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href={hubData?.bannerButtonUrl || "/services/"}
          class="group bg-brand-900 hover:bg-brand-800 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm inline-flex items-center gap-2 active:scale-95 uppercase"
        >
          <span>{hubData?.bannerButtonText || "View Transport Services"}</span>
          <IconArrowRight
            size={16}
            stroke={2}
            class="text-accent group-hover:translate-x-1 transition-transform"
          />
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-4 rounded-xl shadow-md transition-all text-sm flex items-center gap-2 active:scale-95 uppercase"
        >
          <IconBrandWhatsapp size={18} stroke={2} />
          <span
            >{hubData?.bannerWhatsappText || "Ask a Question on WhatsApp"}</span
          >
        </a>
      </div>
    </div>
  </section>

  <FAQSection />
</BaseLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  function initBlogFilter() {
    const filterBtns = document.querySelectorAll(".blog-filter-btn");
    const items = document.querySelectorAll(".blog-item-wrapper");
    const featuredStack = document.getElementById("featured-articles-stack");
    const blogGrid = document.getElementById("blog-grid");
    const emptyState = document.getElementById("category-empty-state");
    const emptyCatName = document.getElementById("empty-state-category-name");

    document
      .getElementById("reset-category-btn")
      ?.addEventListener("click", () => {
        (
          document.querySelector(
            '.blog-filter-btn[data-category="All"]',
          ) as HTMLElement
        )?.click();
      });

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        // State-Driven CSS Toggle
        filterBtns.forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");

        const selectedCategory = btn.getAttribute("data-category");
        let visibleFeatured = 0,
          visibleStandard = 0;

        items.forEach((item) => {
          const isMatch =
            selectedCategory === "All" ||
            item.getAttribute("data-article-category") === selectedCategory;
          (item as HTMLElement).style.display = isMatch ? "" : "none";
          if (isMatch)
            featuredStack?.contains(item)
              ? visibleFeatured++
              : visibleStandard++;
        });

        if (featuredStack)
          featuredStack.style.display = visibleFeatured > 0 ? "" : "none";
        if (blogGrid)
          blogGrid.style.display = visibleStandard > 0 ? "" : "none";

        if (emptyState) {
          const isEmpty = visibleFeatured + visibleStandard === 0;
          emptyState.classList.toggle("hidden", !isEmpty);
          if (isEmpty && emptyCatName)
            emptyCatName.textContent = selectedCategory;
        }
      });
    });
  }

  initBlogFilter();
  document.addEventListener("astro:page-load", initBlogFilter);
</script>

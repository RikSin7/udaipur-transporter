---
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import SEO from "../components/layout/SEO.astro";
import Breadcrumbs, {
  type BreadcrumbItem,
} from "../components/layout/Breadcrumbs.astro";
import { getEntry } from "astro:content";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  currentTitle?: string;
}

const site = await getEntry("settings", "site");

if (!site) throw new Error("Missing required content: settings/site.md");

const {
  title = site.data.seoDefaultTitle,
  description = site.data.seoDefaultDesc,
  image,
  type,
  noindex,
  breadcrumbs,
  currentTitle,
}: Props = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />
    <link rel="icon" href={`${site.data.favicon ?? "/favicon.svg"}?v=2`} />

    <meta name="generator" content={Astro.generator} />
    {
      /* 1. NETLIFY IDENTITY RECOVERY REDIRECTION: Redirect invite/recovery tokens directly to Decap CMS admin auth without loading identity widget on public pages */
    }
    <script is:inline>
      if (window.location.hash.includes("_token=")) {
        window.location.href = "/admin/" + window.location.hash;
      }
    </script>
  </head>
  <body
    class="bg-surface text-typography-main font-sans min-h-screen flex flex-col selection:bg-accent selection:text-white"
  >
    <Header />

    <main class="grow pb-16 md:pb-0">
      <Breadcrumbs items={breadcrumbs} currentTitle={currentTitle} />
      <slot />
    </main>

    <Footer />
  </body>
</html>

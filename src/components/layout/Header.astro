---
import { getCollection } from "astro:content";
import { getWhatsAppUrl, getCallUrl } from "../../utils/helpers";
import { IconBrandWhatsapp, IconPhoneCall } from "@tabler/icons-astro";

// Fetch singleton business settings
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
};

const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(site.whatsapp);

// Primary Navigation
const navLinks = [
  { label: "Services", href: "/services/" },
  { label: "Vehicles", href: "/vehicles/" },
  { label: "About", href: "/about/" },
  { label: "Blog", href: "/blog/" },
  { label: "Contact", href: "/contact/" },
];
---

<header
  class="bg-[rgba(251,247,239,0.95)] backdrop-blur-md text-typography-main sticky top-0 z-40 border-b border-border shadow-sm"
>
  {
    site.announcementBar?.enabled && site.announcementBar?.text && (
      <div class="bg-brand-900 text-brand-100 text-xs py-2 px-4 text-center border-b border-brand-800 flex items-center justify-center gap-2">
        <span class="font-medium">{site.announcementBar.text}</span>
        {site.announcementBar.link && (
          <a href={site.announcementBar.link} class="text-accent underline font-bold hover:text-white transition-colors shrink-0">
            Learn More &rarr;
          </a>
        )}
      </div>
    )
  }
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-between h-20">
      {/* 1. Brand Identity */}
      <a href="/" class="flex flex-col group focus:outline-none">
        <span
          class="font-serif text-md sm:text-xl font-bold text-brand-900 group-hover:text-accent-dark transition-colors"
        >
          {site.companyName}
        </span>
        <span
          class="text-[9px] sm:text-[10px] text-accent-dark uppercase tracking-[0.2em] font-sans font-medium opacity-90"
        >
          Private Taxi & Car Rental
        </span>
      </a>

      {/* 2. Primary Navigation (Desktop) */}
      <nav
        class="hidden lg:flex items-center space-x-8 text-sm font-medium tracking-wide"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="group relative text-typography-main hover:text-accent-dark transition-colors py-2"
            >
              {link.label}
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-accent-dark scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300 ease-out rounded-full" />
            </a>
          ))
        }
      </nav>

      {/* 3. Primary Actions (Desktop: Phone, WhatsApp, Enquiry CTA) */}
      <div class="hidden xl:flex items-center space-x-3.5">
        <a
          href={callUrl}
          class="text-sm font-semibold border border-brand-100 hover:border-brand-300 text-brand-900 rounded-xl px-3.5 py-2 bg-surface-card transition-all flex items-center gap-2 shadow-sm hover:shadow-md"
          aria-label="Call Business Phone"
        >
          <IconPhoneCall class="w-4.5 h-4.5 text-brand-900" stroke={2} />
          <span>{site.phone}</span>
        </a>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-emerald-700 bg-surface-card border border-brand-100 rounded-xl p-2.5 hover:border-emerald-700 transition-all shadow-sm hover:shadow-md flex items-center justify-center"
          aria-label="Chat on WhatsApp"
        >
          <IconBrandWhatsapp class="w-5 h-5 text-[#2F7A55]" stroke={2} />
        </a>

        <a
          href="/contact/?action=enquiry#enquiry-form-section"
          class="bg-[var(--color-cta,#AD5C1F)] hover:bg-[var(--color-cta-hover,#8E4416)] text-white font-bold px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-sm active:scale-95"
        >
          Send Enquiry
        </a>
      </div>

      {/* Medium Desktop / Tablet Fallback */}
      <div
        class="hidden md:flex xl:hidden items-center space-x-2.5 md:absolute md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 lg:static lg:translate-x-0 lg:translate-y-0"
      >
        <a
          href={callUrl}
          class="bg-surface-card border border-border-dark p-2.5 rounded-xl text-brand-900 hover:border-brand-900 transition-colors"
          title="Call Now"
        >
          <IconPhoneCall class="w-4 h-4 text-brand-900" stroke={2} />
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-surface-card border border-border-dark p-2.5 rounded-xl text-[#2F7A55] hover:border-[#2F7A55] transition-colors"
          title="WhatsApp"
        >
          <IconBrandWhatsapp class="w-4 h-4 text-[#2F7A55]" stroke={2} />
        </a>
        <a
          href="/contact/?action=enquiry#enquiry-form-section"
          class="bg-[var(--color-cta,#AD5C1F)] hover:bg-[var(--color-cta-hover,#8E4416)] text-white font-bold px-4 py-2 rounded-xl text-xs uppercase tracking-wider transition-colors"
        >
          Enquire
        </a>
      </div>

      {/* Mobile Controls */}
      <div class="flex items-center lg:hidden gap-2">
        <a
          href={callUrl}
          class="p-2 rounded-xl bg-surface-card border border-border-dark text-brand-900 hover:border-brand-900 transition-colors md:hidden"
          aria-label="Call Now"
        >
          <IconPhoneCall class="w-5 h-5 text-brand-900" stroke={2} />
        </a>
        <a
          href="/contact/?action=enquiry#enquiry-form-section"
          class="bg-[var(--color-cta,#AD5C1F)] text-white text-xs font-bold px-3.5 py-2 rounded-xl tracking-wider uppercase shadow-sm active:scale-95 transition-colors md:hidden"
        >
          Enquire
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="text-brand-900 p-2 rounded-xl bg-surface-card border border-border-dark hover:border-brand-900 focus:outline-none transition-colors"
          aria-label="Toggle Navigation Menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              id="menu-icon-open"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              id="menu-icon-close"
              class="hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Dropdown Menu */}
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-surface border-b border-border px-4 pt-4 pb-6 space-y-4 shadow-xl text-typography-main"
  >
    <nav class="flex flex-col space-y-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="block px-3 py-2.5 rounded-xl text-base font-medium text-typography-main hover:bg-brand-50 hover:text-accent hover:translate-x-1.5 transition-all duration-300"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="pt-3 border-t border-border grid grid-cols-2 gap-2.5">
      <a
        href={callUrl}
        class="py-2.5 bg-surface-card hover:bg-brand-50 rounded-xl text-sm font-semibold text-brand-900 transition-colors flex items-center justify-center gap-1.5 border border-border-dark"
      >
        <IconPhoneCall class="w-4 h-4 text-brand-900" stroke={2} /> Call Us
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="py-2.5 bg-[#2F7A55] hover:bg-emerald-700 rounded-xl text-sm font-semibold text-white transition-colors flex items-center justify-center gap-1.5 shadow-sm"
      >
        <IconBrandWhatsapp class="w-4 h-4 text-white" stroke={2} /> WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-icon-open");
    const closeIcon = document.getElementById("menu-icon-close");

    if (!btn || btn.dataset.init === "true") return;
    btn.dataset.init = "true";

    btn.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
      openIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    });
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>

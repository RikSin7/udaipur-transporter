---
import { getCollection } from 'astro:content';
import { getWhatsAppUrl } from '../../utils/helpers';

const settingsEntries = await getCollection('settings');
const site = settingsEntries[0]?.data || { phone: "+91 98765 43210", whatsapp: "919876543210" };

const callUrl = `tel:${site.phone.replace(/\s+/g, '')}`;
const whatsappUrl = getWhatsAppUrl(site.whatsapp);
---

<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-brand-900 border-t border-brand-800 shadow-2xl px-4 py-2.5 flex gap-3">
  <a 
    href={callUrl} 
    class="flex-1 bg-brand-800 text-white text-center py-2.5 px-3 rounded-lg font-medium text-sm flex items-center justify-center gap-2 active:scale-95 transition-transform"
  >
    <span>📞</span> Call Now
  </a>
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer"
    class="flex-1 bg-emerald-600 text-white text-center py-2.5 px-3 rounded-lg font-medium text-sm flex items-center justify-center gap-2 active:scale-95 transition-transform shadow-sm"
  >
    <span>💬</span> WhatsApp
  </a>
</div>
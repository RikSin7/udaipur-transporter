---
import { getCollection } from 'astro:content';
import { sortPublishedByOrder, getWhatsAppUrl } from '../../utils/helpers';

// 1. Fetch Singleton Settings
const settingsEntries = await getCollection('settings').catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
  email: "bookings@udaipurtransporter.com",
  operatingHours: "Typical Response Time: Under 15 Minutes",
  serviceArea: "Udaipur City, Maharana Pratap Airport (Dabok), & All Rajasthan Outstation Routes"
};

// 2. Query & Slice Top 5 Published Services by sortOrder
const allServices = await getCollection('services').catch(() => []);
const topServices = sortPublishedByOrder(allServices).slice(0, 5);

// 3. Query & Slice Top 5 Published Vehicles by sortOrder
const allVehicles = await getCollection('vehicles').catch(() => []);
const topVehicles = sortPublishedByOrder(allVehicles).slice(0, 5);

// 4. Check if a published blog exists
const allBlogs = await getCollection('blog').catch(() => []);
const publishedBlogs = allBlogs.filter((blog: any) => blog.data?.published !== false);
const hasPublishedBlog = publishedBlogs.length > 0;

const currentYear = new Date().getFullYear();
const callUrl = `tel:${site.phone.replace(/\s+/g, '')}`;
const whatsappUrl = getWhatsAppUrl(site.whatsapp);
---

<footer class="bg-brand-900 text-brand-100 font-sans border-t border-brand-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8">
      
      {/* GROUP 1: CONTACT (Span 4) — Phone, WhatsApp, email, service area, response hours */}
      <div class="lg:col-span-4 space-y-4">
        <h3 class="font-serif text-2xl font-bold text-white tracking-wide">{site.companyName}</h3>
        <p class="text-xs font-semibold uppercase tracking-widest text-accent bg-brand-800/60 inline-block px-2.5 py-1 rounded">
          {site.operatingHours}
        </p>
        <p class="text-sm text-brand-100/80 leading-relaxed">
          <span class="font-semibold text-white">Service Area:</span> {site.serviceArea}
        </p>
        
        <div class="pt-2 space-y-2 text-sm">
          <div class="flex items-center gap-2">
            <span class="text-accent">📞</span>
            <a href={callUrl} class="font-bold text-white hover:text-accent transition-colors">{site.phone}</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">💬</span>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp Direct Support</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-accent">✉️</span>
            <a href={`mailto:${site.email}`} class="hover:text-accent transition-colors break-all">{site.email}</a>
          </div>
        </div>
      </div>

      {/* GROUP 2: SERVICES (Span 3) — Auto Top 5 + Hub Link */}
      <div class="lg:col-span-3">
        <h4 class="font-serif text-lg font-semibold text-white mb-4 border-b border-brand-800 pb-2">
          Transport Services
        </h4>
        <ul class="space-y-2.5 text-sm">
          {topServices.length > 0 ? (
            topServices.map(service => (
              <li>
                <a href={`/services/${service.id}/`} class="hover:text-accent transition-colors block truncate">
                  {service.data.title}
                </a>
              </li>
            ))
          ) : (
            <li class="text-xs text-brand-100/50 italic">Services loading from CMS...</li>
          )}
          <li class="pt-2 border-t border-brand-800/60 mt-2">
            <a href="/services/" class="text-accent font-bold hover:underline inline-flex items-center gap-1 text-xs uppercase tracking-wider">
              Explore All Services &rarr;
            </a>
          </li>
        </ul>
      </div>

      {/* GROUP 3: VEHICLES (Span 3) — Auto Top 5 + Hub Link */}
      <div class="lg:col-span-3">
        <h4 class="font-serif text-lg font-semibold text-white mb-4 border-b border-brand-800 pb-2">
          Vehicle Fleet
        </h4>
        <ul class="space-y-2.5 text-sm">
          {topVehicles.length > 0 ? (
            topVehicles.map(vehicle => (
              <li>
                <a href={`/vehicles/${vehicle.id}/`} class="hover:text-accent transition-colors block truncate">
                  {vehicle.data.title}
                </a>
              </li>
            ))
          ) : (
            <li class="text-xs text-brand-100/50 italic">Vehicles loading from CMS...</li>
          )}
          <li class="pt-2 border-t border-brand-800/60 mt-2">
            <a href="/vehicles/" class="text-accent font-bold hover:underline inline-flex items-center gap-1 text-xs uppercase tracking-wider">
              View Fleet Capacity &rarr;
            </a>
          </li>
        </ul>
      </div>

      {/* GROUP 4: COMPANY, RESOURCES & POLICIES (Span 2) */}
      <div class="lg:col-span-2 space-y-6">
        {/* Company */}
        <div>
          <h4 class="font-serif text-base font-semibold text-white mb-3">Company</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/about/" class="hover:text-accent transition-colors">About Us</a></li>
            <li><a href="/reviews/" class="hover:text-accent transition-colors">Reviews</a></li>
            <li><a href="/contact/" class="hover:text-accent transition-colors">Contact</a></li>
          </ul>
        </div>

        {/* Resources (Conditional Blog Rule) */}
        <div>
          <h4 class="font-serif text-base font-semibold text-white mb-3">Resources</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/faqs/" class="hover:text-accent transition-colors">FAQs</a></li>
            {hasPublishedBlog && (
              <li><a href="/blog/" class="hover:text-accent transition-colors">Travel Blog</a></li>
            )}
          </ul>
        </div>

        {/* Policies */}
        <div>
          <h4 class="font-serif text-base font-semibold text-white mb-3">Policies</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/privacy/" class="hover:text-accent transition-colors">Privacy</a></li>
            <li><a href="/terms/" class="hover:text-accent transition-colors">Terms</a></li>
          </ul>
        </div>
      </div>

    </div>

    {/* System Bottom Bar */}
    <div class="mt-12 pt-8 border-t border-brand-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-brand-100/60">
      <p>&copy; {currentYear} {site.companyName}. All rights reserved. Straightforward Udaipur Transport.</p>
      <p class="italic">Prices and service availability subject to owner confirmation.</p>
    </div>
  </div>
</footer>
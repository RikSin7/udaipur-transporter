---
import { getCollection } from "astro:content";
import {
  getWhatsAppUrl,
  getCallUrl,
  sortPublishedByOrder,
} from "../../utils/helpers";
import {
  IconPhoneCall,
  IconBrandWhatsapp,
  IconMail,
  IconArrowRight,
  IconMapPin,
  IconClock,
  IconBrandInstagram,
  IconBrandFacebook,
  IconBrandTripadvisor,
} from "@tabler/icons-astro";
import { Image } from "astro:assets";
import { cn } from "../../utils/cn";

// 1. Fetch Singleton Settings
const settingsEntries = await getCollection("settings");
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
  email: "bookings@udaipurtransporter.com",
  operatingHours: "Typical Response Time: Under 15 Minutes",
  serviceArea:
    "Udaipur City, Maharana Pratap Airport (Dabok), & All Rajasthan Outstation Routes",
};

// 2. Query & Slice Top 5 Published Services by sortOrder
const allServices = await getCollection("services");
const topServices = sortPublishedByOrder(allServices).slice(0, 5);

// 3. Check if a published blog exists
const allBlogs = await getCollection("blog");
const hasPublishedBlog = allBlogs.some((blog) => blog.data?.published);

const currentYear = new Date().getFullYear();
const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(site.whatsapp);
---

<footer
  class="bg-brand-900 text-brand-100 font-sans border-t border-brand-800 relative overflow-hidden"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] bg-size-[24px_24px] opacity-5 pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8"
    >
      {/* GROUP 1: CONTACT */}
      <div class="lg:col-span-5 space-y-2.5">
        <div>
          <div class="flex items-center gap-3">
            {
              site.logo && (
                <Image
                  src={site.logo}
                  alt={site.companyName}
                  class="h-10 w-auto object-contain shrink-0"
                />
              )
            }
            <h3
              class={cn(
                "font-serif text-2xl font-bold text-white tracking-wide",
                site.logo && "hidden md:block",
              )}
            >
              {site.companyName}
            </h3>
          </div>

          <div
            class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-semibold tracking-widest text-accent bg-brand-800/80 border border-brand-700/60 px-3 py-1 rounded-md shadow-2xs"
          >
            <IconClock size={14} stroke={2} class="text-accent shrink-0" />
            <span>{site.operatingHours}</span>
          </div>
        </div>

        <p
          class="text-xs sm:text-sm text-brand-100/80 leading-relaxed flex items-start gap-2"
        >
          <IconMapPin
            size={18}
            stroke={2}
            class="text-accent shrink-0 mt-0.5"
          />
          <span>
            <strong class="font-semibold text-white block sm:inline"
              >Service Area:
            </strong>
            {site.serviceArea}
          </span>
        </p>

        <div class="pt-2.5 space-y-2.5 text-sm border-t border-brand-800/80">
          {/* Phone Action */}
          <div class="flex items-center gap-2.5">
            <div
              class="w-7 h-7 rounded-lg bg-brand-800 flex items-center justify-center shrink-0"
            >
              <IconPhoneCall size={16} stroke={2} class="text-accent" />
            </div>
            <a
              href={callUrl}
              class="font-bold text-white hover:text-accent transition-colors"
            >
              {site.phone}
            </a>
          </div>

          {/* WhatsApp Action */}
          <div class="flex items-center gap-2.5">
            <div
              class="w-7 h-7 rounded-lg bg-brand-800 border border-brand-700/60 flex items-center justify-center shrink-0"
            >
              <IconBrandWhatsapp size={16} stroke={2} class="text-accent" />
            </div>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-white hover:text-accent transition-all"
            >
              WhatsApp Support
            </a>
          </div>

          {/* Email Action */}
          <div class="flex items-center gap-2.5">
            <div
              class="w-7 h-7 rounded-lg bg-brand-800 flex items-center justify-center shrink-0"
            >
              <IconMail size={16} stroke={2} class="text-accent" />
            </div>
            <a
              href={`mailto:${site.email}`}
              class="text-white font-semibold hover:text-accent transition-colors break-all text-xs sm:text-sm"
            >
              {site.email}
            </a>
          </div>

          {
            site.socialLinks && (
              <div class="pt-2.5 flex items-center gap-2.5 border-t border-brand-800/80 mt-2.5">
                {site.socialLinks.instagram && (
                  <a
                    href={site.socialLinks.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-8 h-8 rounded-lg bg-brand-800 hover:bg-accent hover:text-brand-900 text-brand-100 flex items-center justify-center transition-all shadow-2xs"
                    aria-label="Instagram"
                  >
                    <IconBrandInstagram size={18} stroke={1.8} />
                  </a>
                )}
                {site.socialLinks.facebook && (
                  <a
                    href={site.socialLinks.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-8 h-8 rounded-lg bg-brand-800 hover:bg-accent hover:text-brand-900 text-brand-100 flex items-center justify-center transition-all shadow-2xs"
                    aria-label="Facebook"
                  >
                    <IconBrandFacebook size={18} stroke={1.8} />
                  </a>
                )}
                {site.socialLinks.tripadvisor && (
                  <a
                    href={site.socialLinks.tripadvisor}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-8 h-8 rounded-lg bg-brand-800 hover:bg-accent hover:text-brand-900 text-brand-100 flex items-center justify-center transition-all shadow-2xs"
                    aria-label="TripAdvisor"
                  >
                    <IconBrandTripadvisor size={18} stroke={1.8} />
                  </a>
                )}
                {site.socialLinks.googleMaps && (
                  <a
                    href={site.socialLinks.googleMaps}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-8 h-8 rounded-lg bg-brand-800 hover:bg-accent hover:text-brand-900 text-brand-100 flex items-center justify-center transition-all shadow-2xs"
                    aria-label="Google Maps"
                  >
                    <IconMapPin size={18} stroke={1.8} />
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>

      {/* GROUP 2: SERVICES */}
      <div class="lg:col-span-4">
        <h4
          class="font-serif text-sm font-bold tracking-wider text-white mb-2.5 border-b border-brand-800/80 pb-2.5"
        >
          Transport Services
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {
            topServices.length > 0 ? (
              topServices.map((service) => (
                <li>
                  <a
                    href={`/services/${service.id}/`}
                    class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block truncate"
                  >
                    {service.data.title}
                  </a>
                </li>
              ))
            ) : (
              <li class="text-xs text-brand-100/50 italic">
                Services loading from CMS...
              </li>
            )
          }

          <li class="pt-2.5 border-t border-brand-800/80 mt-2.5">
            <a
              href="/services/"
              class="group inline-flex items-center gap-1.5 text-accent font-bold text-xs tracking-wider hover:text-white transition-colors"
            >
              <span>Explore All Services</span>
              <IconArrowRight
                size={14}
                stroke={2.5}
                class="group-hover:translate-x-1 transition-transform"
              />
            </a>
          </li>
        </ul>
      </div>

      {/* GROUP 4: COMPANY, RESOURCES & POLICIES */}
      <div class="lg:col-span-3 space-y-6">
        {/* Company */}
        <div>
          <h4
            class="font-serif text-sm font-bold tracking-wider text-white mb-2.5 border-b border-brand-800/80 pb-2.5"
          >
            Company
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            <li>
              <a
                href="/about/"
                class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                >About Us</a
              >
            </li>
            <li>
              <a
                href="/reviews/"
                class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                >Reviews</a
              >
            </li>
            <li>
              <a
                href="/contact/"
                class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                >Contact</a
              >
            </li>
          </ul>
        </div>

        {/* Resources */}
        <div>
          <h4
            class="font-serif text-sm font-bold tracking-wider text-white mb-2.5 border-b border-brand-800/80 pb-2.5"
          >
            Resources
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            <li>
              <a
                href="/faqs/"
                class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                >FAQs</a
              >
            </li>
            {
              hasPublishedBlog && (
                <li>
                  <a
                    href="/blog/"
                    class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                  >
                    Travel Blog
                  </a>
                </li>
              )
            }
          </ul>
        </div>

        {/* Policies */}
        <div>
          <h4
            class="font-serif text-sm font-bold tracking-wider text-white mb-2.5 border-b border-brand-800/80 pb-2.5"
          >
            Policies
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            <li>
              <a
                href="/privacy/"
                class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                >Privacy Policy</a
              >
            </li>
            <li>
              <a
                href="/terms/"
                class="text-brand-100/80 hover:text-accent hover:pl-1 transition-all duration-200 block"
                >Terms of Service</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    {/* System Bottom Bar */}
    <div
      class="mt-14 pt-8 border-t border-brand-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-brand-100/60"
    >
      <p>
        &copy; {currentYear}
        {" "}
        {site.companyName}. All rights reserved. {
          site.footerTagline || "Straightforward Udaipur Transport."
        }
      </p>
      <p class="italic text-center sm:text-right">
        {
          site.footerDisclaimer ||
            "Prices and service availability subject to owner confirmation."
        }
      </p>
    </div>
  </div>
</footer>

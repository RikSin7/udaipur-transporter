---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import {
  IconCar,
  IconUsers,
  IconLuggage,
  IconPhoto,
  IconCheck,
  IconArrowRight,
} from "@tabler/icons-astro";
import { createCleanParam } from "../../utils/helpers";

interface Props {
  vehicle: CollectionEntry<"vehicles">;
}

const { vehicle }: Props = Astro.props;
const {
  title,
  passengers,
  seats,
  luggage,
  amenities,
  imageNote,
  summary,
  image,
} = vehicle.data;

const enquiryUrl = `/contact/?vehicle=${createCleanParam(title)}`;
---

<a
  href={enquiryUrl}
  class="bg-surface-card border border-border rounded-(--radius-card,18px) overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group cursor-pointer focus:outline-none"
>
  {/* 1. Image Row */}
  <div
    class="w-full h-44 sm:h-48 bg-brand-900 relative overflow-hidden border-b border-border/80 shrink-0"
  >
    {/* Overlaid Image Note Badge */}
    <div class="absolute top-3 sm:top-3.5 left-3 sm:left-3.5 z-20">
      <span
        class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-white bg-brand-950/85 backdrop-blur-md px-3 py-1 rounded-full border border-white/15 shadow-sm flex items-center gap-1.5"
      >
        <IconPhoto class="w-3.5 h-3.5 text-accent shrink-0" stroke={2} />
        {imageNote}
      </span>
    </div>

    {
      image ? (
        <Image
          src={image}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center p-4 relative">
          <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] bg-size-[16px_16px] opacity-15" />
          <div class="relative z-10 p-3 rounded-full bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
            <IconCar class="w-6 h-6 stroke-[1.5]" />
          </div>
        </div>
      )
    }
  </div>

  {/* 2. Content Area */}
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div class="mb-4">
      {/* Title */}
      <h3
        class="font-serif text-lg sm:text-xl font-bold text-brand group-hover:text-accent transition-colors line-clamp-2 mb-2.5"
      >
        {title}
      </h3>

      {/* Summary */}
      <p
        class="text-typography-muted text-xs sm:text-sm leading-relaxed line-clamp-2 mb-3"
      >
        {summary}
      </p>

      {/* Amenities */}
      <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
        {
          amenities.slice(0, 3).map((item) => (
            <span
              class="text-[10px] font-medium bg-surface-alt text-typography-muted px-2 py-0.5 rounded border border-border/80 max-w-32.5 hover:max-w-62.5 transition-[max-width] duration-300 ease-in-out flex items-center gap-1"
              title={item}
            >
              <IconCheck class="w-3 h-3 text-accent shrink-0" stroke={2.5} />
              <span class="truncate">{item}</span>
            </span>
          ))
        }
        {
          amenities.length > 3 && (
            <span
              class="text-[10px] font-bold bg-accent-light text-accent-dark px-1.5 py-0.5 rounded border border-accent/40"
              title={amenities.slice(3).join(", ")}
            >
              +{amenities.length - 3} more
            </span>
          )
        }
      </div>
    </div>

    {/* 3. Footer Action Bar */}
    <div
      class="pt-3.5 border-t border-border/70 flex flex-wrap items-center justify-between gap-2.5 mt-auto"
    >
      <div class="flex items-center">
        <span
          class="text-[11px] sm:text-xs font-bold px-2.5 py-1 rounded-md border bg-accent-light/30 border-accent/40 text-accent-dark font-sans tracking-wide shadow-sm flex flex-wrap items-center gap-1.5 sm:gap-2 leading-snug"
        >
          <span class="flex items-center gap-1">
            <IconUsers class="w-3.5 h-3.5 text-accent shrink-0" stroke={2} />
            {passengers} Pax{seats ? ` (${seats} Seats)` : ""}
          </span>
          <span class="text-accent/40">|</span>
          <span class="flex items-center gap-1">
            <IconLuggage class="w-3.5 h-3.5 text-accent shrink-0" stroke={2} />
            {luggage} Bags
          </span>
        </span>
      </div>
      <span
        class="bg-cta hover:bg-cta-hover text-white font-bold text-[11px] sm:text-xs tracking-wider py-2 px-4 rounded-(--radius-button,12px) transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-1.5 group/btn shrink-0 uppercase"
      >
        <span>Book Now</span>
        <IconArrowRight
          class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white/90 group-hover/btn:translate-x-0.5 transition-transform"
          stroke={2}
        />
      </span>
    </div>
  </div>
</a>

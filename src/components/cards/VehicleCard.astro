---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import {
  IconCar,
  IconUsers,
  IconLuggage,
  IconPhoto,
  IconCheck,
  IconArrowRight,
} from "@tabler/icons-astro";
import { createCleanParam } from "../../utils/helpers";

interface Props {
  vehicle: CollectionEntry<"vehicles">;
}

const { vehicle } = Astro.props;
const { title, passengers, luggage, amenities, imageNote, summary, image } =
  vehicle.data;

const enquiryUrl = `/contact/?vehicle=${createCleanParam(title)}`;
---

<div
  class="bg-surface-card border border-border rounded-[var(--radius-card,18px)] overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group"
>
  {/* 1. Top Image Row & Fallback Placeholder */}
  <a
    href={enquiryUrl}
    class="block w-full h-44 sm:h-48 bg-brand-900 relative overflow-hidden border-b border-border/80 shrink-0 group/img focus:outline-none"
  >
    {/* Overlaid Image Note Badge */}
    <span
      class="absolute top-3 right-3 z-20 bg-brand-950/85 backdrop-blur-md text-brand-100 text-[10px] font-semibold tracking-wider uppercase px-2.5 py-1 rounded border border-brand-700/80 shadow-sm flex items-center gap-1.5"
    >
      <IconPhoto class="w-4 h-4 text-accent shrink-0" stroke={2} />
      {imageNote}
    </span>

    {
      image ? (
        typeof image === "string" ? (
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        ) : (
          <Image
            src={image}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        )
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center p-4 relative">
          {/* Subtle Champagne Gold Pattern */}
          <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] [background-size:16px_16px] opacity-15" />
          <div class="relative z-10 p-3 rounded-full bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
            <IconCar class="w-7 h-7 stroke-[1.5]" />
          </div>
          <span class="relative z-10 text-[11px] font-semibold uppercase tracking-[0.15em] text-brand-200 mt-2">
            {title}
          </span>
        </div>
      )
    }
  </a>

  {/* 2. Content & Specifications Area */}
  <div class="p-5 flex-1 flex flex-col justify-between gap-3">
    <div>
      {/* Title */}
      <a href={enquiryUrl} class="block focus:outline-none">
        <h3
          class="font-serif text-lg font-bold text-brand group-hover:text-accent hover:text-accent transition-colors line-clamp-1 mb-1.5"
        >
          {title}
        </h3>
      </a>

      {/* Inline Capacity Specs (Champagne Gold Accent) */}
      <div
        class="flex items-center gap-3 text-xs font-semibold text-accent-dark pb-2 mb-2 border-b border-border/60"
      >
        <span class="flex items-center gap-1.5">
          <IconUsers class="w-4 h-4 text-accent shrink-0" stroke={2} /> Max {
            passengers
          } Seats
        </span>
        <span class="text-border/80">|</span>
        <span class="flex items-center gap-1.5">
          <IconLuggage class="w-4 h-4 text-accent shrink-0" stroke={2} />
          {luggage} Bags
        </span>
      </div>

      {/* Ellipsized Summary */}
      <p
        class="text-typography-muted text-xs sm:text-sm leading-relaxed line-clamp-2 mb-3"
      >
        {summary}
      </p>
    </div>

    {/* Compact Amenities */}
    <div class="flex flex-wrap items-center gap-1.5 pt-1">
      {
        amenities
          .slice(0, 3)
          .map((item) => (
            <span class="text-[10px] font-medium bg-surface-alt text-typography-muted px-2 py-0.5 rounded border border-border/80 truncate max-w-[130px] flex items-center gap-1">
              <IconCheck class="w-3 h-3 text-accent shrink-0" stroke={2.5} /> {item}
            </span>
          ))
      }
      {
        amenities.length > 3 && (
          <span
            class="text-[10px] font-bold bg-accent-light text-accent-dark px-1.5 py-0.5 rounded border border-accent/40"
            title={amenities.slice(3).join(", ")}
          >
            +{amenities.length - 3} more
          </span>
        )
      }
    </div>
  </div>

  {/* 3. Sleek Action Footer */}
  <div
    class="px-5 py-3.5 bg-surface-alt/40 border-t border-border/70 flex items-center justify-between gap-3"
  >
    <span
      class="text-[11px] font-semibold text-typography-muted uppercase tracking-wider"
    >
      Udaipur Fleet
    </span>
    <a
      href={enquiryUrl}
      class="bg-brand hover:bg-brand-800 text-white font-bold text-xs uppercase tracking-wider py-2 px-4 rounded-[var(--radius-button,12px)] transition-colors shadow-sm active:scale-95 flex items-center gap-1 group"
    >
      <span>Book Now</span>
      <span class="text-accent group-hover:translate-x-0.5 transition-transform flex items-center">
        <IconArrowRight class="w-4 h-4" stroke={2} />
      </span>
    </a>
  </div>
</div>

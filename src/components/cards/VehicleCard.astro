---
import type { CollectionEntry } from 'astro:content';

interface Props {
  vehicle: CollectionEntry<'vehicles'>;
}

const { vehicle } = Astro.props;
const { title, passengers, luggage, amenities, imageNote, summary } = vehicle.data;

// Generate pre-filled enquiry URL
const enquiryUrl = `/enquiry/?vehicle=${encodeURIComponent(title)}`;
---

<div class="bg-surface-card border border-brand-100 rounded-xl overflow-hidden shadow-sm hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
  
  <div class="p-6">
    {/* Actual/Representative Image Note */}
    <div class="flex justify-between items-start mb-3">
      <span class="text-[11px] font-semibold text-brand-900 bg-brand-100/80 border border-brand-100 px-2.5 py-1 rounded">
        📷 {imageNote}
      </span>
    </div>

    {/* Title is now plain text since there is no detail page */}
    <h3 class="font-serif text-xl font-bold text-brand-900 mb-2">
      {title}
    </h3>
    
    <p class="text-typography-muted text-sm mb-6 leading-relaxed">
      {summary}
    </p>

    {/* Capacity Guidance Specs */}
    <div class="grid grid-cols-2 gap-2 py-3 border-y border-brand-100/80 mb-4 bg-surface-alt/40 rounded-lg px-3 text-xs font-semibold text-brand-900">
      <div class="flex items-center gap-1.5">
        <span>👥</span> Max {passengers} Passengers
      </div>
      <div class="flex items-center gap-1.5">
        <span>🧳</span> Up to {luggage} Bags
      </div>
    </div>

    {/* Key Amenities */}
    <div class="flex flex-wrap gap-1.5 mb-2">
      {amenities.map(item => (
        <span class="text-[11px] font-medium bg-surface-alt text-typography-muted px-2.5 py-1 rounded-md border border-brand-100/60">
          ✓ {item}
        </span>
      ))}
    </div>
  </div>

  {/* Single Prominent CTA Button directing straight to /enquiry/ */}
  <div class="p-6 pt-0">
    <a 
      href={enquiryUrl} 
      class="w-full bg-brand-900 hover:bg-brand-800 text-white font-bold text-xs uppercase tracking-wider py-3.5 px-4 rounded-xl transition-all shadow-sm hover:shadow flex items-center justify-center gap-2 active:scale-95 group"
    >
      <span>Request This Vehicle</span>
      <span class="text-accent group-hover:translate-x-1 transition-transform">&rarr;</span>
    </a>
  </div>

</div>
---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { IconCar, IconArrowRight } from "@tabler/icons-astro";
import { createCleanParam } from "../../utils/helpers";

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
const { title, summary, pricing, image, gallery = [], category } = service.data;

// 1. Evaluate Primary Image for Card Thumbnail:
const primaryGalleryItem = gallery.find((item: any) => item?.isPrimary);
const cardImage = primaryGalleryItem?.url || image || gallery[0]?.url || null;

// 2. Evaluate Approved Price Status
const amount = pricing?.amount;
const shortLabel = pricing?.shortLabel;
const hasApprovedPrice = !!amount;

// 3. Format the display label (e.g., "₹899 onwards, per trip" or "From ₹2,000 / Day")
const priceDisplay = hasApprovedPrice
  ? `${amount} ${shortLabel || ""}`.trim()
  : shortLabel || "Ask for Price";
---

<div
  class="bg-surface-card border border-border rounded-[var(--radius-card,18px)] overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group"
>
  {/* 1. Image / Fallback Placeholder Row */}
  <a
    href={`/services/${service.id}/`}
    class="block w-full h-44 sm:h-48 bg-brand-900 relative overflow-hidden border-b border-border/80 shrink-0"
  >
    {
      cardImage ? (
        <Image
          src={cardImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center p-4 relative">
          {/* Delicate Champagne Gold Dotted Pattern */}
          <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] [background-size:16px_16px] opacity-15" />
          <div class="relative z-10 p-3 rounded-full bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
            <IconCar class="w-6 h-6 stroke-[1.5]" />
          </div>
          <span class="relative z-10 text-[11px] font-semibold uppercase tracking-[0.15em] text-brand-200 mt-2">
            {category}
          </span>
        </div>
      )
    }
  </a>

  {/* 2. Text Content Area */}
  <div class="p-5 flex-1 flex flex-col justify-between gap-4">
    <div>
      {/* Category & Price Row */}
      <div class="flex items-center justify-between gap-2 mb-3">
        <span
          class="text-[11px] font-semibold uppercase tracking-wider text-accent-dark bg-brand-100/40 px-3 py-1 rounded-full"
        >
          {category}
        </span>
        {
          hasApprovedPrice && (
            <span class="text-xs font-bold px-2.5 py-1 rounded-md border bg-accent-light border-accent/40 text-accent-dark font-sans tracking-wide shadow-[0_1px_2px_rgba(0,0,0,0.03)] truncate max-w-[55%]">
              {priceDisplay}
            </span>
          )
        }
      </div>

      {/* Title with Ellipsized Clamping */}
      <h3
        class="font-serif text-lg sm:text-xl font-bold text-brand group-hover:text-accent transition-colors line-clamp-2 mb-2"
      >
        <a href={`/services/${service.id}/`}>{title}</a>
      </h3>

      {/* Summary with Ellipsis */}
      <p
        class="text-typography-muted text-xs sm:text-sm leading-relaxed line-clamp-3"
      >
        {summary}
      </p>
    </div>
  </div>

  {/* 3. Sleek Action Footer */}
  <div
    class="px-5 py-3.5 bg-surface-alt/40 border-t border-border/70 flex items-center justify-between gap-3"
  >
    <a
      href={`/services/${service.id}/`}
      class="text-[11px] font-semibold text-typography-muted hover:text-brand uppercase tracking-wider transition-colors py-1 flex items-center gap-1"
    >
      <span>Service Details</span>
      <IconArrowRight class="w-3.5 h-3.5" stroke={2} />
    </a>
    <a
      href={`/contact/?service=${createCleanParam(title)}`}
      class="bg-brand hover:bg-brand-800 text-white font-bold text-xs uppercase tracking-wider py-2 px-4 rounded-[var(--radius-button,12px)] transition-colors shadow-sm active:scale-95 flex items-center gap-1 group shrink-0"
    >
      <span>{hasApprovedPrice ? "Enquire" : "Ask for Price"}</span>
      <span
        class="text-accent group-hover:translate-x-0.5 transition-transform flex items-center"
      >
        <IconArrowRight class="w-4 h-4" stroke={2} />
      </span>
    </a>
  </div>
</div>

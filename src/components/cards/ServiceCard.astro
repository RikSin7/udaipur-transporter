---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { IconCar, IconArrowRight } from "@tabler/icons-astro";
import { createCleanParam } from "../../utils/helpers";

interface Props {
  service: CollectionEntry<"services">;
}

const { service }: Props = Astro.props;
const { title, summary, pricing, image, gallery = [], category } = service.data;

// 1. Evaluate Primary Image for Card Thumbnail:
const primaryGalleryItem = gallery.find((item: any) => item?.isPrimary);
const cardImage = primaryGalleryItem?.url || image || gallery[0]?.url || null;

// 2. Evaluate Approved Price Status
const amount = pricing?.amount;
const shortLabel = pricing?.shortLabel;
const hasApprovedPrice = !!amount;

const priceDisplay = hasApprovedPrice
  ? `${amount} ${shortLabel || ""}`.trim()
  : null;
---

<div
  class="bg-surface-card border border-border rounded-[var(--radius-card,18px)] overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group relative cursor-pointer"
>
  {/* Stretched card link for entire card body */}
  <a
    href={`/services/${service.id}/`}
    class="absolute inset-0 z-10"
    aria-label={`View details for ${title}`}></a>

  {/* 1. Image Row */}
  <div
    class="w-full h-44 sm:h-48 bg-brand-900 relative overflow-hidden border-b border-border/80 shrink-0"
  >
    {/* Category Badge Overlay */}
    <div class="absolute top-3 sm:top-3.5 left-3 sm:left-3.5 z-20">
      <span
        class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-white bg-brand-950/85 backdrop-blur-md px-3 py-1 rounded-full border border-white/15 shadow-sm"
      >
        {category}
      </span>
    </div>

    {
      cardImage ? (
        <Image
          src={cardImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center p-4 relative">
          <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] [background-size:16px_16px] opacity-15" />
          <div class="relative z-10 p-3 rounded-full bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
            <IconCar class="w-6 h-6 stroke-[1.5]" />
          </div>
        </div>
      )
    }
  </div>

  {/* 2. Content Area */}
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div class="mb-4">
      <h3
        class="font-serif text-lg sm:text-xl font-bold text-brand group-hover:text-accent transition-colors line-clamp-2 mb-2.5"
      >
        {title}
      </h3>
      <p
        class="text-typography-muted text-xs sm:text-sm leading-relaxed line-clamp-3"
      >
        {summary}
      </p>
    </div>

    {/* 3. Footer Action Bar */}
    <div
      class="pt-3.5 border-t border-border/70 flex flex-wrap items-center justify-between gap-2.5 mt-auto"
    >
      {
        hasApprovedPrice && (
          <div class="flex items-center">
            <span class="text-[11px] sm:text-xs font-bold px-2 py-1 rounded-md border bg-accent-light/30 border-accent/40 text-accent-dark font-sans tracking-wide shadow-sm leading-snug">
              {priceDisplay}
            </span>
          </div>
        )
      }
      <a
        href={`/contact/?service=${createCleanParam(title)}`}
        class="bg-cta hover:bg-cta-hover text-white font-bold text-[11px] sm:text-xs tracking-wider py-2 px-4 rounded-[var(--radius-button,12px)] transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-1.5 group/btn shrink-0 relative z-20 ml-auto"
      >
        <span>{hasApprovedPrice ? "Enquire" : "Ask for Price"}</span>
        <IconArrowRight
          class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white/90 group-hover/btn:translate-x-0.5 transition-transform"
          stroke={2}
        />
      </a>
    </div>
  </div>
</div>

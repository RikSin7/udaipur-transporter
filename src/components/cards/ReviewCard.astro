---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import {
  IconStarFilled,
  IconQuote,
  IconMapPin,
  IconShieldCheck,
  IconCar,
} from "@tabler/icons-astro";
import { cn } from "../../utils/cn";

export interface Props {
  review: CollectionEntry<"reviews">;
  variant?: "carousel" | "grid";
  class?: string;
}

const { review, variant = "grid", class: className = "" }: Props = Astro.props;
const item = review.data;
const ratingCount = item.rating || 5;
---

<article
  class={cn(
    variant === "carousel" &&
      "snap-start shrink-0 w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]",
    "bg-surface-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group",
    className,
  )}
>
  <div>
    {/* Star Rating & Quote Icon Header */}
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-1 text-accent">
        {
          [...Array(Math.max(1, Math.min(5, Math.floor(ratingCount))))].map(
            () => <IconStarFilled size={16} />,
          )
        }
      </div>
      <div class="text-brand-300 group-hover:text-brand-900 transition-colors">
        <IconQuote size={28} stroke={1.5} />
      </div>
    </div>

    {/* Review Comment */}
    <p
      class={cn(
        "text-typography-muted text-sm sm:text-base leading-relaxed italic mb-8",
        variant === "carousel" && "line-clamp-5 sm:line-clamp-4",
      )}
    >
      "{item.comment}"
    </p>
  </div>

  {/* Author & Trip Metadata Footer */}
  <div class="border-t border-border/80 pt-4 mt-auto">
    <div class="flex items-start justify-between gap-3">
      {/* Left Side: Avatar/Initials + Author Name */}
      <div class="flex items-center gap-3 min-w-0">
        {
          item.image ? (
            <Image
              src={item.image}
              alt={item.author}
              width={88}
              height={88}
              loading="lazy"
              class="w-11 h-11 rounded-full object-cover border border-brand-100 shrink-0 shadow-sm bg-surface-alt"
            />
          ) : (
            <div class="w-11 h-11 rounded-full bg-brand-900 text-accent font-serif font-bold text-base flex items-center justify-center shrink-0 shadow-sm border border-brand-800">
              {item.author ? item.author.charAt(0) : "U"}
            </div>
          )
        }

        <div class="min-w-0">
          <h3
            class="font-serif font-bold text-accent-dark text-base leading-snug truncate group-hover:text-accent-dark transition-colors duration-300"
          >
            {item.author}
          </h3>
          {
            item.location && (
              <span class="text-[11px] text-typography-muted flex items-center gap-1 mt-0.5">
                <IconMapPin size={13} stroke={2} class="text-accent shrink-0" />
                <span class="truncate">{item.location}</span>
              </span>
            )
          }
        </div>
      </div>

      {/* Right Side: Verified Badge */}
      {
        (item.verified || item.verified === undefined) && (
          <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2 py-1 rounded-md shrink-0 flex items-center gap-1 self-start mt-0.5 shadow-2xs">
            <IconShieldCheck
              size={13}
              stroke={2}
              class="text-emerald-600 shrink-0"
            />
            <span class="hidden sm:inline">Verified</span>
          </span>
        )
      }
    </div>

    {/* Service Tag & Date */}
    {
      item.service && (
        <div class="mt-3 pt-2 border-t border-border/40 text-[11px] font-medium text-brand-900/80 flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 truncate">
            <IconCar size={14} stroke={2} class="text-accent shrink-0" />
            <span class="truncate">{item.service}</span>
          </div>
          {item.date && (
            <span class="text-typography-muted shrink-0 font-normal">
              {item.date}
            </span>
          )}
        </div>
      )
    }
  </div>
</article>

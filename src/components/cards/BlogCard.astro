---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { IconCar } from "@tabler/icons-astro";
import { formatDate } from "../../utils/helpers";
import { cn } from "../../utils/cn";

interface Props {
  article: CollectionEntry<"blog">;
  class?: string;
}

const { article, class: className = "" } = Astro.props;
const { title, summary, publishDate, category, image } = article.data;

const formattedDate = formatDate(publishDate);
---

<article
  class={cn(
    "bg-surface-card border border-brand-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-premium hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group h-full",
    className,
  )}
>
  {/* 1. TOP IMAGE OR BRANDED FALLBACK ROW */}
  <a
    href={`/blog/${article.id}/`}
    class="block w-full h-48 sm:h-52 bg-brand-900 relative overflow-hidden border-b border-brand-100/80 shrink-0"
  >
    {
      image ? (
        <Image
          src={image}
          alt={title}
          width={600}
          height={340}
          format="webp"
          quality={85}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        />
      ) : (
        /* Fallback UI */
        <div class="w-full h-full flex flex-col items-center justify-center p-4 relative">
          <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] [background-size:16px_16px] opacity-15" />
          <div class="relative z-10 p-3 rounded-xl bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
            <IconCar class="w-6 h-6 stroke-[1.5]" />
          </div>
          <span class="relative z-10 text-[10px] font-semibold uppercase tracking-[0.15em] text-brand-100/70 mt-2.5">
            {category}
          </span>
        </div>
      )
    }
  </a>

  {/* 2. TEXT CONTENT AREA */}
  <div class="p-6 flex-1 flex flex-col justify-between gap-4">
    <div>
      {/* Category Pill & Date */}
      <div class="flex items-center justify-between gap-2 mb-3.5 text-xs">
        <span
          class="text-[11px] font-semibold uppercase tracking-wider text-accent-dark bg-brand-100/40 px-3 py-1 rounded-full"
        >
          {category}
        </span>
        <time
          datetime={publishDate}
          class="text-typography-muted text-xs font-medium"
        >
          {formattedDate}
        </time>
      </div>

      {/* Title */}
      <h3
        class="font-serif text-lg sm:text-xl font-bold text-brand-900 group-hover:text-accent transition-colors mb-3 leading-snug line-clamp-2"
      >
        <a href={`/blog/${article.id}/`}>{title}</a>
      </h3>

      {/* Summary */}
      <p
        class="text-typography-muted text-xs sm:text-sm leading-relaxed line-clamp-3"
      >
        {summary}
      </p>
    </div>
  </div>

  {/* 3. SLEEK ACTION FOOTER */}
  <div
    class="px-6 py-4 bg-surface-alt/50 border-t border-brand-100/60 flex items-center justify-between mt-auto"
  >
    <a
      href={`/blog/${article.id}/`}
      class="text-xs font-bold uppercase tracking-wider text-brand-900 group-hover:text-accent transition-colors flex items-center gap-1.5 w-full justify-between"
    >
      <span>Read Guide</span>
      <span class="text-accent group-hover:translate-x-1 transition-transform"
        >&rarr;</span
      >
    </a>
  </div>
</article>

---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { IconCar, IconArrowRight } from "@tabler/icons-astro";
import { formatDate } from "../../utils/helpers";
import { cn } from "../../utils/cn";

interface Props {
  article: CollectionEntry<"blog">;
  class?: string;
}

const { article, class: className = "" }: Props = Astro.props;
const { title, summary, publishDate, category, image } = article.data;

const formattedDate = formatDate(publishDate);
---

<a
  href={`/blog/${article.id}/`}
  aria-label={`Read guide: ${title}`}
  class={cn(
    "bg-surface-card border border-border rounded-(--radius-card,18px) overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group cursor-pointer focus:outline-none",
    className,
  )}
>
  {/* 1. Image Row */}
  <div
    class="w-full h-44 sm:h-48 bg-brand-900 relative overflow-hidden border-b border-border/80 shrink-0"
  >
    {/* Category Badge Overlay */}
    <div class="absolute top-3 sm:top-3.5 left-3 sm:left-3.5 z-20">
      <span
        class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-white bg-brand-950/85 backdrop-blur-md px-3 py-1 rounded-full border border-white/15 shadow-sm"
      >
        {category}
      </span>
    </div>

    {
      image ? (
        <Image
          src={image}
          alt={title}
          width={600}
          height={340}
          format="webp"
          quality={85}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center p-4 relative">
          <div class="absolute inset-0 bg-[radial-gradient(#BFA06A_1px,transparent_1px)] bg-size-[16px_16px] opacity-15" />
          <div class="relative z-10 p-3 rounded-full bg-brand-800/90 border border-brand-700 text-accent shadow-inner group-hover:scale-105 transition-transform duration-300">
            <IconCar class="w-6 h-6 stroke-[1.5]" />
          </div>
        </div>
      )
    }
  </div>

  {/* 2. Content Area */}
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div class="mb-4">
      {/* Title */}
      <h3
        class="font-serif text-lg sm:text-xl font-bold text-brand group-hover:text-accent transition-colors line-clamp-2 mb-2.5"
      >
        {title}
      </h3>

      {/* Summary */}
      <p
        class="text-typography-muted text-xs sm:text-sm leading-relaxed line-clamp-3"
      >
        {summary}
      </p>
    </div>

    {/* 3. Footer Action Bar */}
    <div
      class="pt-3.5 border-t border-border/70 flex flex-wrap items-center justify-between gap-2.5 mt-auto"
    >
      <div class="flex items-center">
        <time
          datetime={publishDate}
          class="text-[11px] sm:text-xs font-semibold text-typography-muted leading-snug"
        >
          {formattedDate}
        </time>
      </div>
      <span
        class="group/btn inline-flex items-center gap-2 text-xs font-bold tracking-wider text-brand-900 group-hover:text-accent uppercase"
      >
        <span>Read Guide</span>
        <IconArrowRight
          class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-900 group-hover:text-accent transition-transform group-hover/btn:translate-x-0.5"
          stroke={2}
        />
      </span>
    </div>
  </div>
</a>

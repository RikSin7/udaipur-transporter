---
import { getCollection } from "astro:content";
import { IconArrowRight, IconBolt, IconChevronDown } from "@tabler/icons-astro";
import { cn } from "../../utils/cn";

// Fetch Published Services to Populate Dropdown Server-Side
const allServices = await getCollection("services");
const publishedServices = allServices.filter((s) => s.data.published);

const inputBaseClasses =
  "w-full px-3.5 py-3 rounded-xl border border-brand-100 focus:ring-2 focus:ring-[var(--color-cta,#AD5C1F)] focus:border-[var(--color-cta,#AD5C1F)] outline-none text-sm bg-surface transition-all font-medium text-brand-900";
---

<div
  class="bg-surface-card border border-brand-100/80 rounded-2xl p-6 sm:p-7 shadow-2xl text-brand-900 relative z-10 w-full"
>
  {/* Form Header */}
  <div class="border-b border-brand-100 pb-4 mb-5">
    <span
      class="text-[11px] font-bold uppercase tracking-widest text-[var(--color-cta,#AD5C1F)] block mb-1"
    >
      Instant Booking Estimate
    </span>
    <h3
      class="font-serif text-2xl font-bold text-brand-900 tracking-tight leading-snug"
    >
      Quick Travel Enquiry
    </h3>
    <p class="text-xs text-typography-muted mt-1 leading-relaxed">
      Provide your primary itinerary details to calculate exact tariff rates.
    </p>
  </div>

  <form id="hero-compact-form" action="/contact" method="GET" class="space-y-4">
    <input type="hidden" name="enquiry" value="true" />
    <input type="hidden" name="source" value="hero-compact" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Name - Half width on sm+ */}
      <div>
        <label
          for="hero-name"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="hero-name"
          name="name"
          required
          placeholder="Hrithik Roshan"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>

      {/* Phone */}
      <div>
        <label
          for="hero-phone"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Mobile <span class="text-red-500">*</span>
        </label>
        <input
          type="tel"
          id="hero-phone"
          name="phone"
          required
          placeholder="+91 70458 36164"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Service - Half width on sm+ */}
      <div>
        <label
          for="hero-service"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Required Service</span>
        </label>
        <div class="relative">
          <select
            id="hero-service"
            name="service"
            class={cn(
              inputBaseClasses,
              "appearance-none cursor-pointer font-medium pr-10",
            )}
          >
            <option value="">General Enquiry</option>
            {
              publishedServices.map((s) => (
                <option value={s.data.title}>{s.data.title}</option>
              ))
            }
          </select>
          <IconChevronDown
            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-brand-900/50 pointer-events-none"
            size={18}
          />
        </div>
      </div>

      {/* Travel Date - Half width on sm+ */}
      <div>
        <label
          for="hero-travelDate"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Travel Date
        </label>
        <input
          type="date"
          id="hero-travelDate"
          name="travelDate"
          min={new Date().toISOString().split("T")[0]}
          class={cn(inputBaseClasses, "text-brand-900")}
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Pickup Location - Half width on sm+ */}
      <div>
        <label
          for="hero-pickup"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Pickup Location
        </label>
        <input
          type="text"
          id="hero-pickup"
          name="pickup"
          placeholder="Airport"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>

      {/* Drop Location - Half width on sm+ */}
      <div>
        <label
          for="hero-drop"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Drop Location
        </label>
        <input
          type="text"
          id="hero-drop"
          name="drop"
          placeholder="Hotel"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>
    </div>

    <div class="pt-2">
      <button
        type="submit"
        aria-label="Continue to fill the travel enquiry form with pre-filled details"
        class="group w-full bg-[var(--color-cta,#AD5C1F)] hover:bg-[var(--color-cta-hover,#8E4416)] text-white font-serif font-bold py-3.5 px-6 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 text-sm tracking-wide flex items-center justify-center gap-2 active:scale-95 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-cta,#AD5C1F)] focus-visible:ring-offset-2 focus-visible:ring-offset-surface uppercase"
      >
        <span>Continue to Get Quote</span>
        <IconArrowRight
          size={18}
          stroke={2}
          class="text-white transition-transform duration-300 ease-out group-hover:translate-x-1 shrink-0"
        />
      </button>
      <p
        class="text-[11px] text-center text-typography-muted mt-2.5 font-medium flex items-center justify-center gap-1.5"
      >
        <IconBolt size={14} stroke={2} class="text-amber-500 shrink-0" />
        <span>Redirects to our full form with your details pre-filled.</span>
      </p>
    </div>
  </form>
</div>

<script>
  function initHeroCompactForm() {
    const form = document.getElementById(
      "hero-compact-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const params = new URLSearchParams();

      formData.forEach((value, key) => {
        if (typeof value === "string" && value.trim() !== "") {
          params.append(key, value.trim());
        }
      });

      // Navigate to contact page with URL params and hash to auto-scroll directly to the enquiry form section
      window.location.href = `/contact?${params.toString()}#enquiry-form-section`;
    });
  }

  // Execute immediately when browser loads HTML
  initHeroCompactForm();

  // Execute on Astro View Transition SPA navigation
  document.addEventListener("astro:page-load", initHeroCompactForm);
</script>

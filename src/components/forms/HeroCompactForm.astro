---
import { getCollection } from "astro:content";
import { IconArrowRight, IconBolt, IconChevronDown } from "@tabler/icons-astro";
import { cn } from "../../utils/cn";
import { sortPublishedByOrder } from "../../utils/helpers";

// Fetch Published Services & Sort by Order to Populate Dropdown Server-Side
const allServices = await getCollection("services");
const publishedServices = sortPublishedByOrder(allServices);

const inputBaseClasses =
  "w-full min-w-0 max-w-full block box-border px-3.5 py-3 rounded-xl border border-brand-100 focus:ring-2 focus:ring-[var(--color-cta,#AD5C1F)] focus:border-[var(--color-cta,#AD5C1F)] outline-none text-sm bg-surface transition-all font-medium text-brand-900";
---

<div
  class="bg-surface-card border border-brand-100/80 rounded-2xl p-6 sm:p-7 shadow-2xl text-brand-900 relative z-10 w-full"
>
  {/* Form Header */}
  <div class="border-b border-brand-100 pb-4 mb-5">
    <span
      class="text-[11px] font-bold uppercase tracking-widest text-cta block mb-1"
    >
      Instant Booking Estimate
    </span>
    <h3
      class="font-serif text-2xl font-bold text-brand-900 tracking-tight leading-snug"
    >
      Quick Travel Enquiry
    </h3>
    <p class="text-xs text-typography-muted mt-1 leading-relaxed">
      Provide your primary itinerary details to calculate exact tariff rates.
    </p>
  </div>

  <form
    name="hero-quick-enquiry"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/thank-you/"
    class="space-y-4"
  >
    <input type="hidden" name="form-name" value="hero-quick-enquiry" />
    <input type="hidden" name="source" value="hero-compact" />
    <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Name - Half width on sm+ */}
      <div>
        <label
          for="hero-name"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="hero-name"
          name="name"
          required
          minlength="2"
          maxlength="60"
          autocomplete="name"
          autocapitalize="words"
          placeholder="Hrithik Roshan"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>

      {/* Phone */}
      <div>
        <label
          for="hero-phone"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Mobile <span class="text-red-500">*</span>
        </label>
        <input
          type="tel"
          id="hero-phone"
          name="phone"
          inputmode="tel"
          autocomplete="tel"
          required
          minlength="10"
          maxlength="15"
          pattern="[\+\-0-9\s\(\)]{10,15}"
          title="Please enter a valid phone number"
          placeholder="+91 70458 36164"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Service - Half width on sm+ */}
      <div>
        <label
          for="hero-service"
          class="text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Required Service</span>
        </label>
        <div class="relative">
          <select
            id="hero-service"
            name="service"
            class={cn(
              inputBaseClasses,
              "appearance-none cursor-pointer font-medium pr-10",
            )}
          >
            <option value="">General Enquiry</option>
            {
              publishedServices.map((s) => (
                <option value={s.data.title}>{s.data.title}</option>
              ))
            }
          </select>
          <IconChevronDown
            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-brand-900/50 pointer-events-none"
            size={18}
          />
        </div>
      </div>

      {/* Travel Date - Half width on sm+ */}
      <div class="min-w-0">
        <label
          for="hero-travelDate"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Travel Date
        </label>
        <input
          type="date"
          id="hero-travelDate"
          name="travelDate"
          class={cn(
            inputBaseClasses,
            "text-brand-900 appearance-none min-w-0 max-w-full block",
          )}
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Pickup Location - Half width on sm+ */}
      <div>
        <label
          for="hero-pickup"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Pickup Location <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="hero-pickup"
          name="pickup"
          required
          minlength="2"
          maxlength="100"
          autocomplete="off"
          placeholder="Airport"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>

      {/* Drop Location - Half width on sm+ */}
      <div>
        <label
          for="hero-drop"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Drop Location <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="hero-drop"
          name="drop"
          required
          minlength="2"
          maxlength="100"
          autocomplete="off"
          placeholder="Hotel"
          class={cn(
            inputBaseClasses,
            "placeholder:text-shadow-typography-muted font-normal",
          )}
        />
      </div>
    </div>

    <div class="pt-2">
      <button
        type="submit"
        aria-label="Submit quick travel enquiry for an instant quote"
        class="group w-full bg-cta hover:bg-cta-hover text-white font-serif font-bold py-3.5 px-6 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 text-sm tracking-wide flex items-center justify-center gap-2 active:scale-95 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-cta focus-visible:ring-offset-2 focus-visible:ring-offset-surface uppercase"
      >
        <span>Get Your Quote</span>
        <IconArrowRight
          size={18}
          stroke={2}
          class="text-white transition-transform duration-300 ease-out group-hover:translate-x-1 shrink-0"
        />
      </button>
      <p
        class="text-[11px] text-center text-typography-muted mt-2.5 font-medium flex items-center justify-center gap-1.5"
      >
        <IconBolt size={14} stroke={2} class="text-amber-500 shrink-0" />
        <span>Direct local enquiry. We will contact you promptly.</span>
      </p>
    </div>
  </form>
</div>

<style>
  /* Native browser validation styles triggered only after user interaction */
  input:user-invalid,
  select:user-invalid {
    border-color: #ef4444 !important;
    background-color: #fef2f2 !important;
  }
  input:user-valid:not(:focus):not([type="date"]):not([type="number"]) {
    border-color: #10b981 !important;
  }
</style>

<script>
  function initHeroForm() {
    const dateInput = document.getElementById(
      "hero-travelDate",
    ) as HTMLInputElement;
    if (dateInput) {
      dateInput.min = new Date().toISOString().split("T")[0];
    }
  }

  initHeroForm();
  document.addEventListener("astro:page-load", initHeroForm);
</script>

---
import { getCollection } from "astro:content";
import { IconSend, IconMinus, IconPlus } from "@tabler/icons-astro";
import { cn } from "../../utils/cn";

interface Props {
  defaultService?: string;
  defaultVehicle?: string;
  priceLabel?: string;
}

const {
  defaultService = "",
  defaultVehicle = "",
  priceLabel = "",
} = Astro.props;
const currentUrl = Astro.url.pathname;

// Fetch Published Collections
const [allServices, allVehicles] = await Promise.all([
  getCollection("services").catch(() => []),
  getCollection("vehicles").catch(() => []),
]);
const publishedServices = allServices.filter((s) => s.data.published);
const publishedVehicles = allVehicles.filter((v) => v.data.published !== false);

const inputBaseClasses =
  "w-full px-4 py-3.5 rounded-xl border border-brand-100 focus:ring-2 focus:ring-[var(--color-cta,#AD5C1F)] focus:border-[var(--color-cta,#AD5C1F)] outline-none text-sm bg-surface transition-all placeholder:text-shadow-typography-muted";

// Array map to prevent HTML repetition for counters
const passengerCounters = [
  {
    id: "adults",
    label: "Adults",
    sub: "",
    min: 1,
    val: 2,
    span: "col-span-1 md:col-span-4",
  },
  {
    id: "children",
    label: "Children",
    sub: "(Under 12)",
    min: 0,
    val: 0,
    span: "col-span-1 md:col-span-4",
  },
  {
    id: "bags",
    label: "Luggage Bags",
    sub: "(Large Suitcases)",
    min: 0,
    val: 0,
    span: "col-span-2 md:col-span-4",
  },
];
---

<form
  name="travel-enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/thank-you/"
  class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-10 shadow-premium space-y-8 text-brand-900"
>
  {/* Hidden Config */}
  <input type="hidden" name="form-name" value="travel-enquiry" />
  <input type="hidden" name="sourcePage" value={currentUrl} />
  <input type="hidden" id="priceLabel" name="priceLabel" value={priceLabel} />
  <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>

  {/* Section 1: Contact */}
  <div class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <div class="md:col-span-6">
        <label for="name" class="block text-xs font-bold uppercase mb-1.5"
          >Name <span class="text-red-500">*</span></label
        >
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Hrithik Roshan"
          class={inputBaseClasses}
        />
      </div>
      <div class="md:col-span-6">
        <label for="phone" class="block text-xs font-bold uppercase mb-1.5"
          >Mobile <span class="text-red-500">*</span></label
        >
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          placeholder="+91 70458 36164"
          class={inputBaseClasses}
        />
      </div>
    </div>
  </div>

  {/* Section 2: Service & Vehicle */}
  <div class="space-y-4 pt-2">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <div class="md:col-span-6">
        <label
          for="service"
          class="flex justify-between text-xs font-bold uppercase mb-1.5"
          ><span>Required Service</span>
          <span class="font-normal text-[11px]">(Optional)</span></label
        >
        <select
          id="service"
          name="service"
          class={cn(inputBaseClasses, "font-medium cursor-pointer")}
        >
          <option value="General Enquiry">General Enquiry</option>
          {
            publishedServices.map((s) => (
              <option
                value={s.data.title}
                selected={defaultService === s.data.title}
              >
                {s.data.title}
              </option>
            ))
          }
        </select>
      </div>
      <div class="md:col-span-6">
        <label
          for="vehicle"
          class="flex justify-between text-xs font-bold uppercase mb-1.5"
          ><span>Vehicle Preference</span>
          <span class="font-normal text-[11px]">(Optional)</span></label
        >
        <select
          id="vehicle"
          name="vehicle"
          class={cn(inputBaseClasses, "font-medium cursor-pointer")}
        >
          <option value="General Recommendation">Recommend a Vehicle</option>
          {
            publishedVehicles.map((v) => (
              <option
                value={v.data.title}
                selected={defaultVehicle === v.data.title}
              >
                {v.data.title} ({v.data.passengers} Max)
              </option>
            ))
          }
        </select>
      </div>
    </div>
  </div>

  {/* Section 3: Schedule */}
  <div class="space-y-4 pt-2">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <div class="md:col-span-4">
        <label for="pickup" class="block text-xs font-bold uppercase mb-1.5"
          >Pickup Location <span class="text-red-500">*</span></label
        >
        <input
          type="text"
          id="pickup"
          name="pickup"
          required
          placeholder="Airport"
          class={inputBaseClasses}
        />
      </div>
      <div class="md:col-span-4">
        <label for="drop" class="block text-xs font-bold uppercase mb-1.5"
          >Drop Location <span class="text-red-500">*</span></label
        >
        <input
          type="text"
          id="drop"
          name="drop"
          required
          placeholder="Hotel"
          class={inputBaseClasses}
        />
      </div>
      <div class="md:col-span-4">
        <label
          for="travelDate"
          class="flex justify-between text-xs font-bold uppercase mb-1.5"
          ><span>Travel Date</span>
          <span class="font-normal text-[11px]">(Optional)</span></label
        >
        <input
          type="date"
          id="travelDate"
          name="travelDate"
          class={inputBaseClasses}
        />
      </div>
    </div>
  </div>

  {/* Section 4: Passengers (Refactored to map) */}
  <div class="space-y-4 pt-2">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-5 pt-3">
      {
        passengerCounters.map((c) => (
          <div class={c.span}>
            <label
              for={c.id}
              class="flex justify-between text-xs font-bold uppercase mb-1.5"
            >
              <span>{c.label}</span>{" "}
              {c.sub && <span class="font-normal text-[10px]">{c.sub}</span>}
            </label>
            <div class="relative flex items-center h-[52px] bg-surface rounded-xl border border-brand-100 focus-within:ring-2 focus-within:ring-[var(--color-cta,#AD5C1F)] transition-all overflow-hidden">
              <button
                type="button"
                class="qty-minus w-12 h-full flex justify-center items-center hover:bg-brand-50"
                data-target={c.id}
              >
                <IconMinus size={18} />
              </button>
              <input
                type="number"
                id={c.id}
                name={c.id}
                min={c.min}
                value={c.val}
                class="flex-1 w-full text-center outline-none bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none font-medium"
              />
              <button
                type="button"
                class="qty-plus w-12 h-full flex justify-center items-center hover:bg-brand-50"
                data-target={c.id}
              >
                <IconPlus size={18} />
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  {/* Section 5: Message & Submit */}
  <div class="pt-2">
    <label for="message" class="block text-xs font-bold uppercase mb-1.5"
      >Additional Message</label
    >
    <textarea
      id="message"
      name="message"
      rows="3"
      placeholder="Any special requests or requirements..."
      class={inputBaseClasses}></textarea>
  </div>

  <div class="pt-4 border-t border-brand-100">
    <label
      class="flex items-start gap-3 cursor-pointer mb-6 text-xs text-typography-muted"
    >
      <input
        type="checkbox"
        required
        class="mt-0.5 rounded border-brand-100 shrink-0 text-[var(--color-cta,#AD5C1F)] focus:ring-[var(--color-cta,#AD5C1F)]"
      />
      <span
        >I agree to be contacted via Phone, Email, or WhatsApp. This is an
        inquiry, not a confirmed booking.</span
      >
    </label>
    <button
      type="submit"
      class="group w-full sm:w-auto bg-[var(--color-cta,#AD5C1F)] text-white font-serif font-bold px-10 py-4 rounded-xl shadow-md hover:shadow-xl transition-all flex items-center justify-center gap-3"
    >
      <span>Submit Travel Enquiry</span>
      <IconSend
        size={20}
        class="transition-transform group-hover:scale-120"
      />
    </button>
  </div>
</form>

<script>
  function initFormLogic() {
    // 1. Auto-fill Logic
    const params = new URLSearchParams(window.location.search);
    for (const [key, val] of params.entries()) {
      const el = document.getElementById(key) as
        HTMLInputElement | HTMLSelectElement | null;
      if (el) {
        if (el.tagName === "SELECT") {
          const select = el as HTMLSelectElement;
          const targetStr = val.toLowerCase();
          const match = Array.from(select.options).find(
            (o) =>
              o.value.toLowerCase().includes(targetStr) ||
              o.text.toLowerCase().includes(targetStr),
          );
          if (match) match.selected = true;
          else
            select.insertAdjacentHTML(
              "beforeend",
              `<option value="${val}" selected>${val}</option>`,
            );
        } else {
          el.value = val;
        }
      }
    }

    // 2. Smart Scrolling
    if (params.toString() || window.location.hash.includes("enquiry")) {
      const form = document.querySelector('form[name="travel-enquiry"]');
      if (form) {
        setTimeout(() => {
          if (!window.location.hash.includes("enquiry")) {
            form.scrollIntoView({ behavior: "smooth", block: "start" });
          }
          const firstEmpty = form.querySelector(
            'input[required]:not([value]), input[required][value=""]',
          ) as HTMLInputElement;
          if (firstEmpty) firstEmpty.focus({ preventScroll: true });
        }, 150);
      }
    }
  }

  // Init Triggers
  initFormLogic();
  document.addEventListener("astro:page-load", initFormLogic);

  // Global Event Listeners (Counters & Accordion)
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    // Counters
    const btn = target.closest("button[data-target]");
    if (btn) {
      const input = document.getElementById(
        btn.getAttribute("data-target")!,
      ) as HTMLInputElement;
      if (input) {
        const current = parseInt(input.value) || 0;
        if (
          btn.classList.contains("qty-minus") &&
          current > parseInt(input.min || "0")
        )
          input.value = String(current - 1);
        if (btn.classList.contains("qty-plus"))
          input.value = String(current + 1);
      }
    }
  });
</script>

---
import { getCollection } from "astro:content";
import { IconSend, IconMinus, IconPlus } from "@tabler/icons-astro";
import { cn } from "../../utils/cn";

interface Props {
  defaultService?: string;
  defaultVehicle?: string;
  priceLabel?: string;
}

const {
  defaultService = "",
  defaultVehicle = "",
  priceLabel = "",
} = Astro.props;

const currentUrl = Astro.url.pathname;

// Fetch Published Services & Vehicles to Populate Dropdowns Server-Side
const allServices = await getCollection("services").catch(() => []);
const publishedServices = allServices.filter((s) => s.data.published);

const allVehicles = await getCollection("vehicles").catch(() => []);
const publishedVehicles = allVehicles.filter((v) => v.data.published !== false);

const inputBaseClasses =
  "w-full px-4 py-3.5 rounded-xl border border-brand-100 focus:ring-2 focus:ring-[var(--color-cta,#AD5C1F)] focus:border-[var(--color-cta,#AD5C1F)] outline-none text-sm bg-surface transition-all";
---

<form
  name="travel-enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/thank-you/"
  class="bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-10 shadow-premium space-y-8 text-brand-900"
>
  {/* Hidden context fields for Netlify/Email routing */}
  <input type="hidden" name="form-name" value="travel-enquiry" />
  <input type="hidden" name="sourcePage" value={currentUrl} />
  <input type="hidden" id="priceLabel" name="priceLabel" value={priceLabel} />
  <p hidden>
    <label>
      Don't fill this out: <input name="bot-field" />
    </label>
  </p>

  {/* Form Header */}
  <div class="border-b border-brand-100 pb-5">
    <h3
      class="font-serif text-2xl sm:text-3xl font-bold text-brand-900 tracking-tight"
    >
      Send Travel Request
    </h3>
    <p class="text-sm text-typography-muted mt-1.5 leading-relaxed">
      Fill out your travel requirements below. Our Udaipur dispatch team will
      calculate exact road distances, review toll actuals, and contact you
      directly to confirm rates.
    </p>
  </div>

  {/* SECTION 1: CONTACT DETAILS */}
  <div class="space-y-4">
    <div class="flex items-center gap-2 border-b border-brand-100/60 pb-2">
      <span
        class="w-6 h-6 rounded-md bg-brand-900 text-accent font-serif font-bold text-xs flex items-center justify-center shrink-0"
        >1</span
      >
      <h4
        class="font-serif text-base font-bold text-brand-900 tracking-wide uppercase"
      >
        Contact Information
      </h4>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      {/* Name - 50% Width */}
      <div class="md:col-span-6">
        <label
          for="name"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="e.g. Hrithik Roshan"
          class={cn(inputBaseClasses, "placeholder:text-typography-muted")}
        />
      </div>

      {/* Phone / WhatsApp - 50% Width */}
      <div class="md:col-span-6">
        <label
          for="phone"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Mobile / WhatsApp Number <span class="text-red-500">*</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          placeholder="+91 98765 43210"
          class={cn(inputBaseClasses, "placeholder:text-typography-muted")}
        />
      </div>
    </div>
  </div>

  {/* SECTION 2: SERVICE & VEHICLE PREFERENCE */}
  <div class="space-y-4 pt-2">
    <div class="flex items-center gap-2 border-b border-brand-100/60 pb-2">
      <span
        class="w-6 h-6 rounded-md bg-brand-900 text-accent font-serif font-bold text-xs flex items-center justify-center shrink-0"
        >2</span
      >
      <h4
        class="font-serif text-base font-bold text-brand-900 tracking-wide uppercase"
      >
        Transport & Vehicle Selection
      </h4>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      {/* Service Dropdown - 50% Width */}
      <div class="md:col-span-6">
        <label
          for="service"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Required Service / Transfer</span>
          <span class="text-typography-muted font-normal text-[11px]"
            >(Optional)</span
          >
        </label>
        <select
          id="service"
          name="service"
          required
          class={cn(
            inputBaseClasses,
            "font-medium text-brand-900 cursor-pointer",
          )}
        >
          <option value="">-- Select Service --</option>
          {
            publishedServices.map((s) => (
              <option
                value={s.data.title}
                selected={defaultService === s.data.title}
              >
                {s.data.title}
              </option>
            ))
          }
        </select>
      </div>

      {/* Vehicle Dropdown - 50% Width */}
      <div class="md:col-span-6">
        <label
          for="vehicle"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Vehicle Preference</span>
          <span class="text-typography-muted font-normal text-[11px]"
            >(Optional)</span
          >
        </label>
        <select
          id="vehicle"
          name="vehicle"
          class={cn(
            inputBaseClasses,
            "font-medium text-brand-900 cursor-pointer",
          )}
        >
          <option value="">-- Recommend a Vehicle --</option>
          {
            publishedVehicles.map((v) => (
              <option
                value={v.data.title}
                selected={defaultVehicle === v.data.title}
              >
                {v.data.title} ({v.data.passengers} Max Passengers)
              </option>
            ))
          }
        </select>
      </div>
    </div>
  </div>

  {/* SECTION 3: ITINERARY & SCHEDULE */}
  <div class="space-y-4 pt-2">
    <div class="flex items-center gap-2 border-b border-brand-100/60 pb-2">
      <span
        class="w-6 h-6 rounded-md bg-brand-900 text-accent font-serif font-bold text-xs flex items-center justify-center shrink-0"
        >3</span
      >
      <h4
        class="font-serif text-base font-bold text-brand-900 tracking-wide uppercase"
      >
        Schedule & Route Locations
      </h4>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      {/* Pickup Location - 33.3% Width */}
      <div class="md:col-span-4">
        <label
          for="pickup"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Pickup Location <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="pickup"
          name="pickup"
          required
          placeholder="e.g. Airport / Hotel"
          class={cn(inputBaseClasses, "placeholder:text-typography-muted")}
        />
      </div>

      {/* Drop Location - 33.3% Width */}
      <div class="md:col-span-4">
        <label
          for="drop"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Drop Location <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="drop"
          name="drop"
          required
          placeholder="e.g. Hotel / Mount Abu"
          class={cn(inputBaseClasses, "placeholder:text-typography-muted")}
        />
      </div>

      {/* Travel Date - 33.3% Width */}
      <div class="md:col-span-4">
        <label
          for="travelDate"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Travel Date</span>
          <span class="text-typography-muted font-normal text-[11px]"
            >(Optional)</span
          >
        </label>
        <input
          type="date"
          id="travelDate"
          name="travelDate"
          class={cn(inputBaseClasses, "text-brand-900")}
        />
      </div>
    </div>
  </div>

  {/* SECTION 4: PASSENGERS & SPECIAL REQUESTS */}
  <details class="space-y-4 pt-2 group">
    <summary
      class="flex items-center gap-2 border-b border-brand-100/60 pb-2 cursor-pointer list-none appearance-none focus:outline-none [&::-webkit-details-marker]:hidden"
    >
      <span
        class="w-6 h-6 rounded-md bg-brand-900 text-accent font-serif font-bold text-xs flex items-center justify-center shrink-0"
        >4</span
      >
      <h4
        class="font-serif text-base font-bold text-brand-900 tracking-wide uppercase flex-1"
      >
        Passenger Details
      </h4>
      <span
        class="text-brand-900 group-open:rotate-180 transition-transform duration-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
        >
      </span>
    </summary>

    <div class="grid grid-cols-2 md:grid-cols-12 gap-5 pt-3">
      {/* Adults - 33.3% Width on desktop, 50% on mobile */}
      <div class="col-span-1 md:col-span-4">
        <label
          for="adults"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
        >
          Adults
        </label>
        <div
          class="relative flex items-center w-full h-[52px] bg-surface rounded-xl border border-brand-100 overflow-hidden focus-within:ring-2 focus-within:ring-[var(--color-cta,#AD5C1F)] focus-within:border-[var(--color-cta,#AD5C1F)] transition-all"
        >
          <button
            type="button"
            class="qty-minus w-12 h-full flex items-center justify-center text-typography-muted hover:text-brand-900 hover:bg-brand-50 transition-colors cursor-pointer"
            data-target="adults"
            aria-label="Decrease adults"
          >
            <IconMinus size={18} stroke={2} />
          </button>
          <input
            type="number"
            id="adults"
            name="adults"
            min="1"
            value="2"
            class="flex-1 w-full h-full text-center outline-none text-sm bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none font-medium text-brand-900"
          />
          <button
            type="button"
            class="qty-plus w-12 h-full flex items-center justify-center text-typography-muted hover:text-brand-900 hover:bg-brand-50 transition-colors cursor-pointer"
            data-target="adults"
            aria-label="Increase adults"
          >
            <IconPlus size={18} stroke={2} />
          </button>
        </div>
      </div>

      {/* Children - 33.3% Width on desktop, 50% on mobile */}
      <div class="col-span-1 md:col-span-4">
        <label
          for="children"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Children</span>
          <span class="text-typography-muted font-normal text-[10px]"
            >(Under 12)</span
          >
        </label>
        <div
          class="relative flex items-center w-full h-[52px] bg-surface rounded-xl border border-brand-100 overflow-hidden focus-within:ring-2 focus-within:ring-[var(--color-cta,#AD5C1F)] focus-within:border-[var(--color-cta,#AD5C1F)] transition-all"
        >
          <button
            type="button"
            class="qty-minus w-12 h-full flex items-center justify-center text-typography-muted hover:text-brand-900 hover:bg-brand-50 transition-colors cursor-pointer"
            data-target="children"
            aria-label="Decrease children"
          >
            <IconMinus size={18} stroke={2} />
          </button>
          <input
            type="number"
            id="children"
            name="children"
            min="0"
            value="0"
            class="flex-1 w-full h-full text-center outline-none text-sm bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none font-medium text-brand-900"
          />
          <button
            type="button"
            class="qty-plus w-12 h-full flex items-center justify-center text-typography-muted hover:text-brand-900 hover:bg-brand-50 transition-colors cursor-pointer"
            data-target="children"
            aria-label="Increase children"
          >
            <IconPlus size={18} stroke={2} />
          </button>
        </div>
      </div>

      {/* Luggage Bags - 33.3% Width on desktop, 100% on mobile */}
      <div class="col-span-2 md:col-span-4">
        <label
          for="bags"
          class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex items-center justify-between"
        >
          <span>Luggage Bags</span>
          <span class="text-typography-muted font-normal text-[10px]"
            >(Large Suitcases)</span
          >
        </label>
        <div
          class="relative flex items-center w-full h-[52px] bg-surface rounded-xl border border-brand-100 overflow-hidden focus-within:ring-2 focus-within:ring-[var(--color-cta,#AD5C1F)] focus-within:border-[var(--color-cta,#AD5C1F)] transition-all"
        >
          <button
            type="button"
            class="qty-minus w-12 h-full flex items-center justify-center text-typography-muted hover:text-brand-900 hover:bg-brand-50 transition-colors cursor-pointer"
            data-target="bags"
            aria-label="Decrease bags"
          >
            <IconMinus size={18} stroke={2} />
          </button>
          <input
            type="number"
            id="bags"
            name="bags"
            min="0"
            value="0"
            class="flex-1 w-full h-full text-center outline-none text-sm bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none font-medium text-brand-900"
          />
          <button
            type="button"
            class="qty-plus w-12 h-full flex items-center justify-center text-typography-muted hover:text-brand-900 hover:bg-brand-50 transition-colors cursor-pointer"
            data-target="bags"
            aria-label="Increase bags"
          >
            <IconPlus size={18} stroke={2} />
          </button>
        </div>
      </div>
    </div>
  </details>

  {/* SECTION 5: SPECIAL REQUESTS */}
  <div class="pt-2">
    <label
      for="message"
      class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-0"
    >
      <span>Message / Special Requests</span>
      <span
        class="text-typography-muted font-normal text-[11px] normal-case tracking-normal"
        >(Flight details, train arrival times, outstation stops)</span
      >
    </label>
    <textarea
      id="message"
      name="message"
      rows="3"
      placeholder="Let us know if you need child seats, wheelchair accessibility, or have a specific itinerary..."
      class={cn(
        inputBaseClasses,
        "placeholder:text-typography-muted leading-relaxed resize-y",
      )}></textarea>
  </div>

  {/* Consent & Submit */}
  <div class="pt-4 border-t border-brand-100">
    <label
      class="flex items-start gap-3 cursor-pointer mb-6 text-xs text-typography-muted leading-relaxed"
    >
      <input
        type="checkbox"
        required
        class="mt-0.5 rounded border-brand-100 text-[var(--color-cta,#AD5C1F)] focus:ring-[var(--color-cta,#AD5C1F)] shrink-0 cursor-pointer"
      />
      <span>
        I agree to be contacted via Phone, Email, or WhatsApp regarding this
        travel inquiry. I understand this form is a request for contact and does
        not automatically confirm a reservation.
      </span>
    </label>

    <button
      type="submit"
      aria-label="Submit your travel enquiry to our Udaipur transport team"
      class="group w-full sm:w-auto bg-[var(--color-cta,#AD5C1F)] hover:bg-[var(--color-cta-hover,#8E4416)] text-white font-serif font-bold px-10 py-4 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 text-base tracking-wide flex items-center justify-center gap-3 active:scale-95 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-cta,#AD5C1F)] focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
    >
      <span>Submit Travel Enquiry</span>
      <IconSend
        size={20}
        stroke={2}
        className="text-white transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:-translate-y-0.5 shrink-0"
      />
    </button>
  </div>
</form>

{/* Client-Side Smart Dropdown & Input Autofill Engine */}
<script>
  function autofillContextFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const serviceParam = params.get("service");
    const vehicleParam = params.get("vehicle");

    // Helper: Smart Dropdown Selection Logic
    const selectMatchingOption = (
      selectEl: HTMLSelectElement | null,
      rawParamValue: string | null,
    ) => {
      if (!selectEl || !rawParamValue) return;

      const targetStr = rawParamValue.trim().toLowerCase();
      let matched = false;

      // 1. Attempt exact or partial string matching against existing <option> values and text
      for (let i = 0; i < selectEl.options.length; i++) {
        const option = selectEl.options[i];
        const optValue = option.value.toLowerCase();
        const optText = option.text.toLowerCase();

        if (
          optValue === targetStr ||
          optText === targetStr ||
          optText.includes(targetStr) ||
          targetStr.includes(optText)
        ) {
          selectEl.selectedIndex = i;
          if (!option.text.includes("(Auto-filled)")) {
            option.text = `${option.text} (Auto-filled)`;
          }
          matched = true;
          break;
        }
      }

      // 2. Fallback: If no option matched (e.g., custom URL query), create and select a custom option
      if (!matched && rawParamValue.trim() !== "") {
        const customOpt = document.createElement("option");
        customOpt.value = rawParamValue;
        customOpt.text = `${rawParamValue} (Auto-filled)`;
        customOpt.selected = true;
        selectEl.appendChild(customOpt);
      }
    };

    // Auto-select dropdowns
    selectMatchingOption(
      document.getElementById("service") as HTMLSelectElement,
      serviceParam,
    );
    selectMatchingOption(
      document.getElementById("vehicle") as HTMLSelectElement,
      vehicleParam,
    );

    // Auto-fill all standard input and textarea fields from URL parameters
    const inputIds = [
      "name",
      "phone",
      "pickup",
      "drop",
      "travelDate",
      "adults",
      "children",
      "bags",
      "priceLabel",
      "message",
    ];

    inputIds.forEach((id) => {
      const paramVal = params.get(id);
      if (paramVal && paramVal.trim() !== "") {
        const el = document.getElementById(id) as
          HTMLInputElement | HTMLTextAreaElement | null;
        if (el) {
          el.value = paramVal.trim();
        }
      }
    });

    // Auto-scroll to the form section if coming from a service, vehicle, hero compact form, or header enquiry button
    if (
      serviceParam ||
      vehicleParam ||
      params.get("action") === "enquiry" ||
      params.has("enquiry") ||
      params.get("source") === "hero-compact" ||
      window.location.hash.includes("enquiry")
    ) {
      const formSection =
        document.getElementById("enquiry-form-section") ||
        document.querySelector('form[name="travel-enquiry"]');
      if (formSection) {
        setTimeout(() => {
          formSection.scrollIntoView({ behavior: "smooth", block: "start" });

          const formEl = document.querySelector(
            'form[name="travel-enquiry"]',
          ) as HTMLFormElement | null;
          if (formEl) {
            // Intelligently target the first empty required field (e.g. drop location) instead of forcing focus back on pre-filled name
            const requiredFields = Array.from(
              formEl.querySelectorAll(
                'input[required]:not([type="checkbox"]), select[required], textarea[required]',
              ),
            ) as (HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)[];

            const firstEmpty =
              requiredFields.find((f) => f.value.trim() === "") ||
              (document.getElementById("drop") as HTMLInputElement | null) ||
              (document.getElementById("name") as HTMLInputElement | null);

            if (firstEmpty && typeof firstEmpty.focus === "function") {
              setTimeout(() => firstEmpty.focus({ preventScroll: true }), 450);
            }
          }
        }, 150);
      }
    }
  }

  // Execute immediately when browser loads HTML
  autofillContextFromUrl();

  // Execute on Astro View Transition SPA navigation
  document.addEventListener("astro:page-load", autofillContextFromUrl);

  // Global Event Delegation for Quantity Buttons
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const minusBtn = target.closest(".qty-minus");
    const plusBtn = target.closest(".qty-plus");

    if (minusBtn) {
      const targetId = minusBtn.getAttribute("data-target");
      if (targetId) {
        const input = document.getElementById(targetId) as HTMLInputElement;
        if (input) {
          const min = parseInt(input.min) || 0;
          let val = parseInt(input.value) || 0;
          if (val > min) input.value = (val - 1).toString();
        }
      }
    } else if (plusBtn) {
      const targetId = plusBtn.getAttribute("data-target");
      if (targetId) {
        const input = document.getElementById(targetId) as HTMLInputElement;
        if (input) {
          let val = parseInt(input.value) || 0;
          input.value = (val + 1).toString();
        }
      }
    }
  });
</script>

---
import { getCollection } from "astro:content";
import { getWhatsAppUrl, getCallUrl } from "../../utils/helpers";
import { iconResolver } from "../../utils/iconResolver";

// 1. Fetch business settings autonomously for phone & WhatsApp routing
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 70458 36164",
  whatsapp: "917045836164",
};

const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "Homepage Direct Enquiry",
  Astro.url.href,
);

// 2. Fetch homepage content autonomously with fallback defaults
const homeEntries = await getCollection("home").catch(() => []);
const homeData = homeEntries[0]?.data || {
  bookingBadge: "How to reach us",
  bookingHeading: "Three easy ways to enquire",
  contactMethods: [
    {
      icon: "IconFileText",
      title: "Send an enquiry",
      desc: "Share your travel plan in a short form. It reaches us by email and we reply to arrange it.",
      ctaText: "Open form",
      ctaLink: "/contact/",
    },
    {
      icon: "IconBrandWhatsapp",
      title: "Message on WhatsApp",
      desc: "Chat with us directly with your dates, pickup and requirement for a quick response.",
      ctaText: "Chat now",
      ctaLink: "#whatsapp",
    },
    {
      icon: "IconPhoneCall",
      title: "Call us",
      desc: "Prefer to talk? Call during our response hours and we will help you plan your trip.",
      ctaText: "Call now",
      ctaLink: "#call",
    },
  ],
  workflowHeading: "What happens after you send a request",
  workflowSteps: [
    {
      stepNumber: "1",
      title: "You send a request",
      desc: "By form, WhatsApp or call, with your service, date and requirement.",
    },
    {
      stepNumber: "2",
      title: "We receive it",
      desc: "Your enquiry is emailed to us with your page and service context.",
    },
    {
      stepNumber: "3",
      title: "We contact you",
      desc: "We confirm vehicle, price and details directly with you.",
    },
    {
      stepNumber: "4",
      title: "Trip is arranged",
      desc: "Once you agree, we finalise the trip. This site does not auto-confirm.",
    },
  ],
};
---

<section class="py-12 bg-surface border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* 1. SECTION HEADER */}
    <div class="text-left max-w-3xl mb-12">
      <span
        class="text-[11px] font-bold uppercase tracking-widest text-accent-dark bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3"
      >
        {homeData.bookingBadge}
      </span>
      <h2
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight"
      >
        {homeData.bookingHeading}
      </h2>
      <span class="inline-block w-12 h-1 bg-accent rounded-full mt-3"></span>
    </div>

    {/* 2. THREE CONTACT METHOD CARDS */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7 mb-12">
      {
        homeData.contactMethods.map((method: any) => {
          const Icon = iconResolver[method.icon] || iconResolver.IconFileText;
          const isWhatsApp =
            method.ctaLink === "#whatsapp" ||
            method.icon === "IconBrandWhatsapp";
          const finalLink =
            method.ctaLink === "#whatsapp"
              ? whatsappUrl
              : method.ctaLink === "#call"
                ? callUrl
                : method.ctaLink;

          return (
            <div class="bg-surface-card border border-border rounded-2xl p-6 sm:p-7 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="w-12 h-12 rounded-xl bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                  <Icon size={24} stroke={2} />
                </div>
                <h3 class="font-serif text-xl font-bold text-typography-main group-hover:text-[var(--color-accent-dark,#8D671D)] transition-colors duration-300 mb-3">
                  {method.title}
                </h3>
                <p class="text-sm text-typography-muted leading-relaxed mb-6">
                  {method.desc}
                </p>
              </div>
              <div>
                <a
                  href={finalLink}
                  target={isWhatsApp ? "_blank" : undefined}
                  rel={isWhatsApp ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-900 group-hover:text-brand-800 transition-colors"
                >
                  <span>{method.ctaText}</span>
                  <span class="group-hover:translate-x-1 transition-transform">
                    &rarr;
                  </span>
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* 3. FOUR-STEP WORKFLOW BANNER (Clean Professional Container) */}
    <div
      class="bg-brand-900 text-white rounded-[2rem] p-8 sm:p-10 lg:p-12 border border-brand-800/60"
    >
      <div class="mb-12 text-left max-w-2xl">
        <span
          class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.2em] text-accent bg-brand-800 px-3 py-1 rounded-full inline-block mb-3"
        >
          The Booking Process
        </span>
        <h3
          class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight"
        >
          {homeData.workflowHeading}
        </h3>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 relative"
      >
        {/* Connecting Line (Desktop Only) */}
        <div
          class="hidden lg:block absolute top-[1.5rem] left-[12.5%] right-[12.5%] h-[1px] bg-brand-800/80 z-0"
        >
        </div>

        {
          homeData.workflowSteps.map((step: any) => (
            <div class="relative z-10 flex flex-col items-center text-center group cursor-default">
              {/* Minimal Step Badge */}
              <div class="w-12 h-12 rounded-full bg-brand-950 border border-brand-800 text-[var(--color-accent,#BFA06A)] flex items-center justify-center mb-5 transition-colors duration-300 group-hover:bg-brand-900 shadow-sm relative z-10">
                <span class="font-serif font-bold text-lg">
                  {step.stepNumber}
                </span>
              </div>

              {/* Clean Content Area */}
              <div class="px-2">
                <h4 class="font-serif text-base sm:text-lg font-bold text-white mb-2">
                  {step.title}
                </h4>
                <p class="text-[11px] sm:text-xs text-brand-100/70 leading-relaxed font-light">
                  {step.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

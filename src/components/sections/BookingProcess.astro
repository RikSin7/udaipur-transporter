---
import { getCollection } from "astro:content";
import { getWhatsAppUrl } from "../../utils/helpers";
import { iconResolver } from "../../utils/iconResolver";

// 1. Fetch business settings autonomously for phone & WhatsApp routing
const settingsEntries = await getCollection("settings").catch(() => []);
const site = settingsEntries[0]?.data || {
  companyName: "Udaipur Royal Transporter",
  phone: "+91 98765 43210",
  whatsapp: "919876543210",
};

const callUrl = `tel:${site.phone.replace(/\s+/g, "")}`;
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "Homepage Direct Enquiry",
  Astro.url.href,
);

// 2. Fetch homepage content autonomously with fallback defaults
const homeEntries = await getCollection("home").catch(() => []);
const homeData = homeEntries[0]?.data || {
  bookingBadge: "How to reach us",
  bookingHeading: "Three easy ways to enquire",
  contactMethods: [
    {
      icon: "IconFileText",
      title: "Send an enquiry",
      desc: "Share your travel plan in a short form. It reaches us by email and we reply to arrange it.",
      ctaText: "Open form",
      ctaLink: "/contact/",
    },
    {
      icon: "IconBrandWhatsapp",
      title: "Message on WhatsApp",
      desc: "Chat with us directly with your dates, pickup and requirement for a quick response.",
      ctaText: "Chat now",
      ctaLink: "#whatsapp",
    },
    {
      icon: "IconPhoneCall",
      title: "Call us",
      desc: "Prefer to talk? Call during our response hours and we will help you plan your trip.",
      ctaText: "Call now",
      ctaLink: "#call",
    },
  ],
  workflowHeading: "What happens after you send a request",
  workflowSteps: [
    {
      stepNumber: "1",
      title: "You send a request",
      desc: "By form, WhatsApp or call, with your service, date and requirement.",
    },
    {
      stepNumber: "2",
      title: "We receive it",
      desc: "Your enquiry is emailed to us with your page and service context.",
    },
    {
      stepNumber: "3",
      title: "We contact you",
      desc: "We confirm vehicle, price and details directly with you.",
    },
    {
      stepNumber: "4",
      title: "Trip is arranged",
      desc: "Once you agree, we finalise the trip. This site does not auto-confirm.",
    },
  ],
};
---

<section class="py-14 lg:py-20 bg-surface border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* 1. SECTION HEADER */}
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <span
        class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-dark,#8D671D)] inline-block mb-2.5"
      >
        {homeData.bookingBadge}
      </span>
      <h2
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-typography-main tracking-tight"
      >
        {homeData.bookingHeading}
      </h2>
    </div>

    {/* 2. THREE CONTACT METHOD CARDS */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7 mb-12 sm:mb-16">
      {
        homeData.contactMethods.map((method: any) => {
          const Icon = iconResolver[method.icon] || iconResolver.IconFileText;
          const isWhatsApp =
            method.ctaLink === "#whatsapp" ||
            method.icon === "IconBrandWhatsapp";
          const finalLink =
            method.ctaLink === "#whatsapp"
              ? whatsappUrl
              : method.ctaLink === "#call"
                ? callUrl
                : method.ctaLink;

          return (
            <div class="bg-surface-card border border-border rounded-2xl p-6 sm:p-7 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="w-12 h-12 rounded-xl bg-[var(--color-surface-alt,#E9EFEA)] text-brand-900 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                  <Icon size={24} stroke={2} />
                </div>
                <h3 class="font-serif text-xl font-bold text-typography-main group-hover:text-[var(--color-accent-dark,#8D671D)] transition-colors duration-300 mb-2.5">
                  {method.title}
                </h3>
                <p class="text-sm text-typography-muted leading-relaxed mb-6">
                  {method.desc}
                </p>
              </div>
              <div>
                <a
                  href={finalLink}
                  target={isWhatsApp ? "_blank" : undefined}
                  rel={isWhatsApp ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-900 group-hover:text-brand-800 transition-colors"
                >
                  <span>{method.ctaText}</span>
                  <span class="group-hover:translate-x-1 transition-transform">
                    &rarr;
                  </span>
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* 3. FOUR-STEP WORKFLOW BANNER (Dark Brand Container) */}
    <div
      class="bg-brand-900 text-white rounded-2xl px-6 py-6 sm:px-8 sm:py-7 lg:py-8 shadow-premium border border-brand-800"
    >
      <div class="mb-6 border-b border-brand-800/80 pb-4">
        <h3
          class="font-serif text-lg sm:text-xl lg:text-2xl font-bold text-white tracking-tight"
        >
          {homeData.workflowHeading}
        </h3>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5"
      >
        {
          homeData.workflowSteps.map((step: any) => (
            <div class="space-y-1.5">
              <div class="w-8 h-8 rounded-lg bg-brand-800 text-accent font-serif font-bold text-sm flex items-center justify-center border border-brand-700 mb-1">
                {step.stepNumber}
              </div>
              <h4 class="font-serif text-sm sm:text-base font-bold text-white">
                {step.title}
              </h4>
              <p class="text-[11px] sm:text-xs text-brand-100/80 leading-relaxed">
                {step.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

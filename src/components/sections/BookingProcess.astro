---
import { getEntry } from "astro:content";
import { getWhatsAppUrl, getCallUrl } from "../../utils/helpers";
import { iconResolver } from "../../utils/iconResolver";
import { IconArrowRight } from "@tabler/icons-astro";
import SectionHeader from "../ui/SectionHeader.astro";

// 1. Fetch business settings
const siteEntry = await getEntry("settings", "site");
if (!siteEntry) throw new Error("Missing site.md");
const site = siteEntry.data;

const callUrl = getCallUrl(site.phone);
const whatsappUrl = getWhatsAppUrl(
  site.whatsapp,
  "Homepage Direct Enquiry",
  Astro.url.href,
);

// 2. Fetch homepage content
const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("Missing home.md");
const homeData = homeEntry.data;
---

<section class="py-12 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <SectionHeader
      subheading={homeData.bookingBadge}
      heading={homeData.bookingHeading}
      class="mb-12"
    />

    {/* 2. THREE CONTACT METHOD CARDS */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7 mb-12">
      {
        homeData.contactMethods.map((method: any) => {
          const Icon = iconResolver[method.icon] || iconResolver.IconFileText;
          const isWhatsApp =
            method.ctaLink === "#whatsapp" ||
            method.icon === "IconBrandWhatsapp";
          const finalLink =
            method.ctaLink === "#whatsapp"
              ? whatsappUrl
              : method.ctaLink === "#call"
                ? callUrl
                : method.ctaLink;

          return (
            <div class="bg-surface-card border border-border rounded-2xl p-6 sm:p-7 shadow-sm hover:shadow-md hover:border-brand-900 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-alt text-brand-900 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                  <Icon size={24} stroke={2} />
                </div>
                <h3 class="font-serif text-xl font-bold text-typography-main group-hover:text-accent transition-colors duration-300 mb-3">
                  {method.title}
                </h3>
                <p class="text-sm text-typography-muted leading-relaxed mb-6">
                  {method.desc}
                </p>
              </div>
              <div>
                <a
                  href={finalLink}
                  target={isWhatsApp ? "_blank" : undefined}
                  rel={isWhatsApp ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-900 tracking-wider group-hover:text-accent transition-colors uppercase"
                >
                  <span>{method.ctaText}</span>
                  <span class="group-hover:translate-x-1 transition-transform flex items-center">
                    <IconArrowRight class="w-4 h-4 text-accent" stroke={2} />
                  </span>
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* 3. FOUR-STEP WORKFLOW BANNER */}
    <div
      class="bg-brand-900 text-white rounded-2xl p-8 sm:p-10 lg:p-12 border border-brand-800/60"
    >
      <div class="mb-10 text-left max-w-2xl">
        <h3
          class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight"
        >
          {homeData.workflowHeading}
        </h3>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 relative"
      >
        {/* Connecting Line (Desktop Only) */}
        <div
          class="hidden lg:block absolute top-6 left-[12.5%] right-[12.5%] h-px bg-brand-800/80 z-0"
        >
        </div>

        {
          homeData.workflowSteps.map((step: any) => (
            <div class="relative z-10 flex flex-col items-center text-center group cursor-default">
              {/* Step Badge */}
              <div class="w-12 h-12 rounded-full bg-brand-950 border border-brand-800 text-accent flex items-center justify-center mb-5 transition-colors duration-300 group-hover:bg-brand-900 shadow-sm relative z-10">
                <span class="font-serif font-bold text-lg">
                  {step.stepNumber}
                </span>
              </div>

              {/* Content Area */}
              <div class="px-2">
                <h4 class="font-serif text-base sm:text-lg font-bold text-white mb-2">
                  {step.title}
                </h4>
                <p class="text-[11px] sm:text-xs text-brand-100/70 leading-relaxed font-light">
                  {step.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

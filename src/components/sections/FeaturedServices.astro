---
import type { CollectionEntry } from "astro:content";
import ServiceCard from "../cards/ServiceCard.astro";
import ViewAllButton from "../ui/ViewAllButton.astro";

interface Props {
  featuredServices: CollectionEntry<"services">[];
}

const { featuredServices } = Astro.props;
---

<section class="py-16 lg:py-20 bg-surface border-b border-border/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col mb-12">
      {/* Section Header */}
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-[11px] font-bold uppercase tracking-widest text-accent-dark bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3">
          Featured Services
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight mb-2">
          What We Drive for You
        </h2>
        <p class="text-sm sm:text-base text-typography-muted">
          Choose from owner-approved transport categories. We offer transparent pricing structures and reliable driver allocation for every journey.
        </p>
        <span class="inline-block w-12 h-1 bg-accent rounded-full mt-4"></span>
      </div>

      {/* Action Button */}
      <div class="hidden sm:flex justify-end mt-6">
        <ViewAllButton
          href="/services/"
          text="View All Services"
          variant="desktop"
        />
      </div>
    </div>

    {
      featuredServices.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
          {featuredServices.map((service: any) => (
            <ServiceCard service={service} />
          ))}
        </div>
      ) : (
        <div class="bg-surface-alt border border-border rounded-[var(--radius-card,18px)] p-12 text-center text-typography-muted max-w-xl mx-auto">
          <p class="italic">
            No services published yet. Add markdown files to{" "}
            <code>src/content/services/</code> to populate this section.
          </p>
        </div>
      )
    }

    <div class="mt-8 text-center sm:hidden">
      <ViewAllButton
        href="/services/"
        text="View All Services"
        variant="mobile"
      />
    </div>
  </div>
</section>

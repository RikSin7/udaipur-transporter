---
import { getCollection, type CollectionEntry } from "astro:content";
import ServiceCard from "../cards/ServiceCard.astro";
import ViewAllButton from "../ui/ViewAllButton.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  featuredServices: CollectionEntry<"services">[];
}

const { featuredServices }: Props = Astro.props;
const homeEntries = await getCollection("home").catch(() => []);
const homeData = homeEntries[0]?.data;
---

<section class="py-12 bg-surface border-b border-border/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      subheading={homeData?.servicesSection?.badge || "Featured Services"}
      heading={homeData?.servicesSection?.heading || "What We Drive for You"}
      description={homeData?.servicesSection?.description || "Choose from owner-approved transport categories. We offer transparent pricing structures and reliable driver allocation for every journey."}
      viewAllHref="/services/"
      viewAllText="View All Services"
    />

    {
      featuredServices.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
          {featuredServices.map((service: any) => (
            <ServiceCard service={service} />
          ))}
        </div>
      ) : (
        <div class="bg-surface-alt border border-border rounded-[var(--radius-card,18px)] p-12 text-center text-typography-muted max-w-xl mx-auto">
          <p class="italic">
            No services published yet. Add markdown files to{" "}
            <code>src/content/services/</code> to populate this section.
          </p>
        </div>
      )
    }

    <div class="mt-8 text-center sm:hidden">
      <ViewAllButton
        href="/services/"
        text="View All Services"
        variant="mobile"
      />
    </div>
  </div>
</section>

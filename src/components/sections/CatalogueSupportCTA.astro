---
import {
  IconCar,
  IconCompass,
  IconArrowRight,
  IconFileText,
  IconBrandWhatsapp,
} from "@tabler/icons-astro";
import { getWhatsAppUrl, createCleanParam } from "../../utils/helpers";
import { getEntry } from "astro:content";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  type: "services" | "vehicles";
}

const { type }: Props = Astro.props;
const isServicesPage = type === "services";

// 1. Fetch Singleton Settings
const settingsEntry = await getEntry("settings", "site");
if (!settingsEntry) throw new Error("Missing site.md file");
const site = settingsEntry.data;

const ctaEntry = await getEntry("catalogue_cta", "catalogue_cta");
if (!ctaEntry) throw new Error("Missing catalogue_cta.md file");
const ctaData = ctaEntry.data;

// 2. Build Dynamic Cross-Link Configuration (Left Card)
const crossLink = {
  href: isServicesPage ? "/vehicles/" : "/services/",
  title: isServicesPage
    ? ctaData?.servicesCrossTitle || "Compare our vehicles"
    : ctaData?.vehiclesCrossTitle || "Explore transport services",
  description: isServicesPage
    ? ctaData?.servicesCrossDesc ||
      "Seats, luggage guidance and amenities for each car and Tempo Traveller category."
    : ctaData?.vehiclesCrossDesc ||
      "Transparent airport transfers, local Udaipur sightseeing, and multi-day outstation packages.",
  badge: isServicesPage
    ? ctaData?.servicesCrossBadge || "Fleet Inventory"
    : ctaData?.vehiclesCrossBadge || "Service Routes",
};

// 3. Build Dynamic Inquiry & WhatsApp Configuration (Right Card)
const inquiry = {
  badge: isServicesPage
    ? ctaData?.servicesInquiryBadge || "Direct Expert Advice"
    : ctaData?.vehiclesInquiryBadge || "Direct Expert Advice",
  title: isServicesPage
    ? ctaData?.servicesInquiryTitle || "Not sure which service?"
    : ctaData?.vehiclesInquiryTitle || "Need help choosing a vehicle?",
  description: isServicesPage
    ? ctaData?.servicesInquiryDesc ||
      "Send us your travel itinerary — we'll suggest the right service package and reply directly."
    : ctaData?.vehiclesInquiryDesc ||
      "Unsure which car fits your group and luggage? Tell us your passenger count for an instant recommendation.",
  whatsappUrl: getWhatsAppUrl(
    site.whatsapp,
    isServicesPage
      ? "Service Catalogue Consultation"
      : "Vehicle Capacity Consultation",
  ),
};
---

<section class="py-12 bg-surface-alt">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      subheading={isServicesPage
        ? ctaData?.servicesHeaderBadge || "Next Steps & Support"
        : ctaData?.vehiclesHeaderBadge || "Next Steps & Support"}
      heading={isServicesPage
        ? ctaData?.servicesHeaderTitle || "Explore Fleet & Get Expert Guidance"
        : ctaData?.vehiclesHeaderTitle ||
          "Explore Services & Get Expert Guidance"}
      description={isServicesPage
        ? ctaData?.servicesHeaderDesc ||
          "Need assistance mapping your itinerary or comparing vehicle capacities? Connect directly with our local coordinators."
        : ctaData?.vehiclesHeaderDesc ||
          "Unsure about vehicle selection or planning outstation travel routes? Connect directly with our local coordinators."}
    />
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-5 items-stretch">
      {/* LEFT CARD: Dynamic Internal Cross-Link */}
      <a
        href={crossLink.href}
        class="lg:col-span-5 bg-surface-card border border-brand-100 rounded-2xl p-5 sm:p-6 shadow-sm hover:shadow-premium hover:border-brand-800/40 transition-all duration-300 flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span
              class="text-[11px] font-semibold uppercase tracking-wider text-accent-dark bg-brand-100/40 px-3 py-1 rounded-full"
            >
              {crossLink.badge}
            </span>
            <div
              class="w-8 h-8 rounded-lg bg-surface-alt border border-brand-100 flex items-center justify-center text-brand-900 shrink-0 group-hover:scale-105 transition-transform"
            >
              {
                isServicesPage ? (
                  <IconCar size={18} stroke={2} />
                ) : (
                  <IconCompass size={18} stroke={2} />
                )
              }
            </div>
          </div>

          <h3
            class="font-serif text-lg sm:text-xl font-bold text-brand-900 group-hover:text-accent transition-colors mb-1"
          >
            {crossLink.title}
          </h3>
          <p class="text-xs text-typography-muted leading-relaxed line-clamp-2">
            {crossLink.description}
          </p>
        </div>

        <div
          class="mt-4 pt-3 border-t border-brand-100/80 flex items-center justify-between text-sm font-bold uppercase text-brand-900 group-hover:text-accent transition-colors"
        >
          <span>View Full Catalogue</span>
          <IconArrowRight
            size={16}
            stroke={2}
            class="group-hover:translate-x-1 transition-transform"
          />
        </div>
      </a>

      {/* RIGHT CARD: Dynamic Consultation */}
      <div
        class="lg:col-span-7 bg-brand-900 border border-brand-800 rounded-2xl p-5 sm:p-6 shadow-premium flex flex-col justify-between text-white relative overflow-hidden"
      >
        {/* Subtle Background Accent Grid */}
        <div
          class="absolute -right-10 -bottom-10 w-40 h-40 bg-accent/5 rounded-full blur-2xl pointer-events-none"
        >
        </div>

        <div>
          <div class="flex items-center gap-2.5 mb-3">
            <div
              class="w-8 h-8 rounded-lg bg-brand-800 border border-brand-700 flex items-center justify-center text-accent shrink-0"
            >
              <IconFileText size={18} stroke={2} />
            </div>
            <span
              class="text-[11px] font-semibold uppercase tracking-wider text-accent bg-brand-800 px-3 py-1 rounded-full"
            >
              {inquiry.badge}
            </span>
          </div>

          <h3
            class="font-serif text-lg sm:text-xl lg:text-2xl font-bold text-white tracking-tight mb-1"
          >
            {inquiry.title}
          </h3>
          <p
            class="text-xs text-brand-100/80 leading-relaxed max-w-xl line-clamp-2"
          >
            {inquiry.description}
          </p>
        </div>

        {/* Dual Action CTA Buttons (Form & WhatsApp) */}
        <div
          class="mt-5 pt-4 border-t border-brand-800 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 relative z-10"
        >
          {/* Action 1: Standard Enquiry Form */}
          <a
            href={`/contact/?${isServicesPage ? `service=${createCleanParam("Service Catalogue Consultation")}` : `vehicle=${createCleanParam("Vehicle Capacity Consultation")}`}`}
            class="flex-1 bg-cta hover:bg-cta-hover text-white font-bold py-2.5 px-4 rounded-xl text-xs sm:text-sm text-center transition-all shadow-sm flex items-center justify-center gap-1.5 group active:scale-95 uppercase"
          >
            <span>Send Enquiry Form</span>
            <IconArrowRight
              size={15}
              stroke={2}
              class="text-white/90 group-hover:translate-x-1 transition-transform"
            />
          </a>

          {/* Action 2: Direct WhatsApp Chat */}
          <a
            href={inquiry.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 bg-brand-800 hover:bg-emerald-600 text-white font-bold py-2.5 px-4 rounded-xl border border-brand-700 hover:border-emerald-500 text-xs sm:text-sm text-center transition-all flex items-center justify-center gap-1.5 active:scale-95 shadow-sm uppercase"
          >
            <IconBrandWhatsapp size={16} stroke={2} class="text-emerald-400" />
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

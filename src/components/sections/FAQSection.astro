---
import { getCollection, getEntry } from "astro:content";
import { IconChevronDown, IconArrowRight } from "@tabler/icons-astro";
import ViewAllButton from "../ui/ViewAllButton.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { sortPublishedByOrder } from "../../utils/helpers";

// 1. Fetch published FAQs and sort ascending by 'sortOrder'
const allFaqs = await getCollection("faqs");
const publishedFaqs = sortPublishedByOrder(allFaqs).slice(0, 5);

const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("Missing home.md");
const homeData = homeEntry.data;
---

<section class="py-12 bg-surface-alt/50 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <SectionHeader
      subheading={homeData?.faqSection?.badge || "Clear Answers"}
      heading={homeData?.faqSection?.heading || "Frequently Asked Questions"}
      description={homeData?.faqSection?.description ||
        "Straightforward facts regarding our pricing rules, vehicle allocations, and booking confirmation process."}
      viewAllHref="/faqs/"
      viewAllText="View All FAQs"
    />

    {/* 2. EXCLUSIVE ACCORDION LIST */}
    <div class="space-y-4" id="faq-accordion-group">
      {
        publishedFaqs.map((faq, index) => {
          const isFirst = index === 0; // Open only the first FAQ by default
          return (
            <div
              class="faq-item bg-surface-card border border-border hover:border-brand-900 rounded-2xl transition-all duration-300 overflow-hidden shadow-sm hover:shadow-md"
              data-open={isFirst ? "true" : "false"}
            >
              {/* Toggle Button */}
              <button
                type="button"
                aria-expanded={isFirst ? "true" : "false"}
                class="faq-trigger w-full p-6 sm:p-7 text-left font-serif text-lg sm:text-xl font-bold text-brand-900 flex items-center justify-between gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset cursor-pointer"
              >
                <span class="leading-snug">{faq.data.question}</span>
                <div class="w-8 h-8 rounded-full bg-surface-alt border border-brand-100 flex items-center justify-center text-brand-900 shrink-0 transition-transform duration-300 faq-icon">
                  <IconChevronDown size={18} stroke={2.5} />
                </div>
              </button>

              {/* Collapsible Answer Box */}
              <div
                class="faq-content transition-all duration-300 ease-in-out overflow-hidden"
                style={isFirst ? "" : "max-height: 0px; opacity: 0;"}
              >
                <div class="px-6 pb-6 sm:px-7 sm:pb-7 pt-1 text-typography-muted text-sm sm:text-base leading-relaxed border-t border-brand-100/40 mt-1">
                  {faq.data.answer}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* 3. MOBILE NAVIGATION BUTTON (Visible only on small screens) */}
    <div class="mt-8 text-center sm:hidden">
      <ViewAllButton href="/faqs/" text="View All FAQs" variant="mobile" />
    </div>

    {/* 4. FOOTER CROSS-LINK TO DIRECT ENQUIRY */}
    <div class="mt-12 pt-8 border-t border-brand-100/60 text-center">
      <div
        class="inline-flex flex-col sm:flex-row items-center justify-center gap-2 bg-surface-card border border-brand-100 px-6 py-4 rounded-2xl shadow-sm text-xs sm:text-sm"
      >
        <span class="text-typography-muted"
          >Have a specific question about your itinerary or vehicle capacity?</span
        >
        <a
          href="/contact/"
          class="group font-bold text-brand-900 hover:text-accent transition-colors inline-flex items-center gap-1"
        >
          <span>Ask our Udaipur team directly</span>
          <IconArrowRight
            size={16}
            stroke={2}
            class="text-accent group-hover:translate-x-1 transition-transform"
          />
        </a>
      </div>
    </div>
  </div>
</section>

{/* Interactive Single-Open Controller Engine */}
<script>
  function initFaqAccordion() {
    const group = document.getElementById("faq-accordion-group");
    if (!group || group.dataset.init === "true") return;
    group.dataset.init = "true";

    const toggleFaq = (item: HTMLElement, open: boolean) => {
      item.setAttribute("data-open", String(open));
      const trigger = item.querySelector(".faq-trigger");
      const content = item.querySelector(".faq-content") as HTMLElement;
      const icon = item.querySelector(".faq-icon") as HTMLElement;

      if (trigger) trigger.setAttribute("aria-expanded", String(open));
      if (content) {
        content.style.maxHeight = open ? `${content.scrollHeight}px` : "0px";
        content.style.opacity = open ? "1" : "0";
      }
      if (icon) icon.style.transform = open ? "rotate(180deg)" : "rotate(0deg)";
    };

    group.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest(".faq-trigger");
      if (!trigger) return;

      const currentItem = trigger.closest(".faq-item") as HTMLElement;
      const isOpen = currentItem.getAttribute("data-open") === "true";

      // Close all currently open items in this group
      group
        .querySelectorAll('.faq-item[data-open="true"]')
        .forEach((openItem) => {
          if (openItem !== currentItem)
            toggleFaq(openItem as HTMLElement, false);
        });

      // Toggle clicked item
      toggleFaq(currentItem, !isOpen);
    });

    // Initialize height and state for any item open by default
    group
      .querySelectorAll('.faq-item[data-open="true"]')
      .forEach((item) => toggleFaq(item as HTMLElement, true));
  }

  initFaqAccordion();
  document.addEventListener("astro:page-load", initFaqAccordion);
</script>

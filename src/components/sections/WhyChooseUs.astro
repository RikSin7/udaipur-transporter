---
import { 
  IconFileDescription, 
  IconLuggage, 
  IconPhoneCalling, 
  IconShieldCheck 
} from '@tabler/icons-astro';
---

<section class="py-16 lg:py-20 bg-surface-alt/50 border-b border-brand-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-accent bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3">
        Our Positioning
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-900 tracking-tight">
        Why Travellers Choose Udaipur Royal Cabs
      </h2>
      <p class="text-typography-muted text-sm sm:text-base mt-2">
        We prioritize straightforward communication, realistic vehicle capacities, and transparent local pricing.
      </p>
    </div>

    {/* 4-Column Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      {/* Point 1: Clear service information */}
      <div class="bg-surface-card border border-brand-100 rounded-xl p-6 shadow-sm hover:shadow-premium transition-all duration-300 flex flex-col justify-between">
        <div>
          {/* Icon */}
          <div class="w-12 h-12 rounded-lg bg-brand-900 text-accent flex items-center justify-center mb-5">
            <IconFileDescription size={24} stroke={2} />
          </div>
          <h3 class="font-serif text-lg font-bold text-brand-900 mb-2.5">
            Clear Service Information
          </h3>
          <p class="text-xs text-typography-muted leading-relaxed">
            Each service explains what it covers, suitable vehicles and, where approved, a price with its terms.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-brand-100/60 flex items-center gap-1.5 text-[11px] font-semibold text-brand-900">
          <span class="text-emerald-600 font-bold">✓</span> No hidden rate rules
        </div>
      </div>

      {/* Point 2: Right vehicle for the trip */}
      <div class="bg-surface-card border border-brand-100 rounded-xl p-6 shadow-sm hover:shadow-premium transition-all duration-300 flex flex-col justify-between">
        <div>
          {/* Tabler JSX Icon: IconLuggage */}
          <div class="w-12 h-12 rounded-lg bg-brand-900 text-accent flex items-center justify-center mb-5">
            <IconLuggage size={24} stroke={2} />
          </div>
          <h3 class="font-serif text-lg font-bold text-brand-900 mb-2.5">
            Right Vehicle for the Trip
          </h3>
          <p class="text-xs text-typography-muted leading-relaxed">
            Recommended passengers reflect comfortable seating after luggage, not just a seat count.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-brand-100/60 flex items-center gap-1.5 text-[11px] font-semibold text-brand-900">
          <span class="text-emerald-600 font-bold">✓</span> Realistic bag limits
        </div>
      </div>

      {/* Point 3: Direct local contact */}
      <div class="bg-surface-card border border-brand-100 rounded-xl p-6 shadow-sm hover:shadow-premium transition-all duration-300 flex flex-col justify-between">
        <div>
          {/* Icon: IconPhoneCalling */}
          <div class="w-12 h-12 rounded-lg bg-brand-900 text-accent flex items-center justify-center mb-5">
            <IconPhoneCalling size={24} stroke={2} />
          </div>
          <h3 class="font-serif text-lg font-bold text-brand-900 mb-2.5">
            Direct Local Contact
          </h3>
          <p class="text-xs text-typography-muted leading-relaxed">
            Reach a real Udaipur operator by form, WhatsApp or phone — no call centre.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-brand-100/60 flex items-center gap-1.5 text-[11px] font-semibold text-brand-900">
          <span class="text-emerald-600 font-bold">✓</span> Speak with transport team
        </div>
      </div>

      {/* Point 4: Honest, owner-approved facts */}
      <div class="bg-surface-card border border-brand-100 rounded-xl p-6 shadow-sm hover:shadow-premium transition-all duration-300 flex flex-col justify-between">
        <div>
          {/* Icon: IconShieldCheck */}
          <div class="w-12 h-12 rounded-lg bg-brand-900 text-accent flex items-center justify-center mb-5">
            <IconShieldCheck size={24} stroke={2} />
          </div>
          <h3 class="font-serif text-lg font-bold text-brand-900 mb-2.5">
            Honest, Approved Facts
          </h3>
          <p class="text-xs text-typography-muted leading-relaxed">
            We publish only confirmed services, vehicles and prices. No invented claims.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-brand-100/60 flex items-center gap-1.5 text-[11px] font-semibold text-brand-900">
          <span class="text-emerald-600 font-bold">✓</span> Zero marketing fluff
        </div>
      </div>

    </div>

  </div>
</section>
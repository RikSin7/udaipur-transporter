---
import { getCollection } from "astro:content";
import SectionHeader from "../ui/SectionHeader.astro";
import { iconResolver } from "../../utils/iconResolver";
import { IconCheck } from "@tabler/icons-astro";

// 1. Fetch homepage content autonomously with fallback defaults
const homeEntries = await getCollection("home").catch(() => []);
const homeData = homeEntries[0]?.data || {
  whyChooseUsBadge: "Our Promise",
  whyChooseUsHeading: "Why Travellers Choose Us",
  whyChooseUsItems: [
    {
      icon: "IconFileDescription",
      title: "Clear service information",
      desc: "Each service explains what it covers, suitable vehicles and, where approved, a price with its terms.",
      badgeText: "No hidden rate rules",
    },
    {
      icon: "IconLuggage",
      title: "Right vehicle for the trip",
      desc: "Recommended passengers reflect comfortable seating after luggage, not just a seat count.",
      badgeText: "Realistic bag limits",
    },
    {
      icon: "IconPhoneCalling",
      title: "Direct local contact",
      desc: "Reach a real Udaipur operator by form, WhatsApp or phone — no call centre.",
      badgeText: "Speak with transport team",
    },
    {
      icon: "IconShieldCheck",
      title: "Honest, owner-approved facts",
      desc: "We publish only confirmed services, vehicles and prices. No invented claims.",
      badgeText: "Zero marketing fluff",
    },
  ],
};
---

<section
  class="py-12 bg-[var(--color-surface-alt,#E9EFEA)] border-b border-border"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <SectionHeader
      subheading={homeData.whyChooseUsBadge}
      heading={homeData.whyChooseUsHeading}
      class="mb-12"
    />

    {/* Dynamic 4-Column Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      {
        homeData.whyChooseUsItems.map((item: any) => {
          const Icon = iconResolver[item.icon] || iconResolver.IconShieldCheck;
          return (
            <div class="flex flex-col justify-between transition-all duration-300">
              <div>
                {/* Dynamic Icon */}
                <div class="w-12 h-12 rounded-xl bg-brand-900 text-accent flex items-center justify-center mb-5 shadow-sm">
                  <Icon size={24} stroke={2} />
                </div>
                <h3 class="font-serif text-lg font-bold text-typography-main mb-3">
                  {item.title}
                </h3>
                <p class="text-sm text-typography-muted leading-relaxed">
                  {item.desc}
                </p>
              </div>
              {item.badgeText && (
                <div class="mt-5 pt-3 border-t border-brand-900/10 flex items-center gap-1.5 text-xs font-semibold text-brand-900">
                  <IconCheck size={16} stroke={3} class="text-emerald-700" />{" "}
                  {item.badgeText}
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

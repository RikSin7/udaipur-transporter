---
import { getEntry, type CollectionEntry } from "astro:content";
import VehicleCard from "../cards/VehicleCard.astro";
import ViewAllButton from "../ui/ViewAllButton.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  featuredVehicles: CollectionEntry<"vehicles">[];
}

const { featuredVehicles }: Props = Astro.props;
// 1. Fetch homepage content
const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("Missing home.md");

const homeData = homeEntry.data;
---

<section class="py-12 bg-surface-alt/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      subheading={homeData.vehiclesSection.badge}
      heading={homeData.vehiclesSection.heading}
      description={homeData.vehiclesSection.description}
      viewAllHref="/vehicles/"
      viewAllText="Explore Full Fleet"
    />

    {
      featuredVehicles.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
          {featuredVehicles.map((vehicle) => (
            <VehicleCard vehicle={vehicle} />
          ))}
        </div>
      ) : (
        <div class="bg-surface border border-border rounded-(--radius-card,18px) p-12 text-center text-typography-muted max-w-xl mx-auto">
          <p class="italic">
            No vehicles published yet. Add markdown files to{" "}
            <code>src/content/vehicles/</code> to populate this section.
          </p>
        </div>
      )
    }

    <div class="mt-8 text-center sm:hidden">
      <ViewAllButton
        href="/vehicles/"
        text="Explore Full Fleet"
        variant="mobile"
      />
    </div>
  </div>
</section>

---
import type { CollectionEntry } from 'astro:content';
import VehicleCard from '../cards/VehicleCard.astro';
import { IconArrowRight } from '@tabler/icons-astro';

interface Props {
  featuredVehicles: CollectionEntry<'vehicles'>[];
}

const { featuredVehicles } = Astro.props;
---

<section class="py-16 lg:py-24 bg-surface-alt/60 border-y border-border/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-accent-dark mb-2 block">
          Vehicles
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand mb-3">
          Choose a Suitable Vehicle
        </h2>
        <p class="text-typography-muted text-base leading-relaxed">
          Our fleet guidelines help you select the right vehicle category based on passenger count and luggage volume for maximum comfort on Rajasthan roads.
        </p>
      </div>
      <div class="hidden sm:block shrink-0 self-start md:self-auto">
        <a 
          href="/vehicles/" 
          class="inline-flex items-center gap-2 bg-surface-card border border-brand-100 hover:border-brand-900 text-brand-900 font-bold px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-sm hover:shadow group active:scale-95"
        >
          <span>Explore Full Fleet</span>
          <IconArrowRight size={16} stroke={2} class="text-accent group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>

    {featuredVehicles.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        {featuredVehicles.map(vehicle => (
          <VehicleCard vehicle={vehicle} />
        ))}
      </div>
    ) : (
      <div class="bg-surface border border-border rounded-[var(--radius-card,18px)] p-12 text-center text-typography-muted max-w-xl mx-auto">
        <p class="italic">No vehicles published yet. Add markdown files to <code>src/content/vehicles/</code> to populate this section.</p>
      </div>
    )}

    <div class="mt-8 text-center sm:hidden">
      <a 
        href="/vehicles/" 
        class="w-full inline-flex items-center justify-center gap-2 bg-brand-900 text-white font-bold px-6 py-4 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md group active:scale-95"
      >
        <span>Explore Full Fleet</span>
        <IconArrowRight size={16} stroke={2} class="text-accent group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

  </div>
</section>

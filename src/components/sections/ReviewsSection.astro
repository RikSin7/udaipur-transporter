---
import { getCollection } from "astro:content";
import ReviewCard from "../cards/ReviewCard.astro";
import { IconChevronLeft, IconChevronRight } from "@tabler/icons-astro";
import ViewAllButton from "../ui/ViewAllButton.astro";

// 1. Fetch from 'reviews' collection
const allReviews = await getCollection("reviews").catch(() => []);
const displayReviews = allReviews
  .filter((rev) => rev.data.featured !== false)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 6);
---

<section
  class="py-12 bg-surface border-b border-brand-100 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* 1. SECTION HEADER WITH CONTROLS */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 sm:mb-12 gap-6">
      {/* Section Header */}
      <div class="text-left max-w-3xl">
        <span
          class="text-[11px] font-bold uppercase tracking-widest text-accent-dark bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3"
        >
          Verified Passenger Reviews
        </span>
        <h2
          class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight mb-2"
        >
          What Travellers Say
        </h2>
        <p class="text-sm sm:text-base text-typography-muted">
          We rely on transparent local pricing and experienced Udaipur drivers.
          Read genuine feedback from families, couples, and international
          visitors.
        </p>
        <span class="inline-block w-12 h-1 bg-accent rounded-full mt-4"></span>
      </div>

      {/* Controls & Desktop CTA */}
      <div class="flex flex-col items-end gap-4 shrink-0">
        <div class="hidden sm:block">
          <ViewAllButton
            href="/reviews/"
            text="View All Reviews"
            variant="desktop"
          />
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
          <button
            id="prev-review-btn"
            aria-label="Previous reviews"
            class="w-12 h-12 rounded-full border border-brand-800/20 bg-surface-card text-brand-900 hover:bg-brand-900 hover:text-white transition-all shadow-sm flex items-center justify-center active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed group"
          >
            <IconChevronLeft size={24} stroke={2} />
          </button>
          <button
            id="next-review-btn"
            aria-label="Next reviews"
            class="w-12 h-12 rounded-full border border-brand-800/20 bg-surface-card text-brand-900 hover:bg-brand-900 hover:text-white transition-all shadow-sm flex items-center justify-center active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed group"
          >
            <IconChevronRight size={24} stroke={2} />
          </button>
        </div>
      </div>
    </div>

    {/* 2. RESPONSIVE CAROUSEL TRACK */}
    <div
      id="reviews-track"
      class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-6 pt-1 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar select-none"
    >
      {
        displayReviews.map((review) => (
          <ReviewCard review={review} variant="carousel" />
        ))
      }
    </div>

    {/* 3. MOBILE NAVIGATION CTA */}
    <div class="mt-4 text-center sm:hidden">
      <ViewAllButton
        href="/reviews/"
        text="View All Reviews"
        variant="mobile"
      />
    </div>
  </div>
</section>

{/* Hide Scrollbars Cross-Browser */}
<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{/* Lightweight Vanilla JS Carousel Controller */}
<script>
  function initReviewsCarousel() {
    const track = document.getElementById("reviews-track");
    const prevBtn = document.getElementById(
      "prev-review-btn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "next-review-btn",
    ) as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const getScrollStep = () => {
      const firstCard = track.firstElementChild as HTMLElement;
      return firstCard ? firstCard.clientWidth + 24 : 350;
    };

    const updateButtonStates = () => {
      const maxScrollLeft = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 10;
      nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 10;
    };

    const handlePrev = () => {
      track.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    };

    const handleNext = () => {
      track.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    };

    prevBtn.addEventListener("click", handlePrev);
    nextBtn.addEventListener("click", handleNext);
    track.addEventListener("scroll", updateButtonStates, { passive: true });

    updateButtonStates();
  }

  initReviewsCarousel();
  document.addEventListener("astro:page-load", initReviewsCarousel);
</script>

---
import { getCollection, getEntry } from "astro:content";
import ReviewCard from "../cards/ReviewCard.astro";
import { IconChevronLeft, IconChevronRight } from "@tabler/icons-astro";
import ViewAllButton from "../ui/ViewAllButton.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { sortPublishedByOrder } from "../../utils/helpers";

// 1. Fetch from 'reviews' collection
const allReviews = await getCollection("reviews");
const publishedReviews = sortPublishedByOrder(allReviews);
const featuredReviews = publishedReviews.filter((rev) => rev.data.featured);

const displayReviews =
  featuredReviews.length > 0
    ? featuredReviews.slice(0, 6)
    : publishedReviews.slice(0, 6);

// Fetch from 'home' collection
const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("Missing home.md");
const homeData = homeEntry.data;
---

<section class="py-12 bg-surface-alt/50 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* 1. SECTION HEADER WITH CONTROLS */}
    <SectionHeader
      subheading={homeData?.reviewsSection?.badge ||
        "Verified Passenger Reviews"}
      heading={homeData?.reviewsSection?.heading || "What Travellers Say"}
      description={homeData?.reviewsSection?.description ||
        "We rely on transparent local pricing and experienced Udaipur drivers. Read genuine feedback from families, couples, and international visitors."}
      viewAllHref="/reviews/"
      viewAllText="View All Reviews"
    >
      <div
        slot="actions"
        class={displayReviews.length > 0
          ? "flex items-center gap-2 sm:gap-3"
          : "hidden"}
      >
        {
          displayReviews.length > 0 && (
            <>
              <button
                id="prev-review-btn"
                aria-label="Previous reviews"
                class="w-12 h-12 rounded-full border border-brand-800/20 bg-surface-card text-brand-900 hover:bg-brand-900 hover:text-white transition-all shadow-sm flex items-center justify-center active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed group"
              >
                <IconChevronLeft size={24} stroke={2} />
              </button>
              <button
                id="next-review-btn"
                aria-label="Next reviews"
                class="w-12 h-12 rounded-full border border-brand-800/20 bg-surface-card text-brand-900 hover:bg-brand-900 hover:text-white transition-all shadow-sm flex items-center justify-center active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed group"
              >
                <IconChevronRight size={24} stroke={2} />
              </button>
            </>
          )
        }
      </div>
    </SectionHeader>

    {/* 2. RESPONSIVE CAROUSEL TRACK OR FALLBACK */}
    {
      displayReviews.length > 0 ? (
        <div
          id="reviews-track"
          class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-6 pt-1 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar select-none"
        >
          {displayReviews.map((review) => (
            <ReviewCard review={review} variant="carousel" />
          ))}
        </div>
      ) : (
        <div class="bg-surface border border-border rounded-(--radius-card,18px) p-12 text-center text-typography-muted max-w-xl mx-auto">
          <p class="italic">
            No reviews published yet. Add markdown files to{" "}
            <code>src/content/reviews/</code> to populate this section.
          </p>
        </div>
      )
    }

    {/* 3. MOBILE NAVIGATION CTA */}
    <div class="mt-4 text-center sm:hidden">
      <ViewAllButton
        href="/reviews/"
        text="View All Reviews"
        variant="mobile"
      />
    </div>
  </div>
</section>

{/* Hide Scrollbars Cross-Browser */}
<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{/* Lightweight Vanilla JS Carousel Controller */}
<script>
  function initReviewsCarousel() {
    const track = document.getElementById("reviews-track");
    const prevBtn = document.getElementById(
      "prev-review-btn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "next-review-btn",
    ) as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const getScrollStep = () => {
      const firstCard = track.firstElementChild as HTMLElement;
      return firstCard ? firstCard.clientWidth + 24 : 350;
    };

    const updateButtonStates = () => {
      const maxScrollLeft = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 10;
      nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 10;
    };

    const handlePrev = () => {
      track.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    };

    const handleNext = () => {
      track.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    };

    prevBtn.addEventListener("click", handlePrev);
    nextBtn.addEventListener("click", handleNext);
    track.addEventListener("scroll", updateButtonStates, { passive: true });

    updateButtonStates();
  }

  initReviewsCarousel();
  document.addEventListener("astro:page-load", initReviewsCarousel);
</script>

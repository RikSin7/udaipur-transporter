---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import {
  IconChevronLeft,
  IconChevronRight,
  IconStarFilled,
  IconQuote,
  IconMapPin,
  IconCar,
  IconShieldCheck,
  IconArrowRight,
} from "@tabler/icons-astro";

// 1. Fetch from 'reviews' collection
const allReviews = await getCollection("reviews").catch(() => []);
const displayReviews = allReviews
  .filter((rev) => rev.data.featured !== false)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 6);
---

<section
  class="py-16 lg:py-24 bg-surface border-b border-brand-100 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* 1. SECTION HEADER WITH CONTROLS */}
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6"
    >
      <div>
        <span
          class="text-[11px] font-bold uppercase tracking-widest text-accent bg-brand-100/80 px-3 py-1 rounded-full inline-block mb-3"
        >
          Verified Passenger Reviews
        </span>
        <h2
          class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-900 tracking-tight"
        >
          What Travellers Say
        </h2>
        <p class="text-typography-muted text-sm sm:text-base mt-2 max-w-xl">
          We rely on transparent local pricing and experienced Udaipur drivers.
          Read genuine feedback from families, couples, and international
          visitors.
        </p>
      </div>

      {/* CONTROLS & DESKTOP CTA */}
      <div class="flex items-center gap-3 sm:gap-4 shrink-0 self-end md:self-auto">
        <a
          href="/reviews/"
          class="hidden sm:inline-flex items-center gap-2 bg-surface-card border border-brand-100 hover:border-brand-900 text-brand-900 font-bold px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-sm hover:shadow group active:scale-95"
        >
          <span>View All Reviews</span>
          <IconArrowRight
            size={16}
            stroke={2}
            className="text-accent group-hover:translate-x-1 transition-transform"
          />
        </a>

        <div class="flex items-center gap-2 sm:gap-3">
          <button
            id="prev-review-btn"
            aria-label="Previous reviews"
            class="w-12 h-12 rounded-full border border-brand-800/20 bg-surface-card text-brand-900 hover:bg-brand-900 hover:text-white transition-all shadow-sm flex items-center justify-center active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed group"
          >
            <IconChevronLeft size={24} stroke={2} />
          </button>

          <button
            id="next-review-btn"
            aria-label="Next reviews"
            class="w-12 h-12 rounded-full border border-brand-800/20 bg-surface-card text-brand-900 hover:bg-brand-900 hover:text-white transition-all shadow-sm flex items-center justify-center active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed group"
          >
            <IconChevronRight size={24} stroke={2} />
          </button>
        </div>
      </div>
    </div>

    {/* 2. RESPONSIVE CAROUSEL TRACK */}
    <div
      id="reviews-track"
      class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-6 pt-1 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar select-none"
    >
      {
        displayReviews.map((review) => {
          const item = "data" in review ? review.data : review;
          return (
            <div class="snap-start shrink-0 w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-surface-card border border-brand-100 rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-premium transition-all duration-300 flex flex-col justify-between">
              <div>
                {/* Star Rating & Quote Icon Header */}
                <div class="flex items-center justify-between mb-6">
                  <div class="flex items-center gap-1 text-accent">
                    {[...Array(item.rating || 5)].map(() => (
                      <IconStarFilled size={16} />
                    ))}
                  </div>
                  <div class="text-brand-100/60">
                    <IconQuote size={28} stroke={1.5} />
                  </div>
                </div>

                {/* Review Comment */}
                <p class="text-typography-muted text-sm sm:text-base leading-relaxed italic mb-8 line-clamp-5 sm:line-clamp-4">
                  "{item.comment}"
                </p>
              </div>

              {/* Author & Trip Metadata Footer */}
              <div class="border-t border-brand-100/80 pt-4 mt-auto">
                <div class="flex items-start justify-between gap-3">
                  {/* Left Side: Avatar/Initials + Author Name */}
                  <div class="flex items-center gap-3 min-w-0">
                    {/* Conditional Avatar Rendering */}
                    {item.image ? (
                      <Image
                        src={item.image}
                        alt={item.author}
                        width={88}
                        height={88}
                        loading="lazy"
                        class="w-11 h-11 rounded-full object-cover border border-brand-100 shrink-0 shadow-sm bg-surface-alt"
                      />
                    ) : (
                      /* Fallback UI: Renders Author's Initial in a Royal Circle if no image exists */
                      <div class="w-11 h-11 rounded-full bg-brand-900 text-accent font-serif font-bold text-base flex items-center justify-center shrink-0 shadow-sm border border-brand-800">
                        {item.author.charAt(0)}
                      </div>
                    )}

                    {/* Author Name & Location */}
                    <div class="min-w-0">
                      <h3 class="font-serif font-bold text-brand-900 text-base leading-snug truncate">
                        {item.author}
                      </h3>

                      <span class="text-[11px] text-typography-muted flex items-center gap-1 mt-0.5">
                        <IconMapPin
                          size={13}
                          stroke={2}
                          className="text-accent shrink-0"
                        />
                        <span class="truncate">{item.location}</span>
                      </span>
                    </div>
                  </div>

                  {/* Right Side: Verified Badge */}
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-2 py-1 rounded-md shrink-0 flex items-center gap-1 self-start mt-0.5">
                    <IconShieldCheck
                      size={13}
                      stroke={2}
                      className="text-emerald-600 shrink-0"
                    />
                    <span>Verified</span>
                  </span>
                </div>

                {/* Service Tag */}
                <div class="mt-3 pt-2 border-t border-brand-100/40 text-[11px] font-medium text-brand-900/80 flex items-center gap-1.5 truncate">
                  <IconCar
                    size={14}
                    stroke={2}
                    className="text-accent shrink-0"
                  />
                  <span class="truncate">{item.service}</span>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* 3. MOBILE SWIPE HINT & NAVIGATION CTA */}
    <div class="mt-4 text-center sm:hidden">
      <div class="mb-6">
        <span
          class="text-[11px] font-semibold uppercase tracking-wider text-typography-muted bg-surface-alt px-3 py-1 rounded-full border border-brand-100 inline-flex items-center gap-1.5"
        >
          <IconChevronLeft size={14} stroke={2} />
          <span>Swipe to read more reviews</span>
          <IconChevronRight size={14} stroke={2} />
        </span>
      </div>

      <a
        href="/reviews/"
        class="w-full inline-flex items-center justify-center gap-2 bg-brand-900 text-white font-bold px-6 py-4 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md group active:scale-95"
      >
        <span>View All Reviews</span>
        <IconArrowRight
          size={16}
          stroke={2}
          className="text-accent group-hover:translate-x-1 transition-transform"
        />
      </a>
    </div>
  </div>
</section>

{/* Hide Scrollbars Cross-Browser */}
<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{/* Lightweight Vanilla JS Carousel Controller */}
<script>
  function initReviewsCarousel() {
    const track = document.getElementById("reviews-track");
    const prevBtn = document.getElementById(
      "prev-review-btn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "next-review-btn",
    ) as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const getScrollStep = () => {
      const firstCard = track.firstElementChild as HTMLElement;
      return firstCard ? firstCard.clientWidth + 24 : 350;
    };

    const updateButtonStates = () => {
      const maxScrollLeft = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 10;
      nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 10;
    };

    const handlePrev = () => {
      track.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    };

    const handleNext = () => {
      track.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    };

    prevBtn.addEventListener("click", handlePrev);
    nextBtn.addEventListener("click", handleNext);
    track.addEventListener("scroll", updateButtonStates, { passive: true });

    updateButtonStates();
  }

  initReviewsCarousel();
  document.addEventListener("astro:page-load", initReviewsCarousel);
</script>

---
import { IconBrandWhatsapp, IconQuote } from '@tabler/icons-astro';

interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;
---
<section class="bg-brand-900 text-white py-16 lg:py-24 border-b border-brand-800 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <span class="inline-block px-3 py-1 bg-accent/20 text-accent border border-accent/40 rounded-full text-xs font-bold uppercase tracking-widest mb-6">
        Straightforward Local & Outstation Travel
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight mb-6">
        Private Transport From Udaipur With Transparent, Local Contact.
      </h1>
      <p class="text-brand-100/90 text-lg sm:text-xl font-light leading-relaxed mb-8">
        Skip automated call centers and hidden algorithms. Connect directly with a professional Udaipur transport provider for reliable airport transfers, city sightseeing tours, and multi-day Rajasthan itineraries.
      </p>
      
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#enquiry-section" 
          class="bg-accent hover:bg-accent-hover text-white font-bold px-8 py-4 rounded-xl shadow-lg transition-all text-base tracking-wide flex items-center gap-2 active:scale-95"
        >
          <IconQuote stroke={2} /> Request Travel Quote
        </a>
      <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Chat on WhatsApp"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-4 rounded-xl shadow transition-all text-sm flex items-center gap-2 active:scale-95"
        >
          <IconBrandWhatsapp stroke={2} /> WhatsApp Us
        </a>
      </div>
    </div>
  </div>
</section>
---
import { getCollection } from "astro:content";
import { IconBrandWhatsapp, IconQuote } from "@tabler/icons-astro";
import { iconResolver } from "../../utils/iconResolver";
import HeroCompactForm from "../forms/HeroCompactForm.astro";
import HeroHeader from "../ui/HeroHeader.astro";

interface Props {
  whatsappUrl: string;
}

const { whatsappUrl }: Props = Astro.props;

// 1. Fetch homepage content autonomously from CMS collection with fallback defaults
const homeEntries = await getCollection("home").catch(() => []);
const homeData = homeEntries[0]?.data || {
  heroBadge: "Private transport from Udaipur",
  heroTitle: "Private cabs, transfers & tours across Udaipur.",
  heroSubtitle:
    "Choose a service, pick a suitable vehicle, and reach us directly by form, WhatsApp or call. We reply to arrange your trip.",
  heroFeatures: [
    { icon: "IconCar", text: "Private cabs, SUVs & tempo travellers" },
    { icon: "IconMapPin", text: "Local Udaipur operator, direct contact" },
    { icon: "IconPhoneCall", text: "WhatsApp & Call support" },
    { icon: "IconShieldCheck", text: "Clear service info before you decide" },
  ],
};
---

<section
  class="bg-brand-950 text-white relative border-b border-brand-800 flex flex-col justify-between"
>
  {/* Main Hero Content */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      {/* Left Column - Hero Messaging & Buttons */}
      <div class="lg:col-span-7 max-w-2xl lg:max-w-none">
        <HeroHeader
          subheading={homeData.heroBadge}
          heading={homeData.heroTitle}
          description={homeData.heroSubtitle}
          class="mb-8 sm:mb-10"
        />

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#enquiry-section"
            class="bg-[var(--color-cta,#AD5C1F)] hover:bg-[var(--color-cta-hover,#8E4416)] text-white font-bold px-7 py-3.5 rounded-xl shadow-md transition-all text-sm uppercase tracking-wider flex items-center gap-2 active:scale-95"
          >
            <IconQuote class="w-5 h-5" stroke={2} /> Request Travel Quote
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Chat on WhatsApp"
            class="group bg-surface-card hover:bg-success border border-transparent hover:border-success text-brand-950 hover:text-white font-semibold px-6 py-3.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 text-sm tracking-wide flex items-center gap-2 active:scale-95"
          >
            <IconBrandWhatsapp
              class="w-5 h-5 text-success group-hover:text-white transition-all duration-300"
              stroke={2}
            />
            <span>WhatsApp Us</span>
          </a>
        </div>
      </div>

      {/* Right Column - Compact Enquiry Form */}
      <div class="lg:col-span-5 w-full max-w-lg mx-auto lg:max-w-none">
        <HeroCompactForm />
      </div>
    </div>
  </div>

  {/* Bottom Features Bar */}
  <div class="bg-brand-950 border-t border-brand-800/80 py-12 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 lg:gap-6"
      >
        {
          homeData.heroFeatures.map((item: any) => {
            const Icon =
              iconResolver[item.icon] || iconResolver.IconShieldCheck;
            return (
              <div class="flex items-center gap-4 bg-brand-900/40 hover:bg-brand-900/80 border border-brand-800/50 hover:border-brand-700/80 transition-all duration-300 rounded-2xl p-4 sm:p-5 shadow-sm group cursor-default">
                <div class="p-2.5 rounded-xl bg-brand-800/80 text-accent shrink-0 shadow-inner">
                  <Icon class="w-5 h-5 sm:w-6 sm:h-6" stroke={1.8} />
                </div>
                <span class="text-sm font-medium text-brand-100/90 leading-snug group-hover:text-white transition-colors">
                  {item.text}
                </span>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

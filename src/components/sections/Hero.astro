---
import { 
  IconBrandWhatsapp, 
  IconQuote, 
  IconCar, 
  IconMapPin, 
  IconPhoneCall, 
  IconShieldCheck 
} from '@tabler/icons-astro';

interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;

const heroFeatures = [
  { icon: IconCar, text: "Private cabs, SUVs & tempo travellers" },
  { icon: IconMapPin, text: "Local Udaipur operator, direct contact" },
  { icon: IconPhoneCall, text: "WhatsApp & Call support" },
  { icon: IconShieldCheck, text: "Clear service info before you decide" },
];
---

<section class="bg-brand-950 text-white relative border-b border-brand-800 flex flex-col justify-between">
  {/* Main Hero Content */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28 w-full">
    <div class="max-w-3xl">
      <span class="inline-block px-3.5 py-1.5 bg-brand-800 text-accent border border-brand-700/80 rounded-full text-xs font-semibold uppercase tracking-widest mb-6 shadow-sm">
        Private transport from Udaipur
      </span>
      
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15] mb-6">
        Straightforward private cabs, transfers & tours across Udaipur.
      </h1>
      
      <p class="text-brand-100/80 text-lg sm:text-xl font-normal leading-relaxed mb-10 max-w-2xl">
        Choose a service, pick a suitable vehicle, and reach us directly by form, WhatsApp or call. We reply to arrange your trip.
      </p>
      
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#enquiry-section" 
          class="bg-[var(--color-cta,#AD5C1F)] hover:bg-[var(--color-cta-hover,#8E4416)] text-white font-bold px-7 py-3.5 rounded-xl shadow-md transition-all text-sm uppercase tracking-wider flex items-center gap-2 active:scale-95"
        >
          <IconQuote class="w-5 h-5" stroke={2} /> Request Travel Quote
        </a>
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Chat on WhatsApp"
          class="bg-white/14 hover:bg-white/24 border border-white/50 text-white font-semibold px-6 py-3.5 rounded-xl shadow-md transition-all text-sm tracking-wide flex items-center gap-2 active:scale-95"
        >
          <IconBrandWhatsapp class="w-5 h-5 text-emerald-400" stroke={2} /> WhatsApp Us
        </a>
      </div>
    </div>
  </div>

  {/* Bottom Features Bar */}
  <div class="bg-brand-950 border-t border-brand-800/80 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-brand-800/60">
        {heroFeatures.map((item, idx) => {
          const Icon = item.icon;
          return (
            <div class={`flex items-center gap-3.5 ${idx !== 0 ? 'pt-4 sm:pt-0 sm:pl-4 lg:pl-6' : ''}`}>
              <div class="p-2.5 rounded-lg bg-brand-900 border border-brand-800 text-accent shrink-0 shadow-sm">
                <Icon class="w-5 h-5" stroke={1.8} />
              </div>
              <span class="text-xs sm:text-sm font-medium text-brand-100/90 leading-snug">
                {item.text}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
---
import { IconArrowRight } from "@tabler/icons-astro";

interface Props {
  href: string;
  text: string;
  variant?: "desktop" | "mobile";
  class?: string;
}

const {
  href,
  text,
  variant = "desktop",
  class: className = "",
}: Props = Astro.props;

// Default classes
const defaultDisplay =
  variant === "mobile" ? "w-full inline-flex justify-center" : "inline-flex";

const baseStyles =
  "items-center gap-1.5 font-bold text-xs uppercase tracking-wider transition-all group active:scale-95";
const colorStyles = "text-brand-900 hover:text-accent py-1.5";

const hasCustomDisplay =
  className.includes("flex") ||
  className.includes("hidden") ||
  className.includes("block") ||
  className.includes("w-");
const finalClasses =
  `${hasCustomDisplay ? "" : defaultDisplay} ${baseStyles} ${colorStyles} ${className}`.trim();
---

<a href={href} class={finalClasses}>
  <span>{text}</span>
  <IconArrowRight
    size={16}
    stroke={2}
    class="text-accent group-hover:translate-x-1 transition-transform"
  />
</a>

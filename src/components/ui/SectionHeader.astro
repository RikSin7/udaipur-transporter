---
import ViewAllButton from "./ViewAllButton.astro";
import { cn } from "../../utils/cn";

interface Props {
  heading: string;
  subheading?: string;
  description?: string;
  viewAllHref?: string;
  viewAllText?: string;
  theme?: "light" | "dark";
  align?: "left" | "center";
  underline?: boolean;
  class?: string;
}

const {
  heading,
  subheading,
  description,
  viewAllHref,
  viewAllText,
  theme = "light",
  align = "left",
  underline = true,
  class: className = "mb-8 sm:mb-12",
}: Props = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";

const wrapperClasses = cn(
  isCenter
    ? "text-center mx-auto max-w-3xl"
    : "flex flex-col sm:flex-row sm:items-center justify-between gap-6",
  className,
);

const contentClasses = cn("max-w-3xl", isCenter ? "mx-auto" : "text-left");

const badgeClasses = cn(
  "text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full inline-block mb-3",
  isDark
    ? "text-accent bg-brand-800 border border-brand-700/80 shadow-sm"
    : "text-accent-dark bg-brand-100/80",
);

const headingClasses = cn(
  "font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight",
  isDark ? "text-white" : "text-brand-900",
  description && "mb-2",
);

const descClasses = cn(
  "text-sm sm:text-base leading-relaxed",
  isDark ? "text-brand-100/80" : "text-typography-muted",
);

const hasRightContent =
  (viewAllHref && viewAllText) ||
  Astro.slots.has("actions") ||
  Astro.slots.has("right");
---

<div class={wrapperClasses}>
  <div class={contentClasses}>
    {subheading && <span class={badgeClasses}>{subheading}</span>}
    <h2 class={headingClasses}>{heading}</h2>
    {description && <p class={descClasses}>{description}</p>}
    <slot />
    {
      underline && (
        <span class="inline-block w-12 h-1 bg-accent rounded-full mt-3 sm:mt-4" />
      )
    }
  </div>

  {
    hasRightContent && !isCenter && (
      <div class="flex flex-col items-end gap-4 shrink-0">
        {viewAllHref && viewAllText && (
          <div class="hidden sm:block">
            <ViewAllButton
              href={viewAllHref}
              text={viewAllText}
              variant="desktop"
            />
          </div>
        )}
        <slot name="actions" />
        <slot name="right" />
      </div>
    )
  }
</div>

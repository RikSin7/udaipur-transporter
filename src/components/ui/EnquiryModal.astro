---
import { IconSend, IconMinus, IconPlus, IconX } from "@tabler/icons-astro";
import { cn } from "../../utils/cn";

const inputBaseClasses =
  "w-full min-w-0 max-w-full block box-border px-3.5 py-3 rounded-xl border border-brand-100 focus:ring-2 focus:ring-cta focus:border-cta outline-none text-sm bg-surface transition-all font-medium text-brand-900";

const passengerCounters = [
  {
    id: "modal-adults",
    name: "adults",
    label: "Adults",
    min: 1,
    max: 50,
    val: 2,
  },
  {
    id: "modal-children",
    name: "children",
    label: "Children",
    min: 0,
    max: 50,
    val: 0,
  },
  { id: "modal-bags", name: "bags", label: "Bags", min: 0, max: 50, val: 1 },
];
---

<dialog
  id="enquiry-modal"
  class="backdrop:bg-brand-950/80 backdrop:backdrop-blur-sm bg-transparent w-full max-w-2xl m-auto p-4 sm:p-6 open:animate-in open:fade-in open:zoom-in-95 duration-300 rounded-2xl"
  aria-labelledby="modal-title"
>
  <div
    class="bg-surface-card border border-brand-100/80 rounded-2xl shadow-2xl text-brand-900 relative overflow-hidden flex flex-col max-h-[90vh]"
  >
    {/* Header */}
    <div
      class="px-5 sm:px-6 py-4 sm:py-5 border-b border-brand-100 flex items-center justify-between sticky top-0 bg-surface-card z-20"
    >
      <div>
        <h3
          id="modal-title"
          class="font-serif text-xl sm:text-2xl font-bold text-brand-900 tracking-tight"
        >
          Quick Booking Request
        </h3>
        <p class="text-[11px] sm:text-xs text-typography-muted mt-0.5">
          Send us your details and we'll confirm availability shortly.
        </p>
      </div>
      <button
        type="button"
        id="close-modal-btn"
        class="group w-8 h-8 rounded-full bg-surface-alt hover:bg-red-50 flex items-center justify-center transition-colors shrink-0 outline-none focus-visible:ring-2 focus-visible:ring-red-500"
        aria-label="Close modal"
      >
        <IconX
          size={20}
          class="text-brand-900 group-hover:text-red-500 transition-colors"
        />
      </button>
    </div>

    {/* Scrollable Form Body */}
    <div class="p-5 sm:p-6 overflow-y-auto overflow-x-hidden">
      <form
        name="modal-travel-enquiry"
        method="POST"
        action="https://api.web3forms.com/submit"
        class="space-y-4"
      >
        <input
          type="hidden"
          name="access_key"
          value="faf3cf87-86e1-4a4e-9271-3ca98642f58d"
        />
        <input
          type="hidden"
          name="subject"
          value="New Modal Travel Quote Request | Udaipur Transporter"
        />
        <input
          type="hidden"
          name="from_name"
          value="Udaipur Royal Transporter Web Form"
        />
        <input
          type="hidden"
          name="redirect"
          class="web3-redirect"
          value="https://udaipurtransporter.netlify.app/thank-you/"
        />
        <input type="checkbox" name="botcheck" class="hidden" />
        <input type="hidden" name="form-name" value="modal-travel-enquiry" />
        <input type="hidden" name="source" value="enquiry-modal" />

        {/* Enquiry Item (Readonly) */}
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
          >
            Enquiry For
          </label>
          <input
            type="text"
            id="modal-enquiry-item-display"
            class={cn(
              inputBaseClasses,
              "bg-brand-50 pointer-events-none text-brand-900 font-bold opacity-90 border border-brand-100",
            )}
            readonly
          />
          <input
            type="hidden"
            id="modal-enquiry-item-hidden"
            name="enquiry_for"
            value=""
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label
              for="modal-name"
              class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
            >
              Name <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="modal-name"
              name="name"
              required
              minlength="2"
              maxlength="60"
              autocomplete="name"
              placeholder="Hrithik Roshan"
              class={cn(
                inputBaseClasses,
                "placeholder:text-shadow-typography-muted font-normal",
              )}
            />
          </div>
          <div>
            <label
              for="modal-phone"
              class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
            >
              Mobile <span class="text-red-500">*</span>
            </label>
            <input
              type="tel"
              id="modal-phone"
              name="phone"
              required
              minlength="10"
              maxlength="15"
              pattern="[\+\-0-9\s\(\)]{10,15}"
              placeholder="+91 70458 36164"
              class={cn(
                inputBaseClasses,
                "placeholder:text-shadow-typography-muted font-normal",
              )}
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="min-w-0">
            <label
              for="modal-travelDate"
              class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
            >
              Travel Date
            </label>
            <input
              type="date"
              id="modal-travelDate"
              name="travelDate"
              class={cn(
                inputBaseClasses,
                "text-brand-900 appearance-none min-w-0 max-w-full block",
              )}
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label
              for="modal-pickup"
              class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
            >
              Pickup Location <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="modal-pickup"
              name="pickup"
              required
              placeholder="Airport"
              class={cn(
                inputBaseClasses,
                "placeholder:text-shadow-typography-muted font-normal",
              )}
            />
          </div>
          <div>
            <label
              for="modal-drop"
              class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
            >
              Drop Location <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="modal-drop"
              name="drop"
              required
              placeholder="Hotel"
              class={cn(
                inputBaseClasses,
                "placeholder:text-shadow-typography-muted font-normal",
              )}
            />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 sm:gap-4 pt-1">
          {
            passengerCounters.map((c) => (
              <div>
                <label
                  for={c.id}
                  class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5 text-left"
                >
                  {c.label}
                </label>
                <div class="relative flex items-center h-11 bg-surface rounded-xl border border-brand-100 focus-within:ring-2 focus-within:ring-cta transition-all overflow-hidden">
                  <button
                    type="button"
                    class="modal-qty-minus w-8 sm:w-10 h-full flex justify-center items-center hover:bg-brand-50 shrink-0"
                    data-target={c.id}
                    aria-label={`Decrease ${c.label}`}
                  >
                    <IconMinus size={16} />
                  </button>
                  <input
                    type="number"
                    id={c.id}
                    name={c.name}
                    min={c.min}
                    max={c.max}
                    required
                    value={c.val}
                    class="flex-1 w-full text-center outline-none bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none font-medium text-sm px-0"
                  />
                  <button
                    type="button"
                    class="modal-qty-plus w-8 sm:w-10 h-full flex justify-center items-center hover:bg-brand-50 shrink-0"
                    data-target={c.id}
                    aria-label={`Increase ${c.label}`}
                  >
                    <IconPlus size={16} />
                  </button>
                </div>
              </div>
            ))
          }
        </div>

        <div class="pt-1">
          <label
            for="modal-message"
            class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5"
          >
            Additional Message
          </label>
          <textarea
            id="modal-message"
            name="message"
            rows="2"
            maxlength="500"
            placeholder="Any special requests..."
            class={cn(
              inputBaseClasses,
              "placeholder:text-shadow-typography-muted font-normal",
            )}></textarea>
        </div>

        <div
          class="pt-4 sticky -bottom-px bg-surface-card pb-2 mt-6 z-10 before:absolute before:-inset-x-8 before:-top-8 before:h-8 before:bg-linear-to-t before:from-brand-900/10 before:to-transparent before:pointer-events-none"
        >
          <button
            type="submit"
            class="group w-full bg-cta hover:bg-cta-hover text-white font-serif font-bold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all text-sm tracking-wide flex items-center justify-center gap-2 active:scale-95 uppercase outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-cta"
          >
            <span>Submit Request</span>
            <IconSend
              size={18}
              class="transition-transform group-hover:translate-x-1"
            />
          </button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<style>
  input:user-invalid,
  textarea:user-invalid {
    border-color: #ef4444 !important;
    background-color: #fef2f2 !important;
  }
  input:user-valid:not(:focus):not([type="date"]):not([type="number"]),
  textarea:user-valid:not(:focus) {
    border-color: #10b981 !important;
  }
  dialog::backdrop {
    background-color: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
  }
</style>

<script>
  function initModalLogic() {
    const modal = document.getElementById("enquiry-modal") as HTMLDialogElement;
    if (!modal) return; // Exit if modal isn't on this page

    // 1. Setup Defaults
    const dateInput = document.getElementById(
      "modal-travelDate",
    ) as HTMLInputElement;

    if (dateInput) {
      dateInput.min = new Date().toISOString().split("T")[0];
    }

    document.querySelectorAll("#enquiry-modal .web3-redirect").forEach((el) => {
      if (el instanceof HTMLInputElement) {
        el.value = window.location.origin + "/thank-you/";
      }
    });

    // 2. Isolate Counter Logic (Attach ONLY to the modal)
    modal.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest("button[data-target]");

      if (btn) {
        const isMinus = btn.classList.contains("modal-qty-minus");
        const isPlus = btn.classList.contains("modal-qty-plus");
        if (!isMinus && !isPlus) return;

        const input = document.getElementById(
          btn.getAttribute("data-target")!,
        ) as HTMLInputElement;
        if (input) {
          const current = parseInt(input.value) || 0;
          const minVal = parseInt(input.min) || 0;
          const maxVal = input.max ? parseInt(input.max) : Infinity;

          if (isMinus && current > minVal) input.value = String(current - 1);
          if (isPlus && current < maxVal) input.value = String(current + 1);
        }
      }
    });

    // 3. Handle Backdrop Clicks Cleanly
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.close();
      }
    });

    // 4. Handle Explicit Close Button
    const closeBtn = document.getElementById("close-modal-btn");
    if (closeBtn) {
      closeBtn.addEventListener("click", () => modal.close());
    }

    // 5. Handle Body Overflow
    modal.addEventListener("close", () => {
      document.body.style.overflow = "";
    });
  }

  // 6. Handle Global Modal Triggers Safely
  function handleGlobalModalOpen(e: Event) {
    const target = e.target as HTMLElement;
    const trigger = target.closest('[data-enquiry-modal="open"]');

    if (trigger) {
      // If triggered by keyboard, only activate on Enter or Space
      if (e.type === "keydown") {
        const kbEvent = e as KeyboardEvent;
        if (kbEvent.key !== "Enter" && kbEvent.key !== " ") return;
      }

      e.preventDefault();
      const modal = document.getElementById(
        "enquiry-modal",
      ) as HTMLDialogElement;
      if (!modal) return;

      const itemTitle =
        trigger.getAttribute("data-enquiry-item") || "General Enquiry";
      const displayInput = document.getElementById(
        "modal-enquiry-item-display",
      ) as HTMLInputElement;
      const hiddenInput = document.getElementById(
        "modal-enquiry-item-hidden",
      ) as HTMLInputElement;

      if (displayInput && hiddenInput) {
        displayInput.value = itemTitle;
        hiddenInput.value = itemTitle;
      }

      modal.showModal();
      document.body.style.overflow = "hidden";
    }
  }

  document.addEventListener("astro:page-load", () => {
    initModalLogic();
  });

  document.addEventListener("click", handleGlobalModalOpen);
  document.addEventListener("keydown", handleGlobalModalOpen);
</script>
